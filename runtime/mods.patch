+++ b/runtime/mlb/classes.c
@@ -0,0 +1,197 @@
+// mlbts-native: Pitching++ pitch classes and real arsenals: each pitcher throws his real 2026 pitches, each as the game
+// type that fits it.
+//
+// MLB_PITCH_CLASSES=1      the switch: the set pitch_classes of mods/pitch-types/patches.txt (no code sites;
+//                          switchable while the game runs, effective from the next arsenal build: a new game or pitcher)
+// MLB_PITCH_CLASSES_LOG=1  one log line per slot changed or restored
+//
+// Statcast has a few pitch names; the game has more (a sinker and a running fastball, a curve, a 12-6, a slow curve and
+// a slurve, a splitter and a forkball), and the roster sometimes picks the wrong one for the real pitch (a cutter that
+// runs arm side, a sinker that rides like a 2-seam, a Statcast sweeper listed as a slider) or lacks a pitch he throws
+// (Ohtani's splitter). classes_table.h (mods/pitch-types/tools/pitch_classes.py) lists the slots to change: a retyped
+// slot gets the new type and, so that the pitch keeps its speed, a velocity rating converted between the two types' mph
+// ranges (the game maps rating 0-99 onto a per-type range, the tables at 0x7001ddd8b0 / 0x7001ddd8fc); a pitch added in
+// an empty slot or in place of one he no longer throws gets his real speed (the rating for it on the live range) and
+// the table's control, movement rating and usage. Everything goes back when the set is switched off. Everything that
+// reads a slot then sees the new pitch (the arsenal build, the pitch names, the physics row, the CPU's choice and
+// locations; shapes.c gives it his real movement and mix).
+//
+// The roster [M, 1.0.20, 2026-11-18]: records at *(*(0x7004650770)), 0xb0 bytes each, count u32 0x7004650798; +0x9a u16
+// player id; +0x48 his attribute block, laid out as PLAYERS.BIN's PLR_ATT record: + slot at +0x30 CCONTROL, +0x36
+// VELOCITY, +0x3c PITCH_MOVEMENT, +0x42 PITCH_USAGE, +0x48 PITCH_TYPE (checked against the file for all 3,335 records in a
+// running game). The block is read by f_700183bb44 (slot type) and f_7001844250 (velocity, attribute 0x26 + slot) for
+// the arsenal build f_7000245bb8. The game reloads the roster into the same blocks on the way to the main menu; a slot
+// found back at its roster type is changed again (checked five times a second).
+#include <math.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "cfg.h"
+#include "host.h"
+#include "platform/platform.h"
+#include "classes_table.h"   // classes_table (mods/pitch-types/tools/pitch_classes.py)
+
+#define N_CLASSES ((int)(sizeof classes_table / sizeof classes_table[0]))
+#define SPEED_MIN 0x7001ddd8b0ull   // 19 ints: mph at rating 0, per type
+#define SPEED_MAX 0x7001ddd8fcull   // 19 ints: mph at rating 99
+
+static int set = -1, log_on;
+static int air_set = -1;   // the set airbender (game type 20; mods/pitch-types/tools/make_airbender.py)
+
+// A slot may become the airbender only while its set is on: the game without it drops a type-20 slot.
+static int air_on(void) { return air_set >= 0 && rt_patch_enabled(air_set); }
+static uint8_t *attr_of[N_CLASSES];    // the slot's attribute block (0 = not found in this roster)
+static const uint8_t *rec_of[N_CLASSES];   // the roster record it came from (checked before each change)
+// The slot's attribute bytes: control, velocity, movement rating, usage, type (PLR_ATT +0x30 / +0x36 / +0x3c / +0x42 /
+// +0x48 + slot).
+static const int FIELD[5] = {0x30, 0x36, 0x3c, 0x42, 0x48};
+static uint8_t applied[N_CLASSES], was[N_CLASSES][5], put_[N_CLASSES][5];
+
+static int read_u64(uint64_t a, uint64_t *out) {
+    if (!a || !mem_guest_readable(a, 8)) return 0;
+    *out = *(const uint64_t *)(uintptr_t)a;
+    return 1;
+}
+
+// The roster's attribute blocks for the table's players; 0 if the roster is not loaded. Returns the roster's address so
+// a reload (another array) is noticed.
+static uint64_t locate(void) {
+    uint64_t db, arr;
+    if (!read_u64(0x7004650770ull, &db) || !read_u64(db, &arr) || !arr || !mem_guest_readable(0x7004650798ull, 4))
+        return 0;
+    uint32_t n = *(const uint32_t *)(uintptr_t)0x7004650798ull;
+    if (!n || n > 20000 || !mem_guest_readable(arr, (size_t)n * 0xb0)) return 0;
+    int found = 0;
+    for (int i = 0; i < N_CLASSES; i++) attr_of[i] = NULL, rec_of[i] = NULL;
+    for (uint32_t r = 0; r < n; r++) {
+        const uint8_t *rec = (const uint8_t *)(uintptr_t)(arr + r * 0xb0ull);
+        uint16_t id = *(const uint16_t *)(rec + 0x9a);
+        uint64_t attr = *(const uint64_t *)(rec + 0x48);
+        if (!attr || !mem_guest_readable(attr + 0x30, 0x1e)) continue;
+        for (int i = 0; i < N_CLASSES; i++)   // the table is sorted by id; this runs once per roster load
+            if (classes_table[i].id == id) attr_of[i] = (uint8_t *)(uintptr_t)attr, rec_of[i] = rec, found++;
+    }
+    // None of the table's players: the array is allocated but not filled yet (the heap layout calls all of it readable,
+    // so the count can come before the records; r18 recorded that empty array as done and never changed a slot). Again
+    // next time.
+    return found ? arr ^ n : 0;
+}
+
+// The type's speed range: mph at rating 0 and 99 (the game's tables, live: pitchmod.txt may change them). 0 if unreadable.
+static int speed_range(int type, float *lo, float *hi) {
+    if (type == 20) {   // the airbender: its range is on the patch page (make_airbender.py PAGE_MPH)
+        const char *pg = (const char *)rt_patch_page();
+        if (!pg || !air_on()) return 0;
+        *lo = (float)((const int32_t *)(pg + 0x330))[0];
+        *hi = (float)((const int32_t *)(pg + 0x330))[1];
+        return *hi != *lo;
+    }
+    if (type < 0 || type > 18 || !mem_guest_readable(SPEED_MIN, 19 * 4) || !mem_guest_readable(SPEED_MAX, 19 * 4)) return 0;
+    *lo = (float)((const int32_t *)(uintptr_t)SPEED_MIN)[type];
+    *hi = (float)((const int32_t *)(uintptr_t)SPEED_MAX)[type];
+    return *hi != *lo;
+}
+
+// The velocity rating that gives mph on this type (the game remaps 0..99 onto its range; changeups' run downward).
+static uint8_t rating_for(int type, float mph, uint8_t fallback) {
+    float lo, hi;
+    if (!speed_range(type, &lo, &hi)) return fallback;
+    float r = (mph - lo) / (hi - lo) * 99.0f;
+    return (uint8_t)lroundf(r < 0.0f ? 0.0f : r > 99.0f ? 99.0f : r);
+}
+
+// The slot's velocity rating for the new type that gives the same mph as the old rating on the old type.
+static uint8_t same_speed(int from, int to, uint8_t vel) {
+    float lo, hi;
+    if (!speed_range(from, &lo, &hi)) return vel;
+    return rating_for(to, lo + (hi - lo) * (vel / 99.0f), vel);
+}
+
+static void apply(int on) {
+    int changed = 0;
+    for (int i = 0; i < N_CLASSES; i++) {
+        uint8_t *a = attr_of[i];
+        // still his record and his block (a roster reloaded at the same address and count in another order must not
+        // retype another player's slot)
+        if (!a || !rec_of[i] || *(const uint16_t *)(rec_of[i] + 0x9a) != classes_table[i].id ||
+            *(const uint64_t *)(rec_of[i] + 0x48) != (uint64_t)(uintptr_t)a)
+            continue;
+        const int s = classes_table[i].slot, from = classes_table[i].from, to = classes_table[i].to;
+        // a slot to the airbender only while its set is on too (switched off: the slot goes back)
+        const int on_i = on && (to != 20 || air_on());
+        // the game reloads the roster into the same blocks (at the main menu: the file's values back under the applied
+        // flag), so a slot found at its old type again is changed again
+        if (on_i && applied[i] && a[0x48 + s] == from) applied[i] = 0;
+        if (on_i && !applied[i] && a[0x48 + s] == from) {
+            for (int f = 0; f < 5; f++) was[i][f] = a[FIELD[f] + s];
+            uint8_t v[5];
+            memcpy(v, was[i], 5);
+            // a retyped slot keeps its speed; an added or swapped one gets his real speed and the table's ratings
+            v[1] = classes_table[i].mph10 ? rating_for(to, classes_table[i].mph10 / 10.0f, 50)
+                                          : same_speed(from, to, was[i][1]);
+            if (classes_table[i].ctrl != 255) v[0] = classes_table[i].ctrl;
+            if (classes_table[i].mov != 255) v[2] = classes_table[i].mov;
+            if (classes_table[i].use != 255) v[3] = classes_table[i].use;
+            v[4] = (uint8_t)to;
+            for (int f = 0; f < 4; f++) a[FIELD[f] + s] = put_[i][f] = v[f];
+            a[0x48 + s] = put_[i][4] = v[4];   // the type last
+            applied[i] = 1, changed++;
+            if (log_on)
+                rt_log("classes: player %u slot %d type %d -> %d, velocity %u -> %u, control %u, movement %u, usage %u",
+                       classes_table[i].id, s, from, to, was[i][1], v[1], v[0], v[2], v[3]);
+        } else if (!on_i && applied[i]) {
+            if (a[0x48 + s] == to) {
+                a[0x48 + s] = was[i][4];
+                for (int f = 0; f < 4; f++)
+                    if (a[FIELD[f] + s] == put_[i][f]) a[FIELD[f] + s] = was[i][f];
+            }
+            applied[i] = 0, changed++;
+            if (log_on) rt_log("classes: player %u slot %d back to type %d", classes_table[i].id, s, from);
+        }
+    }
+    if (changed) rt_log("classes: %d slots %s", changed, on ? "changed" : "restored");
+}
+
+static void watcher(void *arg) {
+    (void)arg;
+    uint64_t where = 0;
+    int recheck = 0;
+    for (;;) {
+        // the roster loads once the menus are up and is reloaded (into the same blocks or a new array) on the way to a
+        // game; a pitcher's arsenal is built from it when he takes the mound, seconds later: check five times a second
+        plat_sleep_ns(200000000ull);
+        uint64_t now = 0, db, arr;
+        if (read_u64(0x7004650770ull, &db) && read_u64(db, &arr) && mem_guest_readable(0x7004650798ull, 4))
+            now = arr ^ *(const uint32_t *)(uintptr_t)0x7004650798ull;
+        if (!now) continue;
+        if (now != where) {   // a new roster: its blocks hold the file's types again
+            where = locate();
+            memset(applied, 0, sizeof applied);
+            if (!where) continue;
+            recheck = 5;
+        } else if (recheck && !--recheck) {
+            locate();   // once more a second later, in case the roster was caught while it was being filled
+        }
+        apply(rt_patch_enabled(set));
+    }
+}
+
+void classes_start(void) {
+    set = rt_patch_set("pitch_classes");
+    air_set = rt_patch_set("airbender");   // -1 in an exe without it: no slot becomes type 20
+    if (set < 0) return;   // an exe built without the set
+    if (strcmp(rt_game_build, "1.0.20")) {
+        rt_log("classes: no addresses known for game %s; the pitch_classes set is switched off", rt_game_build);
+        rt_patch_disable(set);
+        return;
+    }
+    const char *l = cfg_get("MLB_PITCH_CLASSES_LOG");
+    log_on = l && *l && strcmp(l, "0") != 0;
+    if (!plat_thread_spawn(watcher, NULL, "classes", 0)) {
+        rt_log("classes: cannot start the watcher thread; the pitch_classes set is switched off");
+        rt_patch_disable(set);
+        return;
+    }
+    rt_log("classes: %s; %d slots in the table", rt_patch_enabled(set) ? "on" : "off", N_CLASSES);
+}
