diff --git a/runtime/mlb/mound.c b/runtime/mlb/mound.c
new file mode 100644
index 0000000..c58e60b
--- /dev/null
+++ b/runtime/mlb/mound.c
@@ -0,0 +1,129 @@
+// mlbts-native: Pitching++ - the pitcher on the mound, found the way the game itself names him.
+//
+// [M, 1.0.20, 2026-11-21] RolePitcher::PitchStoreFatigue (f_70002e9dc4) logs "Pitcher Name" with the name of the game
+// player object it gets from the role: index = **(*(role + 8) + 0x38) (f_70001b0bec), then the player database
+// (*(0x700227dda0) = 0x7004650998, virtual +0x10 = f_700181a7e8): entry = *(db + 0x10) + (index & 0xffff) * 0x138,
+// valid while the index is below u32 *(db + 0x38); the player object = *(entry), name at +0x60. The role is Real Pitch
+// Speed's: *(*(*(ctx + 0x18) + 0x10) + 0xf0), ctx = *(G + 0x18 + 8 * u8 *(*(G + 0x20) + 0x124)), G = *(0x7003aeb728).
+// The player object has the roster record's layout (PLAYERS.BIN as loaded): +0x8 u16 delivery style, +0x48 the
+// attribute block, +0x60 the last name, +0x70 SIGNED_PACK (bit 30 left-handed), +0x74 UNSIGNED_PACK[0] (height in bits
+// 9-15), +0x9a u16 player id. Its style is the one the game streams his delivery by (styles.c).
+//
+// The earlier lookup read the mound object's player id (*(*(ctx) + 0x188) + 0x2cc). That names a CPU-controlled pitcher
+// only: for a pitcher the user controls (Road to the Show, measured) the id there stays 0xffffffff, and the game clears
+// it for a moment while it places any pitcher. This route names both, created players too (their player id is 65535,
+// shared by every created and generic player: the object, not the id, tells two of them apart).
+#include <stdint.h>
+#include <string.h>
+
+#include "host.h"
+#include "mound.h"
+
+static int rd64(uint64_t a, uint64_t *out) {
+    if (!a || !mem_guest_readable(a, 8)) return 0;
+    *out = *(const uint64_t *)(uintptr_t)a;
+    return 1;
+}
+
+int mound_pitcher(MoundPitcher *p) {
+    uint64_t g, a, ctx, r1, r2, role, obj, pi, base, player;
+    if (!rd64(0x7003aeb728ull, &g) || !rd64(g + 0x20, &a) || !mem_guest_readable(a + 0x124, 1)) return 0;
+    uint8_t team = *(const uint8_t *)(uintptr_t)(a + 0x124);
+    if (!rd64(g + 0x18 + team * 8ull, &ctx) || !rd64(ctx + 0x18, &r1) || !rd64(r1 + 0x10, &r2) ||
+        !rd64(r2 + 0xf0, &role) || !rd64(role + 8, &obj) || !rd64(obj + 0x38, &pi) || !mem_guest_readable(pi, 4) ||
+        !mem_guest_readable(0x7004650998ull + 0x38, 4) || !rd64(0x7004650998ull + 0x10, &base))
+        return 0;
+    uint32_t index = *(const uint32_t *)(uintptr_t)pi & 0xffff, n = *(const uint32_t *)(uintptr_t)(0x7004650998ull + 0x38);
+    if (index >= n || n > 4096 || !rd64(base + index * 0x138ull, &player) || !mem_guest_readable(player, 0xb0)) return 0;
+    const uint8_t *r = (const uint8_t *)(uintptr_t)player;
+    uint16_t style = *(const uint16_t *)(r + 0x8), id = *(const uint16_t *)(r + 0x9a);
+    uint64_t attr = *(const uint64_t *)(r + 0x48);
+    p->player = player;
+    p->index = index;
+    p->role = role;
+    p->id = id && id < 65535 ? id : 0;
+    p->style = style && style < 65535 ? style : -1;
+    p->height_in = (int)(*(const uint32_t *)(r + 0x74) >> 9 & 0x7f);
+    p->left = (int)(*(const uint32_t *)(r + 0x70) >> 30 & 1);
+    p->attr = attr && mem_guest_readable(attr + 0x30, 0x1e) ? attr : 0;
+    int c = 0;
+    for (; c < 16 && r[0x60 + c]; c++) p->name[c] = r[0x60 + c] >= 0x20 && r[0x60 + c] < 0x7f ? (char)r[0x60 + c] : '?';
+    p->name[c] = 0;
+    return 1;
+}
+
+// [M, 1.0.20, 2026-11-21] The batter, as RolePitcher::PitchStoreFatigue (f_70002e9dc4) names him ("Batter Name"):
+// f_700181cac4(player database, &entry): team = u32 *(*(0x700227e6a0)) (the team at bat, 0 or 1), slot = u32 at
+// *(0x70022871e0) or, for team 1, *(0x70022871e8) (that team's lineup slot); then f_700184abb4(base, slot, &entry, 4),
+// base = *(db + 8) + team * 0x550 + 0x50: position = u8 base + 0x4c + slot + 0x2f8 (< 10), index = u8 base + 0x4c +
+// position + 0x301 (< 0x5f), entry = *(base + 8 * index); the player object = *(entry), name at +0x60. How he bats:
+// record +0x74 (PLAYERS.BIN's UNSIGNED_PACK[0]) bits 23-24, 0 right, 1 left, 2 both (Judge 0, Bellinger 1, Henderson 1,
+// Jose Ramirez 2, Raleigh 2, Lindor 2 in the roster file).
+int mound_batter(int pitcher_left, MoundBatter *b) {
+    uint64_t tp, sp, dbt, base, entry, player;
+    if (!rd64(0x700227e6a0ull, &tp) || !mem_guest_readable(tp, 4)) return 0;
+    uint32_t team = *(const uint32_t *)(uintptr_t)tp;
+    if (team > 1 || !rd64(team ? 0x70022871e8ull : 0x70022871e0ull, &sp) || !mem_guest_readable(sp, 4) ||
+        !rd64(0x7004650998ull + 8, &dbt) || !dbt)
+        return 0;
+    uint8_t slot = *(const uint8_t *)(uintptr_t)sp;
+    base = dbt + team * 0x550ull + 0x50;
+    if (slot >= 9 || !mem_guest_readable(base, 0x400)) return 0;
+    const uint8_t *bb = (const uint8_t *)(uintptr_t)base;
+    uint8_t pos = bb[0x4c + slot + 0x2f8];
+    if (pos >= 10) return 0;
+    uint8_t idx = bb[0x4c + pos + 0x301];
+    if (idx >= 0x5f || !rd64(base + idx * 8ull, &entry) || !rd64(entry, &player) || !mem_guest_readable(player, 0xb0))
+        return 0;
+    const uint8_t *r = (const uint8_t *)(uintptr_t)player;
+    b->player = player;
+    b->bats = (int)(*(const uint32_t *)(r + 0x74) >> 23 & 3);
+    if (b->bats > 2) return 0;
+    b->side = b->bats == 2 ? (pitcher_left ? 'R' : 'L') : b->bats == 1 ? 'L' : 'R';
+    int c = 0;
+    for (; c < 16 && r[0x60 + c]; c++) b->name[c] = r[0x60 + c] >= 0x20 && r[0x60 + c] < 0x7f ? (char)r[0x60 + c] : '?';
+    b->name[c] = 0;
+    return 1;
+}
+
+// [M, 1.0.20, 2026-11-21] The Road to the Show player: f_700181a6fc(*(0x700227e6c0) = 0x7004650760, 0xd06) (perkspp.c,
+// quirkmod.c), a player database like 0x7004650998 (virtual +0x10: entry = *(db + 0x10) + index * 0x138 while index <
+// u32 *(db + 0x38)); his object = *(entry). In a match he is another object (a test career's pitcher: index 0x2c in
+// the match's database, object 0x1c720ed78 vs the roster's 0x1c8a5f4a0), so mound_is_rtts_player compares records.
+uint64_t mound_rtts_player(void) {
+    uint64_t base, player;
+    const uint64_t db = 0x7004650760ull, rtts = 0xd06;
+    if (!mem_guest_readable(db + 0x38, 4) || *(const uint32_t *)(uintptr_t)(db + 0x38) <= rtts || !rd64(db + 0x10, &base) ||
+        !rd64(base + rtts * 0x138, &player) || !mem_guest_readable(player, 0xb0))
+        return 0;
+    return player;
+}
+
+int mound_is_rtts_player(uint64_t player) {
+    uint64_t mine = mound_rtts_player();
+    if (!mine || !player || !mem_guest_readable(player, 0xb0)) return 0;
+    if (mine == player) return 1;
+    const uint8_t *a = (const uint8_t *)(uintptr_t)mine, *b = (const uint8_t *)(uintptr_t)player;
+    return *(const uint16_t *)(a + 0x9a) == 65535 && *(const uint16_t *)(b + 0x9a) == 65535 && a[0x60] &&
+           !memcmp(a + 0x60, b + 0x60, 16) && *(const uint32_t *)(a + 0x74) == *(const uint32_t *)(b + 0x74) &&
+           (*(const uint32_t *)(a + 0x70) >> 30 & 1) == (*(const uint32_t *)(b + 0x70) >> 30 & 1);
+}
+
+// [M, 1.0.20, 2026-11-22] The count, as RolePitcher::PitchStoreFatigue (f_70002e9dc4) logs it ("Count: %d-%d, Outs"):
+// obj = *(*(0x700227e6b8)), balls u32 +0x10, strikes +0x14, outs +0x18.
+int mound_count(int *balls, int *strikes) {
+    uint64_t p, obj;
+    if (!rd64(0x700227e6b8ull, &p) || !rd64(p, &obj) || !mem_guest_readable(obj + 0x10, 8)) return 0;
+    uint32_t b = *(const uint32_t *)(uintptr_t)(obj + 0x10), s = *(const uint32_t *)(uintptr_t)(obj + 0x14);
+    if (b > 3 || s > 2) return 0;
+    *balls = (int)b, *strikes = (int)s;
+    return 1;
+}
+
+int mound_roster_record(uint64_t player) {
+    uint64_t db, arr;
+    if (!rd64(0x7004650770ull, &db) || !rd64(db, &arr) || !mem_guest_readable(0x7004650798ull, 4)) return -1;
+    uint32_t n = *(const uint32_t *)(uintptr_t)0x7004650798ull;
+    if (player < arr || player >= arr + n * 0xb0ull || (player - arr) % 0xb0) return -1;
+    return (int)((player - arr) / 0xb0);
+}
diff --git a/runtime/mlb/mound.h b/runtime/mlb/mound.h
new file mode 100644
index 0000000..c015537
--- /dev/null
+++ b/runtime/mlb/mound.h
@@ -0,0 +1,43 @@
+// mlbts-native: Pitching++ - the pitcher on the mound (mound.c).
+#pragma once
+#include <stdint.h>
+
+typedef struct {
+    uint64_t player;   // the game's player object for this game (roster record layout); tells two pitchers apart
+    uint32_t id;       // player id, 0 for a created or generic player (65535 in the game)
+    int style;         // delivery style the game uses, -1 none
+    int height_in;     // height in inches
+    int left;          // throws left-handed
+    uint64_t attr;     // attribute block (PLR_ATT layout: types +0x48, movement +0x3c, velocity +0x36 per slot), 0 unreadable
+    char name[17];     // his last name as the game has it (for logs)
+    uint32_t index;    // his index in the match's player database (0x7004650998; for logs)
+    uint64_t role;     // the pitcher role object the route went through (RolePitcher; +0x1c0 its pitch node set)
+} MoundPitcher;
+
+typedef struct {
+    uint64_t player;   // the batter's player object (roster record layout)
+    int bats;          // 0 right, 1 left, 2 both (record +0x74 bits 23-24)
+    char side;         // the side he bats from now: 'R' or 'L' (a switch-hitter: the side opposite the pitcher's hand)
+    char name[17];     // his last name (for logs)
+} MoundBatter;
+
+// The pitcher on the mound, user-controlled or CPU, by the game's own route: 1 and *p filled, or 0.
+int mound_pitcher(MoundPitcher *p);
+
+// The batter at the plate by the game's lineup state (the team at bat and its lineup slot), as the game's own pitch
+// diagnostics name him: 1 and *b filled, or 0. pitcher_left: the pitcher throws left-handed (for a switch-hitter).
+int mound_batter(int pitcher_left, MoundBatter *b);
+
+// The user's Road to the Show player's object in the roster player database (entry 0xd06), or 0 (no career loaded).
+uint64_t mound_rtts_player(void);
+
+// 1 when this player object (a match's, e.g. MoundPitcher.player) is the user's Road to the Show player. A match has its
+// own copy of the record, so the records are compared: created (player id 65535), same last name, same +0x74 word
+// (height, bats ...) and throwing hand.
+int mound_is_rtts_player(uint64_t player);
+
+// Which roster record (*(*(0x7004650770)), 0xb0 bytes each) the player object is, or -1 (another object). For logs.
+int mound_roster_record(uint64_t player);
+
+// The count (balls 0-3, strikes 0-2) as the game's pitch diagnostics read it: 1 and filled, or 0.
+int mound_count(int *balls, int *strikes);
diff --git a/runtime/mlb/pitchmod.c b/runtime/mlb/pitchmod.c
new file mode 100644
index 0000000..c16229e
--- /dev/null
+++ b/runtime/mlb/pitchmod.c
@@ -0,0 +1,295 @@
+// mlbts-native: pitch types mod, step one: retune an existing pitch type (research and plan:
+// TheShow/mods/pitch-types/research.md).
+//
+// A pitch type's behaviour in flight comes from tables in main's data, read every time a pitch is set up [C, 1.0.20]:
+//   - 0x7002176850 (.data): 19 rows of 0x28 bytes, a name pointer the game never reads and eight floats: f0 spin in
+//     rev/s, f1 second spin-axis angle (deg), f2 spin-axis angle (deg), f3 Magnus efficiency, f4 arm stress per pitch,
+//     f5 nominal mph, f6 visible break direction (deg), f7 visible break size. Only getter: f_7000253dcc.
+//   - 0x7001ddd8b0 / 0x7001ddd8fc (rodata): int32[19] mph at velocity rating 0 / 99 for roster pitchers
+//     (f_7001839c30 interpolates; changeups and the knuckleball run high to low).
+//   - 0x7001ddd948 (rodata): float[18] aim offset per type (f_7001839d20).
+//   - Four copies of u32[19] game pitch id -> play-by-play commentary pitch id (0x7001d9aea8, 0x7001d9b628,
+//     0x7001d9bee4, 0x7001d965b8). The commentary's own list includes 17 = Eephus and 16 = Gyroball, which have no
+//     lines.
+// None of them is folded into the generated C (work/gen/main/folded.txt), so rewriting them once after main is loaded
+// and before any guest code runs changes the game, as resolution.c does for the scene sizes. A table whose bytes are
+// not the shipped ones (another game version, or a second writer) is left alone.
+//
+// MLB_PITCHMOD = the definition file; default pitchmod.txt beside mlb.exe, used when it exists; "off" disables. Lines,
+// with # starting a comment:
+//   phys  <id> <f0> <f1> <f2> <f3> <f4> <f5> <f6> <f7>
+//   mph   <id> <mph at velocity 0> <mph at velocity 99>
+//   aim   <id> <value>                                     (ids 0-17)
+//   audio <id> <commentary pitch id>
+//   switch <set> <0|1> turns a code patch set of this build on or off (A/B tests, with MLB_PITCHMOD_RELOAD)
+//   batter_guess <k>   CPU batters' aim leans k times as much on their pre-pitch guess (1 = the game's; lower =
+//                      they follow the pitch more). Needs a build generated with mods/pitch-types/patches.txt.
+// Ids are the game's 0-18. New ids (19 and up) need code patches as well; this file only retunes existing ones.
+//
+// batter_guess [C, M, 2026-11-16; mods/pitch-types/re/batting-ai.md]: a CPU batter aims at
+// v · (a random guess low-middle in the zone) + (1 - v) · (where the pitch crosses), per axis, with v = 0.56-1.04.
+// The game tuned v against its shipped pitches; against real movement the aim misses more and contact is softer.
+// The code patch (set batter_guess) multiplies v by k, read from patch page +0x100, which this file writes.
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+
+#include "cfg.h"
+#include "host.h"
+#include "platform/platform.h"
+
+#define NTYPES 19
+
+typedef struct {
+    const char *name;
+    uint64_t addr, size;   // bytes the shipped check covers
+    uint64_t fnv;          // FNV-1a 64 of those bytes as shipped (for phys: the float part of each row)
+} Table;
+
+enum { T_PHYS, T_MPH_LO, T_MPH_HI, T_AIM, T_AUDIO0, T_AUDIO1, T_AUDIO2, T_AUDIO3, T_COUNT };
+
+// 1.0.20 addresses (read in the lifted code and main's image, 2026-11-16). Other versions: no table is known.
+static const Table tables_1020[T_COUNT] = {
+    {"physics", 0x7002176850ull, NTYPES * 0x28, 0xa3332d08b34c631eull},
+    {"mph at velocity 0", 0x7001ddd8b0ull, NTYPES * 4, 0xf4c5da23ba66da14ull},
+    {"mph at velocity 99", 0x7001ddd8fcull, NTYPES * 4, 0x494b26358a030c2bull},
+    {"aim", 0x7001ddd948ull, 18 * 4, 0x30371ec88144d5bbull},
+    {"commentary map 1", 0x7001d9aea8ull, NTYPES * 4, 0x617ea133422cfbb5ull},
+    {"commentary map 2", 0x7001d9b628ull, NTYPES * 4, 0x617ea133422cfbb5ull},
+    {"commentary map 3", 0x7001d9bee4ull, NTYPES * 4, 0x617ea133422cfbb5ull},
+    {"commentary map 4", 0x7001d965b8ull, NTYPES * 4, 0x617ea133422cfbb5ull},
+};
+
+static uint64_t fnv_add(uint64_t h, const uint8_t *p, uint64_t n) {
+    for (uint64_t i = 0; i < n; i++) h = (h ^ p[i]) * 0x100000001b3ull;
+    return h;
+}
+
+static uint64_t table_fnv(int t, const Table *tab) {
+    uint64_t h = 0xcbf29ce484222325ull;
+    const uint8_t *p = (const uint8_t *)(uintptr_t)tab->addr;
+    if (t == T_PHYS) {   // the name pointers are relocated at load: only the floats
+        for (int i = 0; i < NTYPES; i++) h = fnv_add(h, p + i * 0x28 + 8, 0x20);
+        return h;
+    }
+    return fnv_add(h, p, tab->size);
+}
+
+// Writes n bytes at a guest address, opening read-only pages for it and restoring their protection.
+static int poke(uint64_t addr, const void *src, uint64_t n) {
+    uint64_t page = addr & ~0xfffull, end = (addr + n + 0xfff) & ~0xfffull, stop = 0;
+    int prot = plat_mem_state(page, end, &stop);
+    if (prot < PLAT_PROT_READ || stop < end) return 0;
+    if (prot != PLAT_PROT_RW && !plat_mem_protect(page, end - page, PLAT_PROT_RW)) return 0;
+    memcpy((void *)(uintptr_t)addr, src, n);
+    if (prot != PLAT_PROT_RW) plat_mem_protect(page, end - page, prot);
+    return 1;
+}
+
+static const char *def_path(char *buf, size_t n) {
+    const char *v = cfg_get("MLB_PITCHMOD");
+    if (v && !strcmp(v, "off")) return NULL;
+    if (v && *v) return v;
+    char exe[PLAT_PATH_MAX];
+    if (!plat_exe_path(exe, sizeof exe)) return NULL;
+    char *cut = plat_last_sep(exe);
+    if (!cut) return NULL;
+    cut[1] = 0;
+    snprintf(buf, n, "%spitchmod.txt", exe);
+    FILE *f = fopen(buf, "rb");
+    if (!f) return NULL;   // no file beside the exe: the mod is simply not installed
+    fclose(f);
+    return buf;
+}
+
+// The shipped bytes of every table, kept at the first apply so a changed file can be applied again from scratch
+// (pitchmod_poll: MLB_PITCHMOD_RELOAD=1 re-reads the file when it changes, for tuning while the game runs).
+static uint8_t orig[T_COUNT][NTYPES * 0x28];
+static int shipped[T_COUNT], have_orig;
+static char cur_path[PLAT_PATH_MAX];
+static long long cur_mtime;
+
+static long long file_mtime(const char *path) {
+    struct _stat64 st;
+    return _stat64(path, &st) ? -1 : (long long)st.st_mtime;
+}
+
+static void apply_file(const char *path);
+
+#define GUESS_K_WORD 0x100   // k's byte offset in the patch page (recomp/patches.py lists the words in use)
+static float guess_k = -1;   // batter_guess; < 0: the game's own
+
+// After every apply: k to the patch page and the set switched to match the file.
+static void batter_guess_setup(void) {
+    int set = rt_patch_set("batter_guess");
+    char *page = (char *)rt_patch_page();
+    if (set < 0 || !page) {
+        if (guess_k >= 0) rt_log("pitchmod: batter_guess needs a build generated with mods/pitch-types/patches.txt");
+        return;
+    }
+    float k = guess_k < 0 ? 1.0f : guess_k;
+    memcpy(page + GUESS_K_WORD, &k, 4);   // k first: the site reads it whenever the set is on
+    rt_patch_switch(set, guess_k >= 0);
+    if (guess_k >= 0) rt_log("pitchmod: batter guess: CPU batters' aim leans %.2f times on their guess", guess_k);
+}
+
+void shapes_start(void);      // shapes.c: the pitcher_shapes patch set, each pitcher's own movement (Pitching++)
+void extension_start(void);   // extension.c: the release_extension set, perceived velocity per delivery (Pitching++)
+void classes_start(void);     // classes.c: the pitch_classes set, each retyped pitch the game type that fits (Pitching++)
+void rubber_start(void);      // rubber.c: the rubber_spot set, each pitcher where he stands on the rubber (Pitching++)
+void styles_start(void);      // styles.c: the delivery_styles set, each pitcher his own edited delivery copy (Pitching++)
+void slidestep_start(void);   // slidestep.c: the slide_steps set, each pitcher his own slide step (Pitching++)
+
+void pitchmod_apply(void) {
+    shapes_start();      // first: these do not depend on pitchmod.txt, and boot calls this once
+    extension_start();
+    classes_start();
+    rubber_start();
+    styles_start();
+    slidestep_start();
+    char buf[PLAT_PATH_MAX];
+    const char *path = def_path(buf, sizeof buf);
+    if (!path) return;
+    if (strcmp(rt_game_build, "1.0.20")) {
+        rt_log("pitchmod: %s: no table addresses known for game %s; nothing changed", path, rt_game_build);
+        return;
+    }
+    const Table *tab = tables_1020;
+    for (int t = 0; t < T_COUNT; t++) {
+        shipped[t] = table_fnv(t, &tab[t]) == tab[t].fnv;
+        if (!shipped[t]) rt_log("pitchmod: the %s table is not the shipped one; its lines are skipped", tab[t].name);
+        else memcpy(orig[t], (const void *)(uintptr_t)tab[t].addr, tab[t].size);
+    }
+    have_orig = 1;
+    snprintf(cur_path, sizeof cur_path, "%s", path);
+    cur_mtime = file_mtime(path);
+    apply_file(path);
+}
+
+// Hot reload (diagnostic, MLB_PITCHMOD_RELOAD=1): checked at most once a second from hid.c's controller poll. The
+// tables go back to their shipped bytes, then the file is applied again; the game reads them at every pitch.
+void pitchmod_poll(void) {
+    static int on = -1;
+    static uint64_t next;
+    if (on < 0) {   // no settings row: cfg_value would refuse the key, so read the raw value
+        const char *v = cfg_get("MLB_PITCHMOD_RELOAD");
+        on = have_orig && v && *v && strcmp(v, "0") != 0;
+    }
+    if (!on) return;
+    uint64_t now = plat_now_ns();
+    if (now < next) return;
+    next = now + 1000000000ull;
+    long long m = file_mtime(cur_path);
+    if (m == cur_mtime || m < 0) return;
+    cur_mtime = m;
+    const Table *tab = tables_1020;
+    for (int t = 0; t < T_COUNT; t++)
+        if (shipped[t] && !poke(tab[t].addr, orig[t], tab[t].size)) return;
+    rt_log("pitchmod: %s changed; the tables are back to the shipped ones and the file is applied again", cur_path);
+    apply_file(cur_path);
+}
+
+static void apply_file(const char *path) {
+    FILE *f = fopen(path, "rb");
+    if (!f) {
+        rt_log("pitchmod: cannot open %s; nothing changed", path);
+        return;
+    }
+    const Table *tab = tables_1020;
+    char line[512];
+    int no = 0, done = 0, bad = 0;
+    guess_k = -1;
+    while (fgets(line, sizeof line, f)) {
+        no++;
+        char *hash = strchr(line, '#');
+        if (hash) *hash = 0;
+        char kind[16];
+        int id, used = 0;
+        float k;
+        char setname[32];
+        int on;
+        if (sscanf(line, " %15s", kind) == 1 && !strcmp(kind, "switch")) {   // A/B tests: a code patch set on / off
+            int set = sscanf(line, " %*s %31s %d", setname, &on) == 2 ? rt_patch_set(setname) : -1;
+            if (set < 0) {
+                rt_log("pitchmod: %s:%d: switch needs a patch set of this build and 0 or 1", path, no), bad++;
+                continue;
+            }
+            rt_patch_switch(set, on != 0);
+            rt_log("pitchmod: patch set %s %s", setname, on ? "on" : "off");
+            done++;
+            continue;
+        }
+        if (sscanf(line, " %15s", kind) == 1 && !strcmp(kind, "batter_guess")) {
+            if (sscanf(line, " %*s %f", &k) != 1 || !(k >= 0.0f && k <= 1.5f)) {
+                rt_log("pitchmod: %s:%d: batter_guess needs a value of 0-1.5", path, no), bad++;
+                continue;
+            }
+            guess_k = k;
+            done++;
+            continue;
+        }
+        if (sscanf(line, " %15s %d%n", kind, &id, &used) < 2) {
+            if (sscanf(line, " %15s", kind) == 1) rt_log("pitchmod: %s:%d: cannot read the line", path, no), bad++;
+            continue;
+        }
+        const char *rest = line + used;
+        if (id < 0 || id >= NTYPES) {
+            rt_log("pitchmod: %s:%d: pitch id %d is not one of the game's 0-18", path, no, id), bad++;
+            continue;
+        }
+        if (!strcmp(kind, "phys")) {
+            float v[8];
+            if (sscanf(rest, "%f %f %f %f %f %f %f %f", &v[0], &v[1], &v[2], &v[3], &v[4], &v[5], &v[6], &v[7]) != 8) {
+                rt_log("pitchmod: %s:%d: phys needs eight numbers", path, no), bad++;
+                continue;
+            }
+            if (!shipped[T_PHYS]) continue;
+            if (!poke(tab[T_PHYS].addr + id * 0x28 + 8, v, sizeof v)) goto fail;
+            rt_log("pitchmod: pitch %d physics: spin %.1f rev/s, axis %.0f/%.0f deg, magnus %.2f, stress %.2f, %.0f mph, "
+                   "break %.0f deg x %.3f", id, v[0], v[2], v[1], v[3], v[4], v[5], v[6], v[7]);
+        } else if (!strcmp(kind, "mph")) {
+            int lo, hi;
+            if (sscanf(rest, "%d %d", &lo, &hi) != 2 || lo < 1 || lo > 120 || hi < 1 || hi > 120) {
+                rt_log("pitchmod: %s:%d: mph needs two speeds of 1-120", path, no), bad++;
+                continue;
+            }
+            if (!shipped[T_MPH_LO] || !shipped[T_MPH_HI]) continue;
+            int32_t l = lo, h = hi;
+            if (!poke(tab[T_MPH_LO].addr + id * 4, &l, 4) || !poke(tab[T_MPH_HI].addr + id * 4, &h, 4)) goto fail;
+            rt_log("pitchmod: pitch %d speed: %d mph at velocity 0, %d mph at velocity 99", id, lo, hi);
+        } else if (!strcmp(kind, "aim")) {
+            float a;
+            if (id >= 18 || sscanf(rest, "%f", &a) != 1) {
+                rt_log("pitchmod: %s:%d: aim needs an id of 0-17 and one number", path, no), bad++;
+                continue;
+            }
+            if (!shipped[T_AIM]) continue;
+            if (!poke(tab[T_AIM].addr + id * 4, &a, 4)) goto fail;
+            rt_log("pitchmod: pitch %d aim offset %.3f", id, a);
+        } else if (!strcmp(kind, "audio")) {
+            int a;
+            if (sscanf(rest, "%d", &a) != 1 || a < 0 || a > 21) {
+                rt_log("pitchmod: %s:%d: audio needs a commentary pitch id of 0-21", path, no), bad++;
+                continue;
+            }
+            uint32_t v = (uint32_t)a;
+            for (int t = T_AUDIO0; t <= T_AUDIO3; t++)
+                if (shipped[t] && !poke(tab[t].addr + id * 4, &v, 4)) goto fail;
+            rt_log("pitchmod: pitch %d commentary id %d", id, a);
+        } else {
+            rt_log("pitchmod: %s:%d: unknown kind %s (phys, mph, aim, audio, batter_guess)", path, no, kind), bad++;
+            continue;
+        }
+        done++;
+    }
+    fclose(f);
+    batter_guess_setup();
+    rt_log("pitchmod: %s: %d change%s applied%s", path, done, done == 1 ? "" : "s", bad ? ", some lines skipped" : "");
+    return;
+fail:
+    fclose(f);
+    batter_guess_setup();
+    rt_log("pitchmod: cannot write the game's tables (line %d); the rest of %s is skipped", no, path);
+}
diff --git a/runtime/mlb/pitchspeed.c b/runtime/mlb/pitchspeed.c
new file mode 100644
index 0000000..c887e97
--- /dev/null
+++ b/runtime/mlb/pitchspeed.c
@@ -0,0 +1,148 @@
+// mlbts-native: Real Pitch Speed mod. The game's Fastball / Offspeed Pitch Speed sliders lead to real speed at +5.
+//
+// MLB_PITCHSPEED=<time scale at +5>   (1.07 = MLB flight times; "off" or unset: nothing runs)
+// MLB_PITCHSPEED_LOG=1                 one log line per pitch: slider, time scales, time on screen
+//
+// How the game shows a pitch [C, 1.0.20, decoded 2026-11-16]: in slow motion. f_700024be20 builds a multiplier per
+// pitch (pitch +0x174): 0.880, plus -0.16..+0.12 from the batting side's difficulty (0 at All-Star), plus the slider
+// that applies to the pitch, 0.032 a step (Fastball Pitch Speed = slider 21 when the pitch class +0x13 is 0 or 5,
+// Offspeed Pitch Speed = slider 37 otherwise; -5..+5), minus up to 0.133 for pitches of 92 mph and up in some modes,
+// clamped to 0.5..1.25. f_7000248000 copies it to the ball (+0x394) and f_70016637b0 makes the ball's time scale
+// (+0x3cc, usually 5/6 of it). The ball flies to the plate in state 1 (+0x300), where f_7001662140 advances it by the
+// frame time x +0x3cc: the path and the batter AI do not change, only how long the flight takes on screen. At the
+// game's own +5 a 98 mph 4-seam still takes 1.1-1.4x its real 0.384 s, depending on difficulty.
+//
+// This mod: from 0 to +5 the time scale moves in even steps from the game's own speed at 0 (difficulty included) to
+// MLB_PITCHSPEED; -5..0 stay the game's own. A watcher thread looks at the ball every few milliseconds; when the
+// game has set up a new pitch (a ball multiplier it did not write itself, with a time scale below 1: throws and
+// batted balls play at 1 and are left alone), it reads the pitch's slider and rewrites the ball's time scale and
+// multiplier before the release. No game code is changed and no function hook is used.
+// Every pointer is checked with mem_guest_readable, which answers from the memory layout for the heap and the modules:
+// the OS query (plat_mem_readable, a VirtualQuery) took 0.7 ms on average and up to 7 ms on this process's
+// multi-gigabyte heap, under the address-space lock the replay thread's write-watch queries and the game's page
+// faults need. At three queries a tick a Road to the Show match ran at 52-56 fps with 120-280 frames over 25 ms a
+// minute instead of 58 fps and 50-80 (2026-11-19).
+//   The ball:  *(*(0x70045c2428) + 8)                                  (f_70016703f0)
+//   The pitch: G = *(0x7003aeb728); ctx = *(G + 0x18 + 8 * u8 *(*(G + 0x20) + 0x124));
+//              *(*(*(*(ctx + 0x18) + 0x10) + 0xf0) + 0x150)              (f_70002e2348, f_70002e9a20)
+//   Sliders:   int8 [39] at *(0x700464ab80)                              (f_70017c23a0)
+// Measured (Minors, Fastball +5, Offspeed +3, MLB_PITCHSPEED=1.07): fastballs 0.778 -> 1.070, 0.38-0.40 s on screen
+// (MLB 0.384 s); offspeed 0.725 -> 0.900, 0.58-0.60 s. Works with the pitch types mod (pitchmod.c) or without it:
+// that one changes how pitches move, this one only how fast they play.
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "cfg.h"
+#include "host.h"
+#include "platform/platform.h"
+
+static float speed_at_max;   // MLB_PITCHSPEED
+static int log_on;
+
+static int read_u64(uint64_t a, uint64_t *out) {
+    if (!a || !mem_guest_readable(a, 8)) return 0;
+    *out = *(const uint64_t *)(uintptr_t)a;
+    return 1;
+}
+
+static uint64_t current_ball(void) {
+    uint64_t g, ball;
+    if (!read_u64(0x70045c2428ull, &g) || !read_u64(g + 8, &ball) || !ball || !mem_guest_readable(ball + 0x300, 0xd0))
+        return 0;
+    return ball;
+}
+
+// The pitch being thrown, by the path the game's own pitch setup takes; 0 when a step is missing.
+static uint64_t current_pitch(void) {
+    uint64_t g, a, ctx, o1, o2, obj, pitch;
+    if (!read_u64(0x7003aeb728ull, &g) || !read_u64(g + 0x20, &a) || !a || !mem_guest_readable(a + 0x124, 1)) return 0;
+    uint8_t idx = *(const uint8_t *)(uintptr_t)(a + 0x124);
+    if (!read_u64(g + 0x18 + idx * 8ull, &ctx) || !read_u64(ctx + 0x18, &o1) || !read_u64(o1 + 0x10, &o2) ||
+        !read_u64(o2 + 0xf0, &obj) || !read_u64(obj + 0x150, &pitch) || !mem_guest_readable(pitch + 0x174, 4))
+        return 0;
+    return pitch;
+}
+
+// The slider that applies to a pitch, -5..+5; *which = 21 (fastball) or 37 (offspeed).
+static int pitch_slider(uint64_t pitch, int *which) {
+    uint64_t arr;
+    uint8_t cls = *(const uint8_t *)(uintptr_t)(pitch + 0x13);
+    *which = (cls == 0 || cls == 5) ? 21 : 37;
+    if (!read_u64(0x700464ab80ull, &arr) || !arr || !mem_guest_readable(arr + *which, 1)) return 0;
+    int v = *(const int8_t *)(uintptr_t)(arr + *which);
+    return v < -5 ? -5 : v > 5 ? 5 : v;
+}
+
+// MLB_PITCHSPEED_LOG: the time the ball spends in state 1 (on its way to the plate) and its time scale.
+static void flight_watch(uint64_t ball) {
+    static uint32_t prev;
+    static uint64_t t0;
+    static float ts0;
+    uint32_t st = *(const uint32_t *)(uintptr_t)(ball + 0x300);
+    float ts = *(const float *)(uintptr_t)(ball + 0x3cc);
+    if (st == 1 && prev != 1) t0 = plat_now_ns(), ts0 = ts;
+    if (st != 1 && prev == 1 && t0)
+        rt_log("pitchspeed: pitch on screen %.3f s at time scale %.3f", (plat_now_ns() - t0) / 1e9, ts0);
+    prev = st;
+}
+
+static void tick(void) {
+    static float written;   // the ball multiplier this mod last wrote (or left alone)
+    uint64_t ball = current_ball();
+    if (!ball) return;
+    if (log_on) flight_watch(ball);
+    float *mult = (float *)(uintptr_t)(ball + 0x394), *ts = (float *)(uintptr_t)(ball + 0x3cc);
+    float m = *mult, game = *ts;
+    if (m == written || game == 1.0f || !(m > 0.05f && m < 4.0f) || !(game > 0.05f && game < 4.0f)) return;
+    uint64_t pitch = current_pitch();
+    written = m;
+    if (!pitch || *(const float *)(uintptr_t)(pitch + 0x174) != m) {   // not the pitch this ball carries
+        if (log_on) rt_log("pitchspeed: the pitch was not found; the game's speed %.3f is kept", game);
+        return;
+    }
+    int which, v = pitch_slider(pitch, &which);
+    if (v <= 0) {
+        if (log_on) rt_log("pitchspeed: slider %d at %d: the game's own speed %.3f", which, v, game);
+        return;
+    }
+    float ratio = game / m;                    // the time scale per unit of multiplier (usually 5/6)
+    float at0 = (m - 0.032f * v) * ratio;      // the game's time scale at slider 0
+    float want = at0 + (speed_at_max - at0) * (v / 5.0f);
+    *mult = m * (want / game);   // the game derives +0x3cc from +0x394 again in places: keep them in step
+    *ts = want;
+    written = *mult;
+    if (log_on)
+        rt_log("pitchspeed: slider %d at %+d: time scale %.3f (game %.3f, at 0 %.3f, at +5 %.3f)", which, v, want, game,
+               at0, speed_at_max);
+}
+
+static void watcher(void *arg) {
+    (void)arg;
+    for (;;) {
+        tick();
+        plat_sleep_ns(4000000ull);   // a pitch's setup comes a good half second before its release
+    }
+}
+
+void pitchspeed_start(void) {
+    const char *v = cfg_get("MLB_PITCHSPEED");
+    if (!v || !*v || !strcmp(v, "off") || !strcmp(v, "0")) return;
+    if (strcmp(rt_game_build, "1.0.20")) {
+        rt_log("pitchspeed: no addresses known for game %s; off", rt_game_build);
+        return;
+    }
+    float x = (float)atof(v);
+    if (!(x > 0.3f && x < 3.0f)) {
+        rt_log("pitchspeed: MLB_PITCHSPEED=%s is not a time scale of 0.3-3; off", v);
+        return;
+    }
+    speed_at_max = x;
+    const char *l = cfg_get("MLB_PITCHSPEED_LOG");
+    log_on = l && *l && strcmp(l, "0") != 0;
+    if (!plat_thread_spawn(watcher, NULL, "pitchspeed", 0)) {
+        rt_log("pitchspeed: cannot start the watcher thread; off");
+        return;
+    }
+    rt_log("pitchspeed: on; the Pitch Speed sliders reach time scale %.2f at +5 (-5..0 are the game's own)", x);
+}
diff --git a/runtime/mlb/quirkmod.c b/runtime/mlb/quirkmod.c
new file mode 100644
index 0000000..b90d8f5
--- /dev/null
+++ b/runtime/mlb/quirkmod.c
@@ -0,0 +1,871 @@
+// mlbts-native: RTTS quirks mod (TheShow/mods/rtts-quirks: DESIGN.md, PHASE2.md). Builds each quirk offer in the
+// offer scenes that tools/build_offers.py adds to DIALOGSCENEFE.DSD.
+//
+// Hook [1.0.20]: when a dialog step starts, f_700177fd70 collects the step's reply options into the scene object
+// (count byte +0x2d8, node pointers +0x2e0); then the step's spoken line runs through the FE scene vtable slot +0xe8
+// (0x70021885e0 = f_7001783860), which builds the choice UI from that list and shows at most 3 options. This module
+// puts its own host function in that slot. When the list holds quirk-mod options (reply ids 0x5100+bit / 0x51FF), it
+// chooses 1-3 of them by the rules of tools/offer_sim.py (owned, role, locks, earned, carry-over, focus, seeded random,
+// size by moment) and shrinks the list to them, then calls the original. Nothing else is touched: shipped scenes have
+// no reply ids in that range.
+//
+// Player data read here [static, see PHASE2.md section 4]: RTTS player record = *(*0x700227e6c0)->lookup(0xd06);
+// quirk word record+0x28 (bits 0-18 quirks, 19-26 carry-over, 27 two-way warned); velocity f_7001844250(rec, slot),
+// movement f_70018442a0, attributes f_700183bb94(rec+0x48 attrs, id); role byte rec+0xa2; pitcher type rec+0x70 bits
+// 21-23; draft round rec+0x84 bits 14-20; RTTS block f_700043b2d8 (pick in round +0x63b37); college f_70003ff064;
+// last-season stats from the career history (block+0x50).
+//
+// MLB_QUIRKMOD = path of quirkmod.txt (tools/export_quirkmod.py); default quirkmod.txt beside mlb.exe; "off" disables.
+// MLB_QUIRKMOD_RELOAD=1 (tests): re-read the file when it changed, at the next offer step. MLB_QUIRKMOD_PROBE=1: raw dumps.
+// MLB_QUIRKMOD_TEST_QUEUE=spring|college (tests): queue that offer message when the first dialog line runs.
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "cfg.h"
+#include "host.h"
+#include "platform/platform.h"
+
+#define NQ 19
+#define SLOT_LINE 0x70021885e0ull        // FE scene vtable +0xe8
+#define ORIG_LINE 0x7001783860ull
+#define LOOKUP_PTR 0x700227e6c0ull
+#define FN_LOOKUP 0x700181a6fcull
+#define FN_VELOCITY 0x7001844250ull
+#define FN_MOVEMENT 0x70018442a0ull
+#define FN_ATTR 0x700183bb94ull
+#define RTTS_BLOCK_PTR 0x7002c53e50ull   // global read by f_700043b2d8
+#define FN_COLLEGE 0x70003ff064ull
+#define FN_OFFER_HAS 0x70003fdc78ull
+#define FN_OFFER_NOW 0x70003fddc4ull
+#define FN_OFFER_NEED 0x70003fdd74ull
+#define RTTS_PLAYER 0xd06
+// New-season trigger [1.0.20]: f_70007c48d4 registers handlers for game event 0x2b from pointer slots; slot
+// 0x70022817b8 holds f_7000467cec, which runs f_700044b460 (stats slots shift, season count +1). Our host function
+// replaces that slot at boot, calls the original, and when the count moved queues an inbox message with
+// f_7000467400({scene id, flag}) (the AddMessage story event uses the same function).
+#define SLOT_SEASON 0x70022817b8ull
+#define ORIG_SEASON 0x7000467cecull
+#define FN_ADD_MESSAGE 0x7000467400ull
+#define REPLY_OFFER 0x5100u
+#define REPLY_FALLBACK 0x51FFu
+
+enum { ROLE_BOTH, ROLE_HITTER, ROLE_PITCHER };
+enum { M_COLLEGE, M_DRAFT, M_SPRING };
+enum { F_GENERAL, F_CONTACT, F_POWER, F_SPEED, F_VELOCITY, F_BREAK, F_CONTROL, F_COUNT };
+static const char *fam_name[F_COUNT] = {"General", "Contact", "Power", "Speed", "Velocity", "Break", "Control"};
+static const char *moment_name[3] = {"college", "draft", "spring"};
+// quirk bits with rules (quirks.json order)
+enum { Q_HOME = 0, Q_ROAD = 1, Q_PICKOFF = 7, Q_STOPPER = 9, Q_SITUATIONAL = 11, Q_OUTLIER1 = 15, Q_OUTLIER2 = 16,
+       Q_BREAK = 17, Q_TABLE = 18 };
+
+typedef struct { char name[32]; int role, family; char text[128]; } QuirkDef;   // text: short line shown in the offer
+typedef struct { char name[24]; int block, type, off; } StatDef;   // block 0 bat / 1 pitch, type 0 u8 / 1 i16
+
+static struct {
+    int loaded;
+    double param[96];
+    char param_name[96][32];
+    int nparam;
+    QuirkDef q[NQ];
+    int carry_bit[NQ];                         // -1 = none
+    int college_hit[19], college_pit[19], college_prestige[19];
+    double draft_chance[6];                    // index = pick 1..5
+    uint32_t host_scene[16];
+    int host_moment[16], nhost;
+    StatDef stat[32];
+    int nstat;
+    int attr_id[3][2], attr_n[3];             // contact, power, speed: attribute ids, averaged
+    char force[16][24];
+    double force_val[16][6];
+    int force_n[16], nforce;
+} C;
+
+static uint64_t orig_line;
+
+static double P(const char *name, double dflt) {
+    for (int i = 0; i < C.nparam; i++)
+        if (!strcmp(C.param_name[i], name)) return C.param[i];
+    return dflt;
+}
+
+static int fam_of(const char *s) {
+    for (int i = 0; i < F_COUNT; i++)
+        if (!strcmp(s, fam_name[i])) return i;
+    return F_GENERAL;
+}
+
+static const double *forced(const char *name, int *n) {
+    for (int i = 0; i < C.nforce; i++)
+        if (!strcmp(C.force[i], name)) return *n = C.force_n[i], C.force_val[i];
+    return NULL;
+}
+
+// ---- config ----
+static const char *config_path(char *buf, size_t n) {
+    const char *v = cfg_get("MLB_QUIRKMOD");
+    if (v && !strcmp(v, "off")) return NULL;
+    if (v && *v) return v;
+    char exe[PLAT_PATH_MAX];
+    if (!plat_exe_path(exe, sizeof exe)) return NULL;
+    char *cut = plat_last_sep(exe);
+    if (!cut) return NULL;
+    cut[1] = 0;
+    snprintf(buf, n, "%squirkmod.txt", exe);
+    FILE *f = fopen(buf, "rb");
+    if (!f) return NULL;
+    fclose(f);
+    return buf;
+}
+
+static char g_path[PLAT_PATH_MAX];
+static uint64_t g_cfg_hash;
+static uint64_t file_hash(const char *path) {   // FNV-1a of the file, 0 if unreadable
+    FILE *f = fopen(path, "rb");
+    if (!f) return 0;
+    uint64_t h = 0xcbf29ce484222325ull;
+    for (int ch; (ch = fgetc(f)) != EOF;) h = (h ^ (uint8_t)ch) * 0x100000001b3ull;
+    fclose(f);
+    return h;
+}
+
+static int load_config(const char *path) {
+    if (path != g_path) snprintf(g_path, sizeof g_path, "%s", path);
+    g_cfg_hash = file_hash(path);
+    FILE *f = fopen(path, "rb");
+    if (!f) return rt_log("quirkmod: cannot open %s; offers are not filtered", path), 0;
+    memset(&C, 0, sizeof C);
+    for (int i = 0; i < NQ; i++) C.carry_bit[i] = -1, snprintf(C.q[i].name, sizeof C.q[i].name, "quirk %d", i);
+    char line[256], a[64], b[64], d[64], e[64];
+    int nq = 0;
+    while (fgets(line, sizeof line, f)) {
+        char *hash = strchr(line, '#');
+        if (hash) *hash = 0;
+        int i1, i2;
+        double v;
+        if (sscanf(line, " param %31s %lf", a, &v) == 2 && C.nparam < 96) {
+            snprintf(C.param_name[C.nparam], 32, "%s", a), C.param[C.nparam++] = v;
+        } else if (sscanf(line, " quirk %d %15s %15s %n", &i1, a, b, &i2) == 3 && i1 >= 0 && i1 < NQ) {
+            C.q[i1].role = !strcmp(a, "hitter") ? ROLE_HITTER : !strcmp(a, "pitcher") ? ROLE_PITCHER : ROLE_BOTH;
+            C.q[i1].family = fam_of(b);
+            char *nm = line + i2;
+            nm[strcspn(nm, "\r\n")] = 0;
+            snprintf(C.q[i1].name, sizeof C.q[i1].name, "%s", nm);
+            nq++;
+        } else if (sscanf(line, " qtext %d %n", &i1, &i2) == 1 && i1 >= 0 && i1 < NQ) {
+            char *t = line + i2;
+            t[strcspn(t, "\r\n")] = 0;
+            snprintf(C.q[i1].text, sizeof C.q[i1].text, "%s", t);
+        } else if (sscanf(line, " carry %d %d", &i1, &i2) == 2 && i1 >= 0 && i1 < NQ && i2 >= 19 && i2 < 32) {
+            C.carry_bit[i1] = i2;
+        } else if (sscanf(line, " college %d %15s %15s %d", &i1, a, b, &i2) == 4 && i1 >= 0 && i1 < 19) {
+            C.college_hit[i1] = fam_of(a), C.college_pit[i1] = fam_of(b), C.college_prestige[i1] = i2;
+        } else if (sscanf(line, " draftchance %d %lf", &i1, &v) == 2 && i1 >= 1 && i1 <= 5) {
+            C.draft_chance[i1] = v;
+        } else if (sscanf(line, " host %d %15s", &i1, a) == 2 && C.nhost < 16) {
+            C.host_scene[C.nhost] = (uint32_t)i1;
+            C.host_moment[C.nhost++] = !strcmp(a, "college") ? M_COLLEGE : !strcmp(a, "draft") ? M_DRAFT : M_SPRING;
+        } else if (sscanf(line, " stat %23s %7s %7s %i", a, b, d, &i1) == 4 && C.nstat < 32) {
+            StatDef *s = &C.stat[C.nstat++];
+            snprintf(s->name, sizeof s->name, "%s", a);
+            s->block = !strcmp(b, "pitch"), s->type = !strcmp(d, "derived") ? 2 : !strcmp(d, "i16"), s->off = i1;
+        } else if (sscanf(line, " attr %23s %i %i", a, &i1, &i2) >= 2) {
+            int which = !strcmp(a, "contact") ? 0 : !strcmp(a, "power") ? 1 : !strcmp(a, "speed") ? 2 : -1;
+            if (which >= 0) {
+                int two = sscanf(line, " attr %*s %i %i", &i1, &i2) == 2;
+                C.attr_id[which][0] = i1, C.attr_id[which][1] = two ? i2 : i1, C.attr_n[which] = 1;
+            }
+        } else if (sscanf(line, " force %23s %n", e, &i2) == 1 && C.nforce < 16) {
+            int k = C.nforce++, n = 0, used;
+            snprintf(C.force[k], 24, "%s", e);
+            const char *p = line + i2;
+            while (n < 6 && sscanf(p, "%lf%n", &C.force_val[k][n], &used) == 1) n++, p += used;
+            C.force_n[k] = n;
+        }
+    }
+    fclose(f);
+    if (nq != NQ) return rt_log("quirkmod: %s defines %d of the 19 quirks; offers are not filtered", path, nq), 0;
+    rt_log("quirkmod: %s: %d params, %d host scene(s), %d stats, %d forced input(s)", path, C.nparam, C.nhost,
+           C.nstat, C.nforce);
+    return C.loaded = 1;
+}
+
+// ---- deterministic random (same as tools/offer_sim.py) ----
+static uint64_t fnv1a64(const char *s) {
+    uint64_t h = 0xcbf29ce484222325ull;
+    for (; *s; s++) h = (h ^ (uint8_t)*s) * 0x100000001b3ull;
+    return h;
+}
+static uint64_t rng_next(uint64_t *s) {
+    *s += 0x9e3779b97f4a7c15ull;
+    uint64_t z = *s;
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ull;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebull;
+    return z ^ (z >> 31);
+}
+static int rng_below(uint64_t *s, int n) { return (int)(rng_next(s) % (uint64_t)n); }
+static int rng_chance(uint64_t *s, double p) { return rng_next(s) % 10000 < (uint64_t)(p * 10000 + 0.5); }
+
+// ---- inputs ----
+typedef struct {
+    int ok, role, twoway, pitcher_type, moment, season;
+    uint32_t word;
+    int vel[6], mov[6], ctl[6], contact, power, speed;
+    int college, offer_full, draft_round, draft_pick;
+    double st[32];                             // by C.stat index; < 0 = unknown
+} Inputs;
+
+static int stat_index(const char *name) {
+    for (int i = 0; i < C.nstat; i++)
+        if (!strcmp(C.stat[i].name, name)) return i;
+    return -1;
+}
+static double S(const Inputs *in, const char *name) {
+    int n;
+    const double *f = forced(name, &n);
+    if (f && n) return f[0];
+    int i = stat_index(name);
+    return i >= 0 && in->st[i] >= 0 ? in->st[i] : 0;
+}
+
+static int readable(uint64_t a, uint64_t n) { return a && plat_mem_readable(a, n); }
+static uint64_t rd64(uint64_t a) { return readable(a, 8) ? *(const uint64_t *)(uintptr_t)a : 0; }
+
+static void read_inputs(Cpu *c, int moment, Inputs *in) {
+    memset(in, 0, sizeof *in);
+    in->moment = moment;
+    uint64_t lookup = rd64(LOOKUP_PTR);
+    uint64_t handle = lookup ? rt_call(c, FN_LOOKUP, 2, lookup, (uint64_t)RTTS_PLAYER) : 0;
+    uint64_t rec = rd64(handle);
+    if (!readable(rec, 0xb0)) return;
+    in->word = *(const uint32_t *)(uintptr_t)(rec + 0x28);
+    uint8_t pos = *(const uint8_t *)(uintptr_t)(rec + 0xa2);
+    uint64_t elig = *(const uint64_t *)(uintptr_t)(rec + 0x84);
+    in->role = pos == 0 ? ROLE_PITCHER : ROLE_HITTER;
+    in->twoway = pos == 0 ? ((elig >> 0x15) & 0xff) != 0 : ((elig >> 0x38) & 0x7) != 0;   // inferred
+    in->pitcher_type = (int)(((*(const uint32_t *)(uintptr_t)(rec + 0x70)) << 8) >> 0x1d);   // 0 SP 1 RP 2 CL (inferred)
+    in->draft_round = (int)((*(const uint32_t *)(uintptr_t)(rec + 0x84) >> 14) & 0x7f);
+    for (int s = 0; s < 6; s++) {
+        in->vel[s] = (int)(rt_call(c, FN_VELOCITY, 2, rec, (uint64_t)s) & 0xff);
+        in->mov[s] = (int)(rt_call(c, FN_MOVEMENT, 2, rec, (uint64_t)s) & 0xff);
+    }
+    uint64_t attrs = rd64(rec + 0x48);
+    if (attrs) {
+        for (int s = 0; s < 6; s++) in->ctl[s] = (int)(rt_call(c, FN_ATTR, 2, attrs, (uint64_t)(0x20 + s)) & 0xff);
+        int *dst[3] = {&in->contact, &in->power, &in->speed};
+        for (int w = 0; w < 3; w++)
+            if (C.attr_n[w])
+                *dst[w] = ((int)(rt_call(c, FN_ATTR, 2, attrs, (uint64_t)C.attr_id[w][0]) & 0xff) +
+                           (int)(rt_call(c, FN_ATTR, 2, attrs, (uint64_t)C.attr_id[w][1]) & 0xff)) / 2;
+    }
+    uint64_t block = rd64(RTTS_BLOCK_PTR);   // what f_700043b2d8 returns
+    in->draft_pick = readable(block + 0x63b37, 1) ? *(const uint8_t *)(uintptr_t)(block + 0x63b37) : 0;
+    int16_t team = (int16_t)rt_call(c, FN_COLLEGE, 0);
+    in->college = team >= 0x87 && team < 0x87 + 19 ? team - 0x87 : -1;
+    if (in->college >= 0 && (rt_call(c, FN_OFFER_HAS, 1, (uint64_t)team) & 1))
+        in->offer_full = (int)(rt_call(c, FN_OFFER_NOW, 1, (uint64_t)team) & 0xffffffff) >=
+                         (int)(rt_call(c, FN_OFFER_NEED, 1, (uint64_t)team) & 0xffffffff);
+    // last season's stats: career history H = block + 0x50, one 0x70-byte set per (level k = 0..2, slot), index
+    // slot + k*0x25 (f_700044b1e0). Slot 0 is always the CURRENT season: at each new season f_700044b460 shifts every
+    // slot up by one (deep copy, f_700183ddd4) and clears slot 0, then counts seasons (H + 25000, max 0x25). So last
+    // season = slot 1, present once the count is >= 2 (verified in game 2026-11-17: live AA stats land in slot 0, k 2).
+    for (int i = 0; i < C.nstat; i++) in->st[i] = -1;
+    uint64_t H = block ? block + 0x50 : 0;
+    if (readable(H + 25000, 4)) {
+        int seasons = *(const int32_t *)(uintptr_t)(H + 25000);
+        in->season = seasons;
+        int idx = (int)P("stats_slot", 1);
+        if (idx >= 0 && idx < seasons && idx < 0x25) {
+            for (int i = 0; i < C.nstat; i++) in->st[i] = 0;
+            for (int k = 0; k < 3; k++) {
+                uint64_t set = H + 0x2d20 + (uint64_t)((idx + k * 0x25) & 0xff) * 0x70;
+                uint64_t pit = rd64(set + 0x68);
+                for (int i = 0; i < C.nstat; i++) {
+                    if (C.stat[i].type == 2) continue;   // derived below
+                    uint64_t base = C.stat[i].block ? pit : set;
+                    uint64_t a = base + (uint64_t)C.stat[i].off;
+                    if (!readable(a, 2)) continue;
+                    in->st[i] += C.stat[i].type ? *(const int16_t *)(uintptr_t)a : *(const uint8_t *)(uintptr_t)a;
+                }
+            }
+            // innings are stored as outs (3.0 IP = 9, checked against a box score): stats named *ip -> innings
+            for (int i = 0; i < C.nstat; i++) {
+                size_t L = strlen(C.stat[i].name);
+                if (L >= 2 && !strcmp(C.stat[i].name + L - 2, "ip") && in->st[i] >= 0) in->st[i] /= P("ip_divisor", 1);
+            }
+            // the batting record has no hit-by-pitch field the atlas could name: PA - AB - BB - SF - SH
+            int ihbp = stat_index("hbp"), ipa = stat_index("pa");
+            if (ihbp >= 0 && ipa >= 0 && in->st[ipa] >= 0) {
+                double d = in->st[ipa] - S(in, "ab") - S(in, "bb") - S(in, "sf") - S(in, "sh");
+                in->st[ihbp] = d > 0 ? d : 0;
+            }
+        }
+    }
+    // test overrides (quirks.json debug.force_inputs)
+    int n;
+    const double *f;
+    if ((f = forced("velocity", &n))) for (int s = 0; s < 6; s++) in->vel[s] = s < n ? (int)f[s] : 0;
+    if ((f = forced("movement", &n))) for (int s = 0; s < 6; s++) in->mov[s] = s < n ? (int)f[s] : 0;
+    if ((f = forced("control", &n))) for (int s = 0; s < 6; s++) in->ctl[s] = s < n ? (int)f[s] : 0;
+    if ((f = forced("role", &n)) && n) in->role = (int)f[0] == 2 ? ROLE_PITCHER : ROLE_HITTER, in->twoway = (int)f[0] == 3;
+    if ((f = forced("owned_mask", &n)) && n) in->word = (uint32_t)f[0];
+    if ((f = forced("draft_pick", &n)) && n) in->draft_pick = (int)f[0], in->draft_round = 1;
+    if ((f = forced("college", &n)) && n) in->college = (int)f[0];
+    if ((f = forced("offer_full", &n)) && n) in->offer_full = (int)f[0];
+    in->ok = 1;
+}
+
+// ---- offer rules (tools/offer_sim.py, kept in step) ----
+typedef struct { const Inputs *in; uint32_t owned; } Ctx;
+
+static int has(const Ctx *x, int bit) { return (x->owned >> bit) & 1; }
+static int best_mov(const Inputs *in) {
+    int m = 0;
+    for (int s = 0; s < 6; s++) if (in->mov[s] > m) m = in->mov[s];
+    return m;
+}
+static int role_ok(const Inputs *in, int bit) {
+    int r = C.q[bit].role;
+    if (r == ROLE_BOTH || in->twoway) return 1;
+    return r == in->role;
+}
+// 0 = open, 1 = rating lock (bypassable), 2 = prerequisite
+static int locked(const Ctx *x, int bit) {
+    const Inputs *in = x->in;
+    if (bit == Q_OUTLIER1) return in->vel[0] < P("lock_outlier1_min", 90) ? 1 : 0;
+    if (bit == Q_OUTLIER2) {
+        if (!has(x, Q_OUTLIER1)) return 2;
+        return in->vel[1] <= P("lock_outlier2_above", 90) ? 1 : 0;
+    }
+    if (bit == Q_BREAK) return best_mov(in) <= P("lock_break_above", 90) ? 1 : 0;
+    return 0;
+}
+static int earned(const Ctx *x, int bit) {
+    const Inputs *in = x->in;
+    int spring = in->moment == M_SPRING;
+    switch (bit) {
+    case Q_OUTLIER1: return in->vel[0] >= P("earn_outlier1_min", 99) && locked(x, bit) == 0;
+    case Q_OUTLIER2: return in->vel[1] >= P("earn_outlier2_min", 99) && locked(x, bit) == 0;
+    case Q_BREAK: {
+        int m1 = 0, m2 = 0;
+        for (int s = 0; s < 6; s++) {
+            if (in->mov[s] > m1) m2 = m1, m1 = in->mov[s];
+            else if (in->mov[s] > m2) m2 = in->mov[s];
+        }
+        return m1 >= P("earn_break_min", 99) && m2 >= P("earn_break_second_min", 90);
+    }
+    case Q_SITUATIONAL: {
+        if (!spring) return 0;
+        double ab = S(in, "risp_ab");
+        return ab >= P("earn_risp_ab", 50) && S(in, "risp_h") / ab >= P("earn_risp_avg", 0.333);
+    }
+    case Q_HOME:
+    case Q_ROAD: {
+        if (!spring) return 0;
+        const char *side = bit == Q_HOME ? "home" : "away";
+        char k1[24], k2[24];
+        int ok = 0;
+        if (in->role == ROLE_HITTER || in->twoway) {
+            snprintf(k1, sizeof k1, "%s_ab", side), snprintf(k2, sizeof k2, "%s_h", side);
+            double ab = S(in, k1);
+            if (ab >= P("earn_side_ab", 150)) ok |= S(in, k2) / ab >= P("earn_side_avg", 0.320);
+        }
+        if (in->role == ROLE_PITCHER || in->twoway) {
+            snprintf(k1, sizeof k1, "%s_ip", side), snprintf(k2, sizeof k2, "%s_er", side);
+            double ip = S(in, k1);
+            double need = in->pitcher_type == 1 ? P("earn_side_ip_reliever", 25)
+                        : in->pitcher_type == 2 ? P("earn_side_ip_closer", 25) : P("earn_side_ip_starter", 50);
+            if (ip >= need) ok |= 9 * S(in, k2) / ip <= P("earn_side_era", 2.5);
+        }
+        return ok;
+    }
+    case Q_STOPPER:
+        return spring && (S(in, "saves") >= P("earn_saves", 30) || S(in, "quality_starts") >= P("earn_qs", 12));
+    case Q_TABLE: return spring && S(in, "steals") >= P("earn_steals", 30);
+    }
+    return 0;
+}
+
+// families strongest first: (-value, name)
+static int families_by_strength(const Inputs *in, int out[3]) {
+    int fam[3], val[3];
+    if (in->role == ROLE_HITTER && !in->twoway) {
+        fam[0] = F_CONTACT, val[0] = in->contact, fam[1] = F_POWER, val[1] = in->power;
+        fam[2] = F_SPEED, val[2] = in->speed;
+    } else {
+        int ctl = 0;
+        for (int s = 0; s < 6; s++) if (in->ctl[s] > ctl) ctl = in->ctl[s];
+        fam[0] = F_VELOCITY, val[0] = in->vel[0], fam[1] = F_BREAK, val[1] = best_mov(in);
+        fam[2] = F_CONTROL, val[2] = ctl;
+    }
+    for (int i = 0; i < 3; i++) out[i] = i;
+    for (int i = 0; i < 3; i++)
+        for (int j = i + 1; j < 3; j++) {
+            int a = out[i], b = out[j];
+            if (val[b] > val[a] || (val[b] == val[a] && strcmp(fam_name[fam[b]], fam_name[fam[a]]) < 0))
+                out[i] = b, out[j] = a;
+        }
+    for (int i = 0; i < 3; i++) out[i] = fam[out[i]];
+    return 3;
+}
+
+static int spring_size(const Inputs *in) {
+    int sizes = 0, best = 0;
+    if (in->role == ROLE_HITTER || in->twoway) {
+        double ab = S(in, "ab"), h = S(in, "h"), bb = S(in, "bb"), hbp = S(in, "hbp"), sf = S(in, "sf"), tb = S(in, "tb");
+        double pa = ab + bb + hbp + sf;
+        if (pa >= P("spring_min_pa", 150) && ab > 0) {
+            double ops = (h + bb + hbp) / pa + tb / ab;
+            for (int t = 0; t < 8; t++) {
+                char k[32];
+                snprintf(k, sizeof k, "spring_hit_tier%d_min", t);
+                double mn = P(k, -1);
+                if (mn < 0) break;
+                if (ops >= mn) {
+                    snprintf(k, sizeof k, "spring_hit_tier%d_size", t);
+                    int sz = (int)P(k, 2);
+                    if (!sizes++ || sz > best) best = sz;
+                    break;
+                }
+            }
+        }
+    }
+    if (in->role == ROLE_PITCHER || in->twoway) {
+        double ip = S(in, "ip"), er = S(in, "er");
+        if (ip >= P("spring_min_ip", 50)) {
+            double era = 9 * er / ip;
+            for (int t = 0; t < 8; t++) {
+                char k[32];
+                snprintf(k, sizeof k, "spring_pit_tier%d_max", t);
+                double mx = P(k, -1);
+                if (mx < 0) break;
+                if (era <= mx) {
+                    snprintf(k, sizeof k, "spring_pit_tier%d_size", t);
+                    int sz = (int)P(k, 2);
+                    if (!sizes++ || sz > best) best = sz;
+                    break;
+                }
+            }
+        }
+    }
+    return sizes ? best : (int)P("spring_short", 2);
+}
+
+typedef struct {
+    int bits[3], n;              // chosen quirk bits, in order; n == 0 = fallback
+    uint32_t carry_after, warned_after;
+    int warning, size, focus;
+} Result;
+
+static void list_remove(int *a, int *n, int i) {
+    for (int k = i; k + 1 < *n; k++) a[k] = a[k + 1];
+    (*n)--;
+}
+static int list_has(const int *a, int n, int v) {
+    for (int i = 0; i < n; i++) if (a[i] == v) return 1;
+    return 0;
+}
+
+static void build_offer(const Inputs *in, Result *r) {
+    memset(r, 0, sizeof *r);
+    Ctx x = {in, in->word};
+    char seed[64];
+    snprintf(seed, sizeof seed, "%d|%d|%s", RTTS_PLAYER, in->season, moment_name[in->moment]);
+    uint64_t rng = fnv1a64(seed);
+    int owned_n = __builtin_popcount(in->word & 0x7ffff);
+    int max_owned = (int)P("max_owned", 15), size_max = (int)P("size_max", 3);
+    int warned_bit = (int)P("twoway_warned_bit", 27);
+    int warned = in->twoway && ((in->word >> warned_bit) & 1);
+    if (in->twoway && owned_n >= P("twoway_warn_at", 12) && !warned) r->warning = 1, warned = 1;
+    r->warned_after = warned ? 1u << warned_bit : 0;
+    if (owned_n >= max_owned) return;
+    int pool[NQ], np = 0, lockd[NQ], nl = 0;
+    for (int b = 0; b < NQ; b++) {
+        if (!role_ok(in, b) || has(&x, b)) continue;
+        int why = locked(&x, b);
+        if (why == 1) lockd[nl++] = b;
+        else if (why == 0) pool[np++] = b;
+    }
+    int strength[3];
+    families_by_strength(in, strength);
+    int focus = strength[0];
+    int coll = in->college;
+    if (in->moment == M_COLLEGE && coll >= 0)
+        focus = in->role == ROLE_PITCHER && !in->twoway ? C.college_pit[coll] : C.college_hit[coll];
+    r->focus = focus;
+    int bypass = 0;
+    if (in->moment == M_COLLEGE && coll >= 0 && C.college_prestige[coll] >= P("college_prestige_min", 5)) bypass = 1;
+    else if (in->moment == M_DRAFT && in->draft_round == 1 && in->draft_pick >= 1 && in->draft_pick <= 5) {
+        double p = C.draft_chance[in->draft_pick];
+        bypass = p > 0 && rng_chance(&rng, p);
+    }
+    int bypass_pick = -1, fam_locked[NQ], nfl = 0;
+    for (int i = 0; i < nl; i++) if (C.q[lockd[i]].family == focus) fam_locked[nfl++] = lockd[i];
+    if (bypass && nfl) bypass_pick = fam_locked[rng_below(&rng, nfl)];
+    // carried (quirks.json carry_bits order = quirk table order) and earned
+    int carried[NQ], nc = 0, earn[NQ], ne = 0;
+    for (int b = 0; b < NQ; b++)
+        if (C.carry_bit[b] >= 0 && ((in->word >> C.carry_bit[b]) & 1) && role_ok(in, b) && !has(&x, b) && locked(&x, b) != 2)
+            carried[nc++] = b;
+    for (int i = 0; i < np; i++)
+        if (earned(&x, pool[i]) && !list_has(carried, nc, pool[i])) earn[ne++] = pool[i];
+    int pinned = nc + ne;
+    int size;
+    if (in->moment == M_COLLEGE) size = in->offer_full ? (int)P("size_college_full", 3) : (int)P("size_college_initial", 2);
+    else if (in->moment == M_DRAFT)
+        size = in->draft_round == 1 && in->draft_pick == 1 ? (int)P("size_draft_first", 3)
+             : in->draft_round == 1 ? (int)P("size_draft_round1", 3) : (int)P("size_draft_later", 2);
+    else {
+        size = spring_size(in);
+        if (pinned > size) size = pinned;
+    }
+    if (size > size_max) size = size_max;
+    if (size > 3) size = 3;
+    r->size = size;
+    int *offer = r->bits, n = 0;
+    int g1[NQ], n1 = nc, g2[NQ], n2 = ne;
+    memcpy(g1, carried, sizeof(int) * nc), memcpy(g2, earn, sizeof(int) * ne);
+    while (n1 && n < size) { int k = rng_below(&rng, n1); offer[n++] = g1[k]; list_remove(g1, &n1, k); }
+    while (n2 && n < size) { int k = rng_below(&rng, n2); offer[n++] = g2[k]; list_remove(g2, &n2, k); }
+    for (int i = 0; i < nc; i++)
+        if (!list_has(offer, n, carried[i]) && C.carry_bit[carried[i]] >= 0) r->carry_after |= 1u << C.carry_bit[carried[i]];
+    for (int i = 0; i < ne; i++)
+        if (!list_has(offer, n, earn[i]) && C.carry_bit[earn[i]] >= 0) r->carry_after |= 1u << C.carry_bit[earn[i]];
+    if (bypass_pick >= 0 && !list_has(offer, n, bypass_pick) && n < size) offer[n++] = bypass_pick;
+    int order[4] = {focus, -1, -1, -1}, no = 1;
+    for (int i = 0; i < 3; i++) if (strength[i] != focus) order[no++] = strength[i];
+    for (int f = 0; f < no; f++) {
+        int fam = order[f], famp[NQ], nfp = 0, already = 0;
+        for (int i = 0; i < n; i++) if (C.q[offer[i]].family == fam) already = 1;
+        if (already) break;
+        for (int i = 0; i < np; i++) if (C.q[pool[i]].family == fam && !list_has(offer, n, pool[i])) famp[nfp++] = pool[i];
+        if (nfp) {
+            if (n < size) offer[n++] = famp[rng_below(&rng, nfp)];
+            break;
+        }
+    }
+    int rest[NQ], nr = 0;
+    for (int i = 0; i < np; i++) if (!list_has(offer, n, pool[i])) rest[nr++] = pool[i];
+    while (n < size && nr) { int k = rng_below(&rng, nr); offer[n++] = rest[k]; list_remove(rest, &nr, k); }
+    r->n = n;
+}
+
+// ---- probe (MLB_QUIRKMOD_PROBE=1): raw dumps at the first line of every FE scene, to map inputs ----
+static void hexlog(const char *what, uint64_t a, int n) {
+    if (!readable(a, (uint64_t)n)) { rt_log("quirkmod: probe %s at %#llx unreadable", what, (unsigned long long)a); return; }
+    for (int o = 0; o < n; o += 32) {
+        char line[128] = "";
+        for (int i = o; i < n && i < o + 32; i++)
+            snprintf(line + strlen(line), sizeof line - strlen(line), "%02x", *(const uint8_t *)(uintptr_t)(a + i));
+        rt_log("quirkmod: probe %s +%#04x %s", what, o, line);
+    }
+}
+static void probe(Cpu *c, uint64_t self) {
+    static uint32_t last_scene = 0xffffffff;
+    uint32_t sid = (uint32_t)rd64(rd64(self + 0x20));
+    if (sid == last_scene) return;
+    last_scene = sid;
+    Inputs in;
+    read_inputs(c, M_SPRING, &in);
+    rt_log("quirkmod: probe scene %u: role=%d twoway=%d type=%d word=%#x vel=%d,%d,%d,%d,%d,%d mov=%d,%d,%d,%d,%d,%d "
+           "ctl=%d,%d,%d,%d,%d,%d contact=%d power=%d speed=%d college=%d round=%d pick=%d seasons=%d", sid, in.role,
+           in.twoway, in.pitcher_type, in.word, in.vel[0], in.vel[1], in.vel[2], in.vel[3], in.vel[4], in.vel[5],
+           in.mov[0], in.mov[1], in.mov[2], in.mov[3], in.mov[4], in.mov[5], in.ctl[0], in.ctl[1], in.ctl[2], in.ctl[3],
+           in.ctl[4], in.ctl[5], in.contact, in.power, in.speed, in.college, in.draft_round, in.draft_pick, in.season);
+    uint64_t handle = rt_call(c, FN_LOOKUP, 2, rd64(LOOKUP_PTR), (uint64_t)RTTS_PLAYER);
+    uint64_t rec = rd64(handle);
+    hexlog("record", rec, 0xb0);
+    hexlog("attrs", rd64(rec + 0x48), 0x4e);
+    uint64_t block = rd64(RTTS_BLOCK_PTR);
+    if (!block) return;
+    uint64_t H = block + 0x50;
+    int seasons = readable(H + 25000, 4) ? *(const int32_t *)(uintptr_t)(H + 25000) : -1;
+    rt_log("quirkmod: probe block %#llx history %#llx seasons %d", (unsigned long long)block, (unsigned long long)H, seasons);
+    for (int idx = 0; idx <= 1; idx++) {   // slot 0 = this season, 1 = last season
+        if (idx >= seasons) continue;
+        for (int k = 0; k < 3; k++) {
+            char what[48];
+            uint64_t set = H + 0x2d20 + (uint64_t)((idx + k * 0x25) & 0xff) * 0x70;
+            snprintf(what, sizeof what, "season[%d] k%d bat", idx, k);
+            hexlog(what, set, 0x70);
+            snprintf(what, sizeof what, "season[%d] k%d pitch", idx, k);
+            hexlog(what, rd64(set + 0x68), 0x66);
+        }
+    }
+}
+
+// ---- the hook ----
+static struct { uint64_t step; uint32_t word_low; int n; uint64_t nodes[3]; } cache;
+
+static uint32_t node_reply(uint64_t node) { return readable(node + 0x18, 4) ? *(const uint32_t *)(uintptr_t)(node + 0x18) : 0; }
+
+static uint64_t warning_line(uint64_t self, uint64_t step) {
+    uint64_t rec = rd64(self + 0x20);
+    if (!readable(rec + 0x70, 0x10)) return 0;
+    uint8_t ns = *(const uint8_t *)(uintptr_t)(rec + 0x70);
+    uint64_t steps = rd64(rec + 0x78);
+    for (int i = 0; i + 1 < ns; i++) {
+        if (rd64(steps + 8ull * i) != step) continue;
+        uint64_t w = rd64(steps + 8ull * (i + 1));
+        uint64_t node = readable(w + 0x18, 8) && *(const uint8_t *)(uintptr_t)(w + 0x10) ? rd64(rd64(w + 0x18)) : 0;
+        return readable(node + 8, 1) && *(const uint8_t *)(uintptr_t)(node + 8) == 6 ? node : 0;
+    }
+    return 0;
+}
+
+static void filter(Cpu *c, uint64_t self, uint64_t *line) {
+    if (!readable(self + 0x2d8, 0x10)) return;
+    uint8_t n = *(const uint8_t *)(uintptr_t)(self + 0x2d8);
+    uint64_t arr = rd64(self + 0x2e0);
+    if (!n || !readable(arr, 8ull * n)) return;
+    uint64_t by_bit[NQ] = {0}, fallback = 0;
+    int ours = 0;
+    for (int i = 0; i < n; i++) {
+        uint64_t node = rd64(arr + 8ull * i);
+        uint32_t id = node_reply(node);
+        if (id >= REPLY_OFFER && id < REPLY_OFFER + NQ) by_bit[id - REPLY_OFFER] = node, ours++;
+        else if (id == REPLY_FALLBACK) fallback = node, ours++;
+    }
+    if (!ours) return;   // a shipped prompt, or one of our confirm steps
+    static int reload_on = -1;   // MLB_QUIRKMOD_RELOAD=1 (tests): re-read quirkmod.txt when it changed, drop the cache
+    if (reload_on < 0) {
+        const char *v = cfg_get("MLB_QUIRKMOD_RELOAD");
+        reload_on = v && *v && strcmp(v, "0");
+    }
+    if (reload_on && g_path[0] && file_hash(g_path) != g_cfg_hash) {
+        rt_log("quirkmod: %s changed; reloading", g_path);
+        if (!load_config(g_path)) return;
+        memset(&cache, 0, sizeof cache);
+    }
+    uint64_t step = rd64(self + 0x38);
+    uint32_t sid = (uint32_t)rd64(rd64(self + 0x20)) & 0xffffffff;
+    int moment = M_SPRING, hosted = 0;
+    for (int i = 0; i < C.nhost; i++) if (C.host_scene[i] == sid) moment = C.host_moment[i], hosted = 1;
+    Inputs in;
+    read_inputs(c, moment, &in);
+    if (!in.ok) { rt_log("quirkmod: scene %u: no RTTS player record; offer left as is", sid); return; }
+    uint64_t chosen[3];
+    int k = 0;
+    uint64_t use_line = 0;
+    if (cache.step == step && cache.word_low == (in.word & 0x7ffff) && cache.n) {   // "pick something else": same offer
+        k = cache.n;
+        memcpy(chosen, cache.nodes, sizeof chosen);   // the normal line this time: the warning shows once
+    } else {
+        Result r;
+        build_offer(&in, &r);
+        for (int i = 0; i < r.n && k < 3; i++) if (by_bit[r.bits[i]]) chosen[k++] = by_bit[r.bits[i]];
+        if (!k && fallback) chosen[k++] = fallback;
+        if (r.warning) use_line = warning_line(self, step);
+        // remember left-out pinned quirks, clear shown ones, keep the warned flag (record +0x28, saved with the career)
+        uint32_t spare = 0;
+        for (int b = 0; b < NQ; b++) if (C.carry_bit[b] >= 0) spare |= 1u << C.carry_bit[b];
+        spare |= 1u << (int)P("twoway_warned_bit", 27);
+        uint64_t handle = rt_call(c, FN_LOOKUP, 2, rd64(LOOKUP_PTR), (uint64_t)RTTS_PLAYER);
+        uint64_t rec = rd64(handle);
+        int forced_word = 0;
+        forced("owned_mask", &forced_word);
+        if (readable(rec + 0x28, 4) && !forced_word) {
+            uint32_t *w = (uint32_t *)(uintptr_t)(rec + 0x28);
+            *w = (*w & ~spare) | r.carry_after | r.warned_after;
+        }
+        char names[160] = "";
+        for (int i = 0; i < r.n; i++)
+            snprintf(names + strlen(names), sizeof names - strlen(names), "%s%s", i ? ", " : "", C.q[r.bits[i]].name);
+        rt_log("quirkmod: scene %u (%s%s) offer [%s]%s size %d focus %s | carry %#x%s", sid, moment_name[moment],
+               hosted ? "" : ", unknown host", names, r.n ? "" : " -> fallback", r.size, fam_name[r.focus],
+               r.carry_after, r.warning ? " | two-way warning" : "");
+        rt_log("quirkmod:   inputs role=%s twoway=%d type=%d word=%#x vel=%d,%d,%d,%d,%d,%d mov=%d,%d,%d,%d,%d,%d "
+               "ctl=%d,%d,%d,%d,%d,%d contact=%d power=%d speed=%d college=%d full=%d round=%d pick=%d season=%d",
+               in.role == ROLE_PITCHER ? "pitcher" : "hitter", in.twoway, in.pitcher_type, in.word, in.vel[0],
+               in.vel[1], in.vel[2], in.vel[3], in.vel[4], in.vel[5], in.mov[0], in.mov[1], in.mov[2], in.mov[3],
+               in.mov[4], in.mov[5], in.ctl[0], in.ctl[1], in.ctl[2], in.ctl[3], in.ctl[4], in.ctl[5], in.contact,
+               in.power, in.speed, in.college, in.offer_full, in.draft_round, in.draft_pick, in.season);
+        for (int i = 0; i < C.nstat; i++)
+            if (in.st[i] >= 0) rt_log("quirkmod:   stat %s=%.6g", C.stat[i].name, in.st[i]);
+        cache.step = step, cache.word_low = in.word & 0x7ffff, cache.n = k;
+        memcpy(cache.nodes, chosen, sizeof chosen);
+    }
+    uint64_t *list = (uint64_t *)(uintptr_t)arr;
+    for (int i = 0; i < k; i++) list[i] = chosen[i];
+    *(uint8_t *)(uintptr_t)(self + 0x2d8) = (uint8_t)k;
+    if (use_line) *line = use_line;
+    // Show what each offered quirk does in the line above the choice (so the player need not pick one just to read
+    // its detail): a copy of the line node whose text pointer (node +0x18, read by f_7001783860) is our own string:
+    // the scene's line, then one "Name: short text" per option, joined with the game's ^n^ line break.
+    static char text[512];
+    static uint8_t node_copy[0x80];
+    uint64_t base = *line;
+    const char *orig = readable(base + 0x18, 8) ? (const char *)(uintptr_t)rd64(base + 0x18) : NULL;
+    if (orig && readable((uint64_t)(uintptr_t)orig, 1) && readable(base, sizeof node_copy) && P("offer_details", 1) > 0) {
+        snprintf(text, sizeof text, "%s", orig);
+        int added = 0;
+        for (int i = 0; i < k; i++) {
+            uint32_t id = node_reply(chosen[i]);
+            if (id < REPLY_OFFER || id >= REPLY_OFFER + NQ || !C.q[id - REPLY_OFFER].text[0]) continue;
+            char one[192];
+            snprintf(one, sizeof one, "^n^%s: %s", C.q[id - REPLY_OFFER].name, C.q[id - REPLY_OFFER].text);
+            if (strlen(text) + strlen(one) > 255) {   // the line handler keeps 255 characters (256-byte buffer)
+                rt_log("quirkmod: offer line too long; left out the text for %s", C.q[id - REPLY_OFFER].name);
+                continue;
+            }
+            strcat(text, one);
+            added++;
+        }
+        if (added) {
+            memcpy(node_copy, (const void *)(uintptr_t)base, sizeof node_copy);
+            uint64_t tp = (uint64_t)(uintptr_t)text;
+            memcpy(node_copy + 0x18, &tp, 8);
+            *line = (uint64_t)(uintptr_t)node_copy;
+        }
+    }
+}
+
+// ---- new-season trigger: queue the college offer (first season at a school) or the spring offer (pro seasons) ----
+static uint64_t orig_season;
+static int32_t msg_buf[2];   // guest addresses are host addresses in the port: the game reads this directly
+
+static int season_count(void) {
+    uint64_t block = rd64(RTTS_BLOCK_PTR);
+    return block && readable(block + 0x50 + 25000, 4) ? *(const int32_t *)(uintptr_t)(block + 0x50 + 25000) : -1;
+}
+static uint32_t host_scene_for(int moment) {
+    for (int i = 0; i < C.nhost; i++) if (C.host_moment[i] == moment) return C.host_scene[i];
+    return 0;
+}
+static void queue_offer(Cpu *c, int moment, int count, int team) {
+    uint32_t sid = host_scene_for(moment);
+    if (!sid) return;
+    msg_buf[0] = (int32_t)sid, msg_buf[1] = 0;
+    rt_call(c, FN_ADD_MESSAGE, 1, (uint64_t)(uintptr_t)msg_buf);
+    // Inbox entries are 8 bytes at RTTS block +0x647cc (count byte +0x648cc): scene id, then a lifetime byte that
+    // f_70004666b0 counts down each progress tick (removed at 1). f_7000467400 can only set up to 10, which expires
+    // during the offseason sim (seen in game), so give ours a long one directly.
+    uint64_t block = rd64(RTTS_BLOCK_PTR);
+    int life = (int)P("message_lifetime", 250);
+    if (block && readable(block + 0x647cc, 0x101)) {
+        uint8_t n = *(const uint8_t *)(uintptr_t)(block + 0x648cc);
+        for (int i = 0; i < n && i < 0x20; i++)
+            if (*(const uint32_t *)(uintptr_t)(block + 0x647cc + 8ull * i) == sid)
+                *(uint8_t *)(uintptr_t)(block + 0x647cc + 8ull * i + 4) = (uint8_t)(life > 255 ? 255 : life);
+    }
+    rt_log("quirkmod: %s offer queued as inbox message %u (season count %d, team %#x)", moment_name[moment], sid,
+           count, team);
+}
+// College offer: once, the first time the player is on a college team (team id 0x87..0x99). The new-season event
+// does NOT fire on the way from high school into college (seen in game 2026-11-17), so this also runs at every
+// dialogue line (line_hook): the offer arrives at the first story moment after joining the school.
+static int college_check(Cpu *c, int count) {
+    uint64_t handle = rt_call(c, FN_LOOKUP, 2, rd64(LOOKUP_PTR), (uint64_t)RTTS_PLAYER);
+    uint64_t rec = rd64(handle);
+    if (!readable(rec + 0x70, 4)) return 0;
+    int team = (int)((*(const int32_t *)(uintptr_t)(rec + 0x70) << 23) >> 23);   // as f_7000400428 reads it
+    if (team < 0x87 || team >= 0x87 + 19) return 0;
+    uint32_t *word = (uint32_t *)(uintptr_t)(rec + 0x28);
+    uint32_t given = 1u << (int)P("college_given_bit", 28);
+    if (*word & given) return 0;
+    *word |= given;
+    queue_offer(c, M_COLLEGE, count, team);
+    return 1;
+}
+
+static void season_hook(Cpu *c) {
+    uint64_t a0 = c->x[0], a1 = c->x[1], a2 = c->x[2], a3 = c->x[3];
+    int before = season_count();
+    c->x[0] = rt_call(c, orig_season, 4, a0, a1, a2, a3);
+    uint64_t ret = c->x[0];
+    int after = season_count();
+    if (after < 0 || after == before) return;
+    uint64_t handle = rt_call(c, FN_LOOKUP, 2, rd64(LOOKUP_PTR), (uint64_t)RTTS_PLAYER);
+    uint64_t rec = rd64(handle);
+    if (!readable(rec + 0x70, 4)) { c->x[0] = ret; return; }
+    int team = (int)((*(const int32_t *)(uintptr_t)(rec + 0x70) << 23) >> 23);   // as f_7000400428 reads it
+    uint32_t *word = (uint32_t *)(uintptr_t)(rec + 0x28);
+    uint32_t given = 1u << (int)P("college_given_bit", 28);
+    if (team >= 0x83 && team < 0x87) {
+        rt_log("quirkmod: new season (count %d): still in high school, no offer", after);
+    } else if (team >= 0x87 && team < 0x87 + 19) {
+        if (!college_check(c, after) && (*word & given) && P("spring_in_college", 0) > 0)
+            queue_offer(c, M_SPRING, after, team);
+    } else {
+        queue_offer(c, M_SPRING, after, team);
+    }
+    c->x[0] = ret;
+}
+
+static int probe_on = -1;
+
+static void line_hook(Cpu *c) {
+    uint64_t self = c->x[0], line = c->x[1], a2 = c->x[2], a3 = c->x[3];
+    if (probe_on < 0) {
+        const char *v = cfg_get("MLB_QUIRKMOD_PROBE");
+        probe_on = v && *v && strcmp(v, "0");
+    }
+    if (probe_on) probe(c, self);
+    if (C.loaded && host_scene_for(M_COLLEGE)) college_check(c, season_count());
+    static int test_queue = -1;   // MLB_QUIRKMOD_TEST_QUEUE=spring|college (tests): queue that offer at the first line
+    if (test_queue < 0) {
+        const char *v = cfg_get("MLB_QUIRKMOD_TEST_QUEUE");
+        test_queue = !v || !*v ? 0 : !strcmp(v, "college") ? 1 + M_COLLEGE : 1 + M_SPRING;
+    }
+    if (test_queue > 0) {
+        int m = test_queue - 1;
+        test_queue = 0;
+        queue_offer(c, m, season_count(), -1);
+    }
+    filter(c, self, &line);
+    c->x[0] = rt_call(c, orig_line, 4, self, line, a2, a3);
+}
+
+// Writes n bytes at a guest address, opening read-only pages for it (as pitchmod.c does).
+static int poke(uint64_t addr, const void *src, uint64_t n) {
+    uint64_t page = addr & ~0xfffull, end = (addr + n + 0xfff) & ~0xfffull, stop = 0;
+    int prot = plat_mem_state(page, end, &stop);
+    if (prot < PLAT_PROT_READ || stop < end) return 0;
+    if (prot != PLAT_PROT_RW && !plat_mem_protect(page, end - page, PLAT_PROT_RW)) return 0;
+    memcpy((void *)(uintptr_t)addr, src, n);
+    if (prot != PLAT_PROT_RW) plat_mem_protect(page, end - page, prot);
+    return 1;
+}
+
+// boot.c: after the game image is loaded, before hostfn_seal.
+void quirkmod_apply(void) {
+    char buf[PLAT_PATH_MAX];
+    const char *path = config_path(buf, sizeof buf);
+    if (!path || !load_config(path)) return;
+    if (strcmp(rt_game_build, "1.0.20")) {
+        rt_log("quirkmod: game %s is not 1.0.20; offers are not filtered", rt_game_build);
+        return;
+    }
+    uint64_t cur = rd64(SLOT_LINE);
+    if (cur != ORIG_LINE) {
+        rt_log("quirkmod: FE scene line slot holds %#llx, not the shipped %#llx; offers are not filtered",
+               (unsigned long long)cur, (unsigned long long)ORIG_LINE);
+        return;
+    }
+    orig_line = cur;
+    uint64_t hook = hostfn_register("<quirkmod offer filter>", line_hook);
+    if (!poke(SLOT_LINE, &hook, 8)) {
+        rt_log("quirkmod: cannot write the FE scene line slot; offers are not filtered");
+        return;
+    }
+    rt_log("quirkmod: offer filter installed (FE scene slot %#llx -> %#llx)", (unsigned long long)SLOT_LINE,
+           (unsigned long long)hook);
+    // the new-season trigger only matters when the config names college / spring offer scenes
+    if (!host_scene_for(M_COLLEGE) && !host_scene_for(M_SPRING)) return;
+    uint64_t cur_season = rd64(SLOT_SEASON);
+    if (cur_season != ORIG_SEASON) {
+        rt_log("quirkmod: season handler slot holds %#llx, not %#llx; no college/spring offers",
+               (unsigned long long)cur_season, (unsigned long long)ORIG_SEASON);
+        return;
+    }
+    orig_season = cur_season;
+    uint64_t sh = hostfn_register("<quirkmod new season>", season_hook);
+    if (!poke(SLOT_SEASON, &sh, 8)) {
+        rt_log("quirkmod: cannot write the season handler slot; no college/spring offers");
+        return;
+    }
+    rt_log("quirkmod: new-season trigger installed (slot %#llx -> %#llx)", (unsigned long long)SLOT_SEASON,
+           (unsigned long long)sh);
+}
diff --git a/runtime/mlb/rtts_autosave.c b/runtime/mlb/rtts_autosave.c
index 32a2270..bb3b382 100644
--- a/runtime/mlb/rtts_autosave.c
+++ b/runtime/mlb/rtts_autosave.c
@@ -3,6 +3,16 @@
 // but not after hub purchases: a perk or attribute upgrade bought in the hub was lost when the player quit before
