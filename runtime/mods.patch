+// mlbts-native: Pitching++ pitcher shapes. Each pitcher's pitches move like his own.
+//
+// MLB_PITCHER_SHAPES=1     the patch set pitcher_shapes (mods/pitch-types/patches.txt, tools/make_patches.py --shapes)
+// MLB_PITCHER_SHAPES_LOG=1 one log line per new pitcher on the mound: where his shapes came from, his 4-seam's
+//
+// The game has one movement per pitch type: every pitcher's 4-seamer moves the same way and as far. (Its ratings
+// size curves, sliders, sweepers, changeups and splitters, and tilt sinkers, cutters, changeups and splitters by up to
+// 15 deg.) This mod turns each pitch toward the pitcher's own movement direction and scales it to his own size (every
+// type but the knuckleball). The movement rating counts as a percentile: each type has a direction the roster's
+// ratings track in real movement (4-seams run and ride, sinkers sink, cutters cut and ride, sliders, sweepers and
+// curves sweep and drop, changeups and splitters fade and drop) and one rating SD among MLB pitchers (about 15) moves
+// the pitch one SD of real movement along it (shape_types r_mean, r_sd, q_hb, q_ivb; make_shapes_table.py
+// rating_scales). The ratings themselves are not touched. The game's own rating curve, which only sized the rated
+// types by 0.87-1.28, is taken out of them: the size site divides the spin by his movement-rating x speed factor q
+// (pitch +0xcc x +0xd0) and puts back the calibration lab's k, as A / q (rated directly) or B / (2 - q) (rated
+// inversely, changeups and splitters), with A = k or B = 2 - k, or, where his rating is known, C = k / q_r or
+// (2 - k) / (2 - q_r), q_r = the factor his rating gives at his 2026 speed (or the lab's), which keeps a perk's or
+// equipment's bonus and a speed change. C = comp keeps the game's rating otherwise. comp (shape_types; in k too) puts
+// the mean of the per-pitch factors back to the slider's for sweepers x1.115, curves and slow curves x1.11, 12-6
+// x1.16 (their CPU means of 0.82 / 0.82 / 0.72 against 0.91 left them about 10 % small), sliders x0.84 (1.18 x from
+// the hand in game; make_shapes_table.py COMP). The per-pitch parts (CPU randomness, fatigue, location, confidence)
+// stay. Sources, in order:
+//   1. his 2026 Statcast movement for that pitch (2025 with too few; shapes_table.h; Gausman's 4-seam runs 11 in,
+//      Ohtani's 5), at his 2026 rating: a rating that moves from there (a franchise's or manager mode's progression)
+//      moves it by z(now) - z(2026);
+//   2. else the type's average shape, turned by what his arm slot predicts (a lower slot turns every pitch toward the
+//      arm side, per degree of arm angle 0.75 deg on 4-seamers, 1.07 on sinkers, 1.31 on changeups, 1.21 on curves;
+//      statcast/arm_slopes.py; his own arm angle or his delivery's for created and Road to the Show players) and moved
+//      by z(his rating now).
+// The code is the patch set: three loads in the pitch setup (f_7000247214 f2 axis and f6 break direction, before the
+// left-hander mirror; f_700024b7f8 f6 again) add the float at patch page +0x400 + 4 x type (deg), and the spin vector
+// (f_700024ab18, axis x pitch +0x10c) is multiplied by size x (A / q + B / (2 - q) + C), each a float at +0x480 /
+// +0x580 / +0x600 / +0x680 + 4 x type (q clamped to 0.5..1.5 there). The game's Magnus force is linear in the spin
+// vector, so that is the movement's size. The break display (the chevrons or the pre-trail while aiming, drawn from
+// f_70002e9668's direction pitch +0xc4 and size f7 x the factor product) shows each pitch's spin break, and the user's
+// own pitches land where it ends (the user, 2026-11-21: "it should land roughly where the chevrons say (same for all
+// pitches ... on a perfect release)", chevrons = "each pitch's real spin break", the CPU's pitches unchanged): the
+// direction site takes +0x780 + 4 x type (mirrored there for a left-hander) in place of the preview's own direction
+// (whose random turn would tilt the chevrons), the size site takes +0x800 + 4 x type, and a site after the pitch's aim
+// is set (0x7000246ff0) adds +0x850 / +0x8a0 + 4 x type to its crossing aim (x, height; ft) in place of the game's own
+// break offset, for the user's pitches only (the site tells them apart the way the game's aim step does), which the
+// path solve then hits. The landing words carry a random part, drawn afresh every tick, so each of the user's pitches
+// lands off the chevrons' end by as much as a real pitch's movement varies from pitch to pitch (the user: "We want it
+// to be realistically random"; per type, measured in 2026 Statcast, statcast/movement_scatter.py). put_break() writes
+// the break, put_spread() the landing. This file only keeps those floats right for the pitcher on the mound; nothing here
+// touches a pitch or its flight.
+// Flight length: break grows with the square of the flight, and the game lets go where its delivery animation puts the
+// hand, 52.9-55.9 ft from the plate, while a real pitcher's flight is 59.08 ft - his extension: from the hand his break
+// came out 5-12 % too big. The set's site in the flight step (f_7001658448, which the path solve at release runs too,
+// so the aim still lands on the target) multiplies a pitch's Magnus force by N / d^2, d = that pitch's own flight, N
+// from here: exact from the first pitch.
+//
+// The pitcher on the mound, user-controlled or CPU: mound.c (his player object: id, delivery style, height, hand and
+// live attributes).
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "cfg.h"
+#include "host.h"
+#include "mound.h"
+#include "platform/platform.h"
+#include "shapes_table.h"   // shape_types, shape_table (mods/pitch-types/tools/make_shapes_table.py)
+#include "location_table.h"  // loc_table, loc_group_of_type (mods/pitch-types/tools/make_location_table.py)
+#include "usage_table.h"    // usage_cf, usage_table, usage_counts (mods/pitch-types/tools/make_usage_table.py)
+
+// Pitch usage (the set pitch_usage): the CPU's pitch choice (f_70000cd760) weighs its 5 arsenal slots by a usage the
+// arsenal build sets by slot position, then multiplies each by its category's count table. The site there
+// (0x70000cd874) replaces each slot's weight by the float at patch page +0x900 + 32 x block + 4 x slot when the flag at
+// +0x914 + 32 x block is 1, block = 12 x side + 3 x balls + strikes (side = the batter's byte *(context + 0x40) + 0x10:
+// 0 a right-handed batter, 1 a left-handed one). This file writes the pitcher on the mound's 24 blocks: his share of
+// each slot at that side and count (his 2026 season, or the roster's usage with the league's platoon and count
+// factors) over the live count table the game multiplies by next; or flag 0 (the game's weights) for a pitcher the
+// table does not have.
+#define USAGE_OFF 0x900
+#define COUNT_TABLES 0x7001d75a58ull   // the game's count tables: fastball, curve, slider, change; 12 floats each
+#define COUNT_BYTES (4 * 12 * 4)
+
+#define FLIGHT_N_OFF 0xc00       // (59.08 - the delivery's real extension)^2: the flight site's N
+#define PLATE_FRONT 59.08f       // ft from the rubber to the front of the plate
+#define GAME_FLIGHT_AVG 54.6f    // the game's mean flight over 13 deliveries
+float extension_style_ft(int style);    // extension.c: the delivery's real release extension
+float extension_flight_ft(int style);   // extension.c: the delivery's last measured flight, 0 before its first pitch
+
+#define TURN_OFF 0x400       // 19 floats, deg: the direction sites read +0x400 + 4 x type
+#define SIZE_OFF 0x480       // 19 floats, x: the spin vector site reads +0x480 + 4 x type
+#define A_OFF 0x580          // 19 floats each: the rating terms A, B, C at the spin vector site
+#define B_OFF 0x600
+#define C_OFF 0x680
+#define DISP_DIR_OFF 0x780   // 19 floats, deg: the break display's direction (0 down, + glove side; the site mirrors)
+#define DISP_SIZE_OFF 0x800  // 19 floats: the break display's size (the spin break in feet / DRAW_FT)
+#define AIM_X_OFF 0x850      // 19 floats, ft: the spin break, where the user's pitches land from the aim (x + to 1B)
+#define AIM_Y_OFF 0x8a0      // 19 floats, ft: and up
+#define REF_SHARE 0.75f      // the share of his fastball's spin break taken off every type's (its own shows the rest)
+#define REL_X_OFF 0xf00      // 19 floats, ft: the user's landing, its fixed part (minus his fastball's spin break, random part)
+#define REL_Y_OFF 0xf50      // 19 floats, ft: and up
+#define INV_MEAN_OFF 0xfa0   // 19 floats: 1 / the type's typical movement product (+0xe4), so product x this = 1 typically
+#define SPOT_X_OFF 0xe20     // 19 floats, ft: the CPU's next pitch of each type crosses here (x + toward first base)
+#define SPOT_Y_OFF 0xe70     // 19 floats, ft: and this high
+#define SPOT_OK_OFF 0xec0    // float: 1 while the spots stand for the batter and count now, 0 (the site's own aim) else
+#define ZONE_HALF_W 0.829f   // the zone as statcast/attack_zones.py measures the game: half-width with the ball's radius,
+#define ZONE_MID 2.3551f     // middle and half-height (location_check.py's game zone + the ball's radius)
+#define ZONE_HALF_H 1.0835f
+#define DRAW_FT 1.10f        // the chevrons of size s reach about 1.10 x s ft: Glasnow's five pitches (1280 x 720, the
+                             // zone box 61 px = 17 in) drew 13.0-13.6 in a unit at sizes 1.36-1.64, his slider 11.6 at
+                             // 0.43 (2026-11-21)
+#define TYPES 20
+// Index 19 of every per-type array is the airbender, game type 20 (the set airbender, mods/pitch-types/tools/
+// make_airbender.py: Pitching++'s page sites read index 19 for type 20; type 19 is PitchCom's pitchout, never a pitch).
+#define AIRBENDER 20
+static int game_type(int t) { return t == TYPES - 1 ? AIRBENDER : t; }
+static int type_index(int ty) { return ty >= 0 && ty < 19 ? ty : ty == AIRBENDER ? TYPES - 1 : -1; }
+#define MAX_TURN_ARM 40.0f   // arm-slot prediction: beyond the data (arm angle SD 11 deg) it is not linear
+// own movement: his real direction, however far from the type's (a season's mean of >= 30 pitches; 60 deg held
+// Gilbert's and Sanchez's sliders, which break down and to the glove side, 40-50 deg off)
+#define MAX_TURN_REAL 180.0f
+#define MIN_SIZE 0.35f       // gyro sliders move a fifth of the slider mean; keep some break
+#define MAX_SIZE 1.8f        // x the type's movement, or MAX_BREAK_IN if that is more: 1.8 x held the sliders of
+#define MAX_BREAK_IN 26.0f   // Brash (14.6 in, 3.1 x) and Sale at 1.8 x; the biggest real breaks are about 22 in
+#define MF60 0.9865f         // the game's movement factor at rating 60, the calibration lab's (k = MF60 x its speed factor,
+                             // x comp for a type rated directly)
+
+static int log_on;
+
+// The pitcher on the mound (mound.c), set when a new one is: his height (in; 0 unknown), attribute block (PLR_ATT
+// layout: pitch types at +0x48 + slot; 0 unknown) and throwing hand (PLAYERS.BIN's SIGNED_PACK bit 30: 3,335 of 3,335
+// roster records matched; -1 unknown).
+static int height_in;
+static uint64_t attr_now;
+static int hand_left = -1;
+
+// The game's flight for this delivery and height before its first pitch: FLIGHT_C - its extension (windup and stretch
+// averaged) x height / 75 in (shapes_table.h delivery_ext); 0 if not decoded or no height.
+static float decoded_flight(int style) {
+    if (style < 0 || height_in < 60 || height_in > 90) return 0.0f;
+    int lo = 0, hi = (int)(sizeof delivery_ext / sizeof delivery_ext[0]) - 1;
+    while (lo <= hi) {
+        int mid = (lo + hi) / 2;
+        if (delivery_ext[mid].style == style)
+            return FLIGHT_C - (delivery_ext[mid].ext_w + delivery_ext[mid].ext_s) / 200.0f * (height_in / 75.0f);
+        if (delivery_ext[mid].style < style) lo = mid + 1; else hi = mid - 1;
+    }
+    return 0.0f;
+}
+
+static int table_index(int id) {
+    int lo = 0, hi = (int)(sizeof shape_table / sizeof shape_table[0]) - 1;
+    while (id > 0 && lo <= hi) {
+        int mid = (lo + hi) / 2;
+        if (shape_table[mid].id == id) return mid;
+        if (shape_table[mid].id < id) lo = mid + 1; else hi = mid - 1;
+    }
+    return -1;
+}
+
+static float clampf(float v, float lo, float hi) { return v < lo ? lo : v > hi ? hi : v; }
+
+// Movement direction as a spin-axis angle in the arm-side frame (180 = up, 270 = arm side, 0 = down): the game's f2.
+static float direction(float hb, float ivb) { return 180.0f + atan2f(hb, ivb) * 57.2957795f; }
+
+static float wrap180(float d) {
+    while (d > 180.0f) d -= 360.0f;
+    while (d < -180.0f) d += 360.0f;
+    return d;
+}
+
+// The 5 x 19 floats for one pitcher (p: turn, size, a, b, c): own = his own table entry (movement and arm angle),
+// slot = his delivery's entry (arm angle only), either -1. Returns how many types took his own movement.
+typedef struct { float turn[TYPES], size[TYPES], a[TYPES], b[TYPES], c[TYPES], mh[TYPES], mv[TYPES]; } Shapes;   // mh / mv: the
+// spin break this gives each type (HB arm side +, IVB; in), for the break display and the user's landing
+
+static int classes_set = -1;   // the set pitch_classes (classes.c): its retyped slots take their own real pitch
+
+// The Statcast column a retyped slot of game type t takes for this pitcher (shape_over), or -1.
+static int over_sc(uint32_t id, int t) {
+    if (classes_set < 0 || !rt_patch_enabled(classes_set)) return -1;
+    for (int i = 0; i < (int)(sizeof shape_over / sizeof shape_over[0]); i++)
+        if (shape_over[i].id == id && shape_over[i].type == game_type(t)) return shape_over[i].sc;
+    return -1;
+}
+
+// His 2026 movement rating and speed factor for type t (shape_r, from the roster file and, with pitch_classes on, his
+// real arsenal): 1, or 0 (that type was not in his 2026 arsenal).
+static int r_base(uint32_t id, int t, int *rating, float *sf) {
+    int real = classes_set >= 0 && rt_patch_enabled(classes_set), has_real = 0, found[2] = {0, 0}, r[2] = {0, 0};
+    float s[2] = {1.0f, 1.0f};
+    int lo = 0, hi = (int)(sizeof shape_r / sizeof shape_r[0]) - 1, at = -1;
+    while (id && lo <= hi) {   // sorted by id: find one of his rows, then walk them
+        int mid = (lo + hi) / 2;
+        if (shape_r[mid].id == id) { at = mid; break; }
+        if (shape_r[mid].id < id) lo = mid + 1; else hi = mid - 1;
+    }
+    if (at < 0) return 0;
+    while (at > 0 && shape_r[at - 1].id == id) at--;
+    for (; at < (int)(sizeof shape_r / sizeof shape_r[0]) && shape_r[at].id == id; at++) {
+        int j = shape_r[at].real ? 1 : 0;
+        if (j) has_real = 1;
+        if (shape_r[at].type == game_type(t)) found[j] = 1, r[j] = shape_r[at].rating, s[j] = shape_r[at].sf1000 / 1000.0f;
+    }
+    int j = real && has_real ? 1 : 0;
+    *rating = r[j], *sf = s[j];
+    return found[j];
+}
+
+// His movement rating now for type t: the first arsenal slot of that type (the roster in memory: a franchise's or
+// manager mode's progression, a created player's), or -1.
+static int live_rating(int t) {
+    if (!attr_now || !mem_guest_readable(attr_now + 0x3c, 0x11)) return -1;
+    const uint8_t *a = (const uint8_t *)(uintptr_t)attr_now;
+    for (int k = 0; k < 5; k++)
+        if (a[0x48 + k] == game_type(t)) return a[0x3c + k];
+    return -1;
+}
+
+// The game's movement factor for a rating (f_700024b0d0, pitch +0xcc before a perk's or equipment's bonus):
+// 0 / 25 / 99 -> 0.583 / 0.75 / 1.25, x up to 1.2 above 99.
+static float move_factor(int rating) {
+    float x = rating / 100.0f, f = x <= 0.25f ? 0.583f + 0.167f * x / 0.25f : 0.75f + 0.5f * (fminf(x, 0.99f) - 0.25f) / 0.74f;
+    return x > 0.99f ? f * (1.0f + 0.2f * fminf(1.0f, (x - 0.99f) / 0.25f)) : f;
+}
+
+// A rating's place among MLB pitchers' ratings of type t, in SDs (clamped), or 0 (no scale for that type).
+static float rating_z(int t, int rating) {
+    if (shape_types[t].r_sd <= 0.0f) return 0.0f;
+    return clampf((rating - shape_types[t].r_mean) / shape_types[t].r_sd, -SHAPE_Z_MAX, SHAPE_Z_MAX);
+}
+
+// A type's comp as a factor on its rating term. Rated directly, comp is inside k already (k / q scales with it); rated
+// inversely, the spin goes with 2 - k, so comp multiplies the term itself and k stays the lab's (make_shapes_table.py).
+static float inv_comp(int t) { return shape_types[t].rating == 2 ? shape_types[t].comp : 1.0f; }
+
+// The calibration lab's speed factor for type t (k = MF60 x it, x comp for a type rated directly).
+static float lab_sf(int t) { return shape_types[t].k / ((shape_types[t].rating == 2 ? 1.0f : shape_types[t].comp) * MF60); }
+
+// The rating terms that take the game's own rating curve out of a rated type and keep the rest of its movement factor
+// (a perk's or equipment's bonus, the speed factor relative to sf_base): C = k / q (rated directly) or
+// comp x (2 - k) / (2 - q) (inversely), q = the factor his rating now gives at sf_base.
+static float rating_c(int t, int rating, float sf_base) {
+    float k = shape_types[t].k, q = move_factor(rating) * sf_base;
+    return shape_types[t].rating == 1 ? k / q : inv_comp(t) * (2.0f - k) / (2.0f - q);
+}
+
+// Turn and size for a movement (HB arm side +, IVB) against type t's.
+static void set_shape(Shapes *p, int t, float hb, float ivb) {
+    const float thb = shape_types[t].hb, tivb = shape_types[t].ivb, len = sqrtf(thb * thb + tivb * tivb);
+    p->turn[t] = clampf(wrap180(direction(hb, ivb) - direction(thb, tivb)), -MAX_TURN_REAL, MAX_TURN_REAL);
+    if (shape_types[t].sized)
+        p->size[t] = clampf(sqrtf(hb * hb + ivb * ivb) / len, MIN_SIZE, fmaxf(MAX_SIZE, MAX_BREAK_IN / len));
+}
+
+static int fill(Shapes *p, int own, int slot, uint32_t id) {
+    int real = 0;
+    float arm = 0.0f;
+    int have_arm = 0;
+    if (own >= 0 && shape_table[own].arm != SHAPE_NONE) arm = shape_table[own].arm / 10.0f, have_arm = 1;
+    // no arm angle of his own: his delivery's as the game plays it (the decoded animation), else its owner's
+    else if (slot >= 0 && shape_table[slot].anim != SHAPE_NONE) arm = shape_table[slot].anim / 10.0f, have_arm = 1;
+    else if (slot >= 0 && shape_table[slot].arm != SHAPE_NONE) arm = shape_table[slot].arm / 10.0f, have_arm = 1;
+    for (int t = 0; t < TYPES; t++) {
+        const float thb = shape_types[t].hb, tivb = shape_types[t].ivb;
+        const float qh = shape_types[t].q_hb, qi = shape_types[t].q_ivb;   // movement per rating SD
+        const int rated = shape_types[t].sized ? shape_types[t].rating : 0;
+        const int now = shape_types[t].sized ? live_rating(t) : -1;   // his movement rating today, -1 none
+        p->turn[t] = 0.0f;
+        p->size[t] = 1.0f;
+        p->a[t] = p->b[t] = 0.0f;
+        p->c[t] = shape_types[t].comp;   // the game's rating, its per-pitch factors' mean put back to the slider's
+        p->mh[t] = thb, p->mv[t] = tivb;
+        int done = 0, over = own >= 0 ? over_sc(id, t) : -1;
+        for (int k = over >= 0 ? -1 : 0; own >= 0 && k < 3 && !done; k++) {
+            int s = k < 0 ? over : shape_types[t].take[k];
+            if (s < 0 || shape_table[own].mv[s][0] == SHAPE_NONE) continue;
+            float hb = shape_table[own].mv[s][0] / 10.0f, ivb = shape_table[own].mv[s][1] / 10.0f, sf0 = 1.0f;
+            int r0 = 0, based = shape_types[t].sized && r_base(id, t, &r0, &sf0);
+            if (based && now >= 0) {
+                // his real movement is at his 2026 rating; a rating that has moved since (progression in a franchise
+                // or manager mode) moves the pitch along the type's rating direction, by the real spread per SD
+                float dz = rating_z(t, now) - rating_z(t, r0);
+                hb += dz * qh, ivb += dz * qi;
+            }
+            set_shape(p, t, hb, ivb);
+            p->mh[t] = hb, p->mv[t] = ivb;
+            if (rated && based && now >= 0) {
+                // the game's own rating curve out (the rating is in the size now), a bonus to the movement factor
+                // and a speed change relative to 2026 kept
+                p->c[t] = rating_c(t, now, sf0);
+            } else if (rated) {
+                // no rating to read or no 2026 one for this type: his own size replaces the rating's, the lab's rating
+                // x speed factor k instead of his
+                if (rated == 1) p->a[t] = shape_types[t].k, p->c[t] = 0.0f;
+                if (rated == 2) p->b[t] = inv_comp(t) * (2.0f - shape_types[t].k), p->c[t] = 0.0f;
+            }
+            done = 1;
+            real++;
+        }
+        if (done) continue;
+        float turn = 0.0f;
+        if (have_arm && shape_types[t].arm_slope != 0.0f)
+            turn = clampf(shape_types[t].arm_slope * (arm - shape_types[t].arm_mean), -MAX_TURN_ARM, MAX_TURN_ARM);
+        p->turn[t] = turn;
+        float len = sqrtf(thb * thb + tivb * tivb), a = atan2f(thb, tivb) + turn / 57.2957795f;
+        p->mh[t] = len * sinf(a), p->mv[t] = len * cosf(a);
+        if (now >= 0 && (qh != 0.0f || qi != 0.0f)) {
+            // no data of his own (created and Road to the Show players, minor leaguers, legends): the type's shape,
+            // turned to his arm slot, moved along the type's rating direction by where his rating sits among MLB
+            // pitchers' (z SDs of real movement); the game's own rating curve out of the rated types
+            float z = rating_z(t, now);
+            set_shape(p, t, p->mh[t] + z * qh, p->mv[t] + z * qi);
+            p->mh[t] += z * qh, p->mv[t] += z * qi;
+            if (rated) p->c[t] = rating_c(t, now, lab_sf(t));
+        }
+    }
+    return real;
+}
+
+// How much a real pitch's movement varies from one pitch to the next, by game type: SD arm side and up (in) and their
+// correlation, within one pitcher's type in one game (2026 regular season, about 640,000 pitches; Hawk-Eye's own noise
+// included; statcast/movement_scatter.py). Not tied to control: a pitcher's spread against his walk rate correlates
+// +0.08 (the third with the most walks spreads 2.5 % more than the third with the fewest). Types without 2026 data take
+// the nearest measured one; the knuckleball (none in 2026) a wide 4 in, a guess.
+static const struct { float arm, up, rho; } spread[TYPES] = {
+    {1.80f, 1.44f, -0.13f},   // 4S <- FF
+    {1.66f, 1.84f, -0.21f},   // SNK <- SI
+    {1.98f, 1.97f, -0.02f},   // CB <- CU
+    {1.82f, 2.08f, +0.21f},   // SL <- SL
+    {2.47f, 2.67f, +0.12f},   // SLV <- SV
+    {2.46f, 2.69f, +0.02f},   // SPL <- FS
+    {1.86f, 2.35f, -0.13f},   // CH <- CH
+    {4.00f, 4.00f, +0.00f},   // KN: no 2026 knuckleballer
+    {1.66f, 1.84f, -0.21f},   // 2S <- SI
+    {1.90f, 1.94f, +0.26f},   // CUT <- FC
+    {1.86f, 2.35f, -0.13f},   // CIR <- CH
+    {1.86f, 2.35f, -0.13f},   // PALM <- CH
+    {2.46f, 2.69f, +0.02f},   // FORK <- FS (FO: 409 pitches)
+    {2.08f, 1.88f, +0.03f},   // KNCV <- KC
+    {1.86f, 2.35f, -0.13f},   // SCR <- CH
+    {1.98f, 1.97f, -0.02f},   // 12-6 <- CU
+    {1.98f, 1.97f, -0.02f},   // SCV <- CU
+    {2.67f, 2.50f, +0.12f},   // SWP <- ST
+    {2.46f, 2.69f, +0.02f},   // VCH <- FS
+    {1.86f, 2.35f, -0.13f},   // ABND (game type 20) <- CH
+};
+
+// The break the user sees and his pitch lands by, against his own fastball (the user, 2026-11-22, after the spin break:
+// "it should represent how the pitch actually appears to move", picked "vs his 4-seamer"; and "the chevrons adapt
+// based on where you're aiming", the game's location factor): for type t, its spin break (spin_x / spin_y, ft, x +
+// toward first base) scaled by the pitch's movement product over the type's typical one (pitch +0xe4: the location,
+// confidence, energy and fatigue factors that also scale its real spin), plus a fixed part: minus his fastball's spin
+// break (rel_x / rel_y; a gravity term was tried and dropped: the user found it too big to aim with). His fastball (the 4-seam, else his
+// fastest pitch) so lands at the aim, the rest by how much more they move than it.
+static float spin_x[TYPES], spin_y[TYPES], rel_x[TYPES], rel_y[TYPES];
+static int land_left;                        // that pitcher throws left-handed (arm side = first base)
+static int ref_type;                         // his fastball the breaks are measured from
+// The typical product per type over 3,529 CPU pitches of the calibration games (the movement table was fitted at
+// these; the 4-seam always sits at the game's floor 0.25); types without CPU pitches take the nearest family's.
+static const float mean_product[TYPES] = {0.250f, 0.951f, 0.819f, 0.939f, 0.907f, 1.202f, 1.035f, 1.000f, 0.837f,
+                                          0.956f, 1.079f, 1.050f, 1.055f, 0.872f, 1.050f, 0.823f, 0.843f, 0.869f, 1.202f,
+                                          1.050f};   // the airbender: the screwball's (its spin rule and row)
+static uint64_t rng = 0x9e3779b97f4a7c15ull;
+
+static double uniform01(void) {              // xorshift64*, (0, 1)
+    rng ^= rng >> 12, rng ^= rng << 25, rng ^= rng >> 27;
+    return ((rng * 0x2545f4914f6cdd1dull >> 11) + 0.5) / 9007199254740992.0;
+}
+
+static void gauss2(float *z1, float *z2) {   // two independent standard normals, each held to +-3 SD
+    double r = sqrt(-2.0 * log(uniform01())), a = 6.283185307179586 * uniform01();
+    double u = r * cos(a), v = r * sin(a);
+    *z1 = (float)(u > 3.0 ? 3.0 : u < -3.0 ? -3.0 : u);
+    *z2 = (float)(v > 3.0 ? 3.0 : v < -3.0 ? -3.0 : v);
+}
+
+// The landing's fixed part plus a fresh random part with that type's real spread (arm side turned to x by the hand).
+// Called every tick, so the pitch the user throws next takes whatever draw is on the page when it is aimed.
+static void put_spread(char *page) {
+    float x[TYPES], y[TYPES];
+    for (int t = 0; t < TYPES; t++) {
+        float z1, z2;
+        gauss2(&z1, &z2);
+        float arm = spread[t].arm * z1, up = spread[t].up * (spread[t].rho * z1 + sqrtf(1.0f - spread[t].rho * spread[t].rho) * z2);
+        x[t] = rel_x[t] + (land_left ? arm : -arm) / 12.0f;
+        y[t] = rel_y[t] + up / 12.0f;
+    }
+    memcpy(page + REL_X_OFF, x, sizeof x);
+    memcpy(page + REL_Y_OFF, y, sizeof y);
+}
+
+// The CPU's spots (the user, 2026-11-22: "Ideally I'd like all 39 zones used accurately for each pitch"): for the
+// batter at the plate (his side against the pitcher's hand) and the count now, each type's next pitch crosses where a
+// real 2026 pitch of its group crossed in that count against that side (location_table.h: 128 of them, drawn afresh
+// every tick), mirrored to the batter's inside and set on the game's zone. The aim site moves the CPU's aim there
+// (keeping its break offset, and leaving pitches the game aims far off, intentional balls and pitchouts, alone).
+static int spot_count = -1;
+static void put_spots(char *page) {
+    MoundBatter b;
+    int balls, strikes;
+    float ok = 0.0f;
+    if (hand_left >= 0 && mound_batter(hand_left == 1, &b) && mound_count(&balls, &strikes)) {
+        float x[TYPES], y[TYPES];
+        int side = (b.side == 'L') == (hand_left == 1) ? 0 : 1, c = 3 * balls + strikes;
+        for (int t = 0; t < TYPES; t++) {
+            const int g = t == TYPES - 1 ? loc_group_of_type[6] : loc_group_of_type[t];   // the airbender: changeups'
+            const int8_t *v = loc_table[g][side][c][(int)(uniform01() * LOC_N) % LOC_N];
+            float xin = v[0] / LOC_Q, z = v[1] / LOC_Q;
+            x[t] = (b.side == 'R' ? xin : -xin) * ZONE_HALF_W;   // catcher's view: a right-handed batter's inside is - x
+            y[t] = ZONE_MID + z * ZONE_HALF_H;
+        }
+        memcpy(page + SPOT_X_OFF, x, sizeof x);
+        memcpy(page + SPOT_Y_OFF, y, sizeof y);
+        ok = 1.0f;
+        if (log_on && c != spot_count)
+            rt_log("shapes: count %d-%d, %s batter (%s side): CPU spots from real pitches in that count", balls, strikes,
+                   b.side == 'R' ? "right-handed" : "left-handed", side ? "opposite" : "same");
+        spot_count = c;
+    } else {
+        spot_count = -1;
+    }
+    memcpy(page + SPOT_OK_OFF, &ok, sizeof ok);
+}
+
+// Each type's speed (mph) as the game rates it: his arsenal slot's velocity rating on the type's range (the tables at
+// 0x7001ddd8b0 / 0x7001ddd8fc, rating 0..99; classes.c), 0 for a type he does not throw. A created player's speed comes
+// from another formula (f_7000245a1c), within a few mph of this.
+static void type_speeds(float mph[TYPES]) {
+    memset(mph, 0, TYPES * sizeof(float));
+    if (!attr_now || !mem_guest_readable(attr_now + 0x36, 0x17) || !mem_guest_readable(0x7001ddd8b0ull, 0x98)) return;
+    const uint8_t *a = (const uint8_t *)(uintptr_t)attr_now;
+    const int32_t *lo = (const int32_t *)(uintptr_t)0x7001ddd8b0ull, *hi = (const int32_t *)(uintptr_t)0x7001ddd8fcull;
+    const char *pg = (const char *)rt_patch_page();
+    for (int slot = 0; slot < 5; slot++) {
+        int ty = a[0x48 + slot], t = type_index(ty), v = a[0x36 + slot];
+        if (t < 0 || v > 99 || mph[t] != 0.0f) continue;
+        if (ty == AIRBENDER) {   // its range is on the patch page (make_airbender.py PAGE_MPH)
+            if (pg) mph[t] = ((const int32_t *)(pg + 0x330))[0] +
+                             (((const int32_t *)(pg + 0x330))[1] - ((const int32_t *)(pg + 0x330))[0]) * v / 99.0f;
+        } else {
+            mph[t] = lo[t] + (hi[t] - lo[t]) * v / 99.0f;
+        }
+    }
+}
+
+// The chevrons for one type at a movement product: direction (0 = down, + = glove side; the display site mirrors it for
+// a left-hander) and size (feet / DRAW_FT).
+static void chevrons(int t, float f, float *dir, float *size) {
+    float k = t == ref_type ? 0.0f : f;   // his fastball's own break is fixed (rel holds it), whatever its product
+    float x = spin_x[t] * k + rel_x[t], y = spin_y[t] * k + rel_y[t];
+    float arm = land_left ? x : -x;   // arm side +
+    *dir = atan2f(-arm, -y) * 57.2957795f;
+    *size = sqrtf(x * x + y * y) / DRAW_FT;
+}
+
+// No break past the most the vanilla game can draw (the user, 2026-11-23, on Glasnow's 12-6 reaching 34 in aimed low
+// and glove side: "we should have a way of smoothing down outliers so the pitches can still be aimed properly", then
+// "what's the most chevrons the vanilla game can possibly draw? tune around that"). Vanilla's largest is the curve:
+// visible-break size 0.933 (physics table f7) x the movement product's ceiling 1.75 = 1.63, which draws ~21.6 in. Real
+// breaks vs 3/4 of the fastball run past it (2026 Statcast: median curve 26 in, the largest 35), so every type's break
+// goes through m -> CAP x tanh(m / CAP): small ones stay nearly whole (10 in -> 9.3), big ones keep their order below
+// the cap (26 -> 18, 35 -> 20). The landing site is linear in the product, B(f) = S f + R (f = product / typical), so
+// the cap is put into S and R: B'(f) = k (B(1) + a S (f - 1)), k = the cap's ratio at f = 1, and a (0..1) chosen so
+// B' at the product's ceiling (1.75 / typical) is the cap of B there. Chevrons and landing keep agreeing.
+#define CAP_IN (0.933f * 1.75f * DRAW_FT * 12.0f)
+static float capped(float m_in) { return CAP_IN * tanhf(m_in / CAP_IN); }
+static void soft_cap(void) {
+    for (int t = 0; t < TYPES; t++) {
+        const float sx = t == ref_type ? 0.0f : spin_x[t], sy = t == ref_type ? 0.0f : spin_y[t];
+        const float bx = sx + rel_x[t], by = sy + rel_y[t], m = sqrtf(bx * bx + by * by) * 12.0f;
+        if (m < 0.01f) continue;
+        const float k = capped(m) / m, fh = 1.75f / mean_product[t];
+        const float hx = sx * fh + rel_x[t], hy = sy * fh + rel_y[t];
+        const float want = capped(sqrtf(hx * hx + hy * hy) * 12.0f) / 12.0f;
+        float lo = 0.0f, hi = 1.0f, a = 1.0f;
+        for (int i = 0; i < 30; i++) {   // the stretch share a whose ceiling lands on the cap (1 = none taken off)
+            a = 0.5f * (lo + hi);
+            float vx = k * (bx + a * sx * (fh - 1.0f)), vy = k * (by + a * sy * (fh - 1.0f));
+            if (sqrtf(vx * vx + vy * vy) > want) hi = a; else lo = a;
+        }
+        a = lo;
+        rel_x[t] = k * (rel_x[t] + (1.0f - a) * sx);
+        rel_y[t] = k * (rel_y[t] + (1.0f - a) * sy);
+        if (t != ref_type) spin_x[t] = k * a * sx, spin_y[t] = k * a * sy;
+    }
+}
+
+// The break display and the user's landing: per type, the chevrons point along the break vs his fastball and reach as
+// far, at the typical product; put_preview() redraws the type he is aiming with at its product there. The aim site
+// lands his pitches at the same break with the pitch's own product.
+static void put_break(char *page, const Shapes *p) {
+    float dir[TYPES], size[TYPES], mph[TYPES], inv[TYPES];
+    land_left = hand_left == 1;
+    type_speeds(mph);
+    ref_type = 0;
+    if (mph[0] == 0.0f)
+        for (int t = 1; t < TYPES; t++)
+            if (mph[t] > mph[ref_type]) ref_type = t;
+    // No gravity term (the user, 2026-11-22, on the version with it: "chevrons are worse than before, so big that it's
+    // not even possible to aim a screwball above the very bottom of the zone ... if it's including the gravity that
+    // should be removed"): only the spin's movement against his fastball's.
+    for (int t = 0; t < TYPES; t++) {
+        spin_x[t] = (land_left ? p->mh[t] : -p->mh[t]) / 12.0f;
+        spin_y[t] = p->mv[t] / 12.0f;
+        inv[t] = 1.0f / mean_product[t];
+    }
+    // Only 3/4 of his fastball's spin break is taken off (the user, 2026-11-22: "I still think the chevrons are a bit too
+    // big, especially vertically, maybe make a 4seamer show like a quarter of its induced movement and base the rest on
+    // that"): his fastball shows a quarter of its own break, every other type its break less 3/4 of the fastball's.
+    for (int t = 0; t < TYPES; t++) {
+        rel_x[t] = -REF_SHARE * spin_x[ref_type];
+        rel_y[t] = -REF_SHARE * spin_y[ref_type];
+    }
+    // His fastball itself: a fixed quarter of its break, whatever its movement product (the game's 4-seam product sits
+    // at its floor 0.25 for CPU pitchers, but a user's perks can lift it, and spin x a product 2-4 x the typical one drew
+    // the 4-seam's whole ride: "4seamer broke again"): its page spin is 0 and its fixed part holds the quarter.
+    rel_x[ref_type] = (1.0f - REF_SHARE) * spin_x[ref_type];
+    rel_y[ref_type] = (1.0f - REF_SHARE) * spin_y[ref_type];
+    soft_cap();
+    for (int t = 0; t < TYPES; t++) chevrons(t, 1.0f, &dir[t], &size[t]);
+    float page_x[TYPES], page_y[TYPES];
+    memcpy(page_x, spin_x, sizeof page_x);
+    memcpy(page_y, spin_y, sizeof page_y);
+    page_x[ref_type] = page_y[ref_type] = 0.0f;
+    memcpy(page + INV_MEAN_OFF, inv, sizeof inv);
+    memcpy(page + AIM_X_OFF, page_x, sizeof page_x);
+    memcpy(page + AIM_Y_OFF, page_y, sizeof page_y);
+    put_spread(page);
+    memcpy(page + DISP_SIZE_OFF, size, sizeof size);
+    memcpy(page + DISP_DIR_OFF, dir, sizeof dir);
+    if (log_on) {
+        char buf[600];
+        int o = snprintf(buf, sizeof buf, "shapes: break vs his fastball (type %d) at the typical product, arm side / up in:",
+                         ref_type);
+        for (int t = 0; t < TYPES && o < (int)sizeof buf - 48; t++)
+            if (mph[t] > 0.0f)
+                o += snprintf(buf + o, sizeof buf - o, " type %d (%.0f mph): %+.1f / %+.1f", game_type(t), mph[t],
+                              (land_left ? 1 : -1) * ((t == ref_type ? 0.0f : spin_x[t]) + rel_x[t]) * 12.0f,
+                              ((t == ref_type ? 0.0f : spin_y[t]) + rel_y[t]) * 12.0f);
+        rt_log("%s", buf);
+    }
+}
+
+// The chevrons of the type he is aiming with now, at its movement product where the cursor is (the preview pitch the
+// game draws them from, *(role + 0x158): type +0x12, product +0xe4; the location factor in it is the game's,
+// f_700024b3a0). Every tick.
+static uint64_t role_now;
+static void put_preview(char *page) {
+    uint64_t pv;
+    if (!role_now || !mem_guest_readable(role_now + 0x158, 8)) return;
+    pv = *(const uint64_t *)(uintptr_t)(role_now + 0x158);
+    if (!pv || !mem_guest_readable(pv + 0x12, 1) || !mem_guest_readable(pv + 0xe4, 4)) return;
+    int t = type_index(*(const uint8_t *)(uintptr_t)(pv + 0x12));
+    float prod = *(const float *)(uintptr_t)(pv + 0xe4);
+    if (t < 0 || t == ref_type || !(prod > 0.1f && prod < 2.0f)) return;   // his fastball keeps its fixed quarter
+    float dir, size;
+    chevrons(t, prod / mean_product[t], &dir, &size);
+    memcpy(page + DISP_SIZE_OFF + 4 * t, &size, 4);
+    memcpy(page + DISP_DIR_OFF + 4 * t, &dir, 4);
+}
+
+// To the page. Size and rating terms first: a pitch set up in between gets this pitcher's size with the last one's
+// direction at worst. (The rating terms and the size are read together at one site; a pitch set up exactly between
+// two of these copies can mix them once, which is a size off by the rating for one pitch.)
+static void put(char *page, const Shapes *p) {
+    memcpy(page + C_OFF, p->c, sizeof p->c);
+    memcpy(page + A_OFF, p->a, sizeof p->a);
+    memcpy(page + B_OFF, p->b, sizeof p->b);
+    memcpy(page + SIZE_OFF, p->size, sizeof p->size);
+    memcpy(page + TURN_OFF, p->turn, sizeof p->turn);
+    put_break(page, p);
+}
+
+// The game's count tables as they are now (pitch_mix's data lines switch them live), or 0 if unreadable.
+static int count_tables(float *out) {
+    if (!mem_guest_readable(COUNT_TABLES, COUNT_BYTES)) return 0;
+    memcpy(out, (const void *)(uintptr_t)COUNT_TABLES, COUNT_BYTES);
+    return 1;
+}
+
+// The pitcher's per-slot weights to the page, for each batter side (0 right-handed, 1 left-handed) and count: his share
+// at that side and count (side share x his count multiplier, or the league's count factor of the pitch's Statcast
+// stand-in, renormalized) over the count table the game multiplies the slot by, so it ends up at his share. Each
+// block's weights first, its flag last, so the site never sees a flag with the last pitcher's weights.
+static const usage_row *usage_find(const usage_row *t, int n, uint32_t id) {
+    int lo = 0, hi = n - 1;
+    while (id && lo <= hi) {
+        int mid = (lo + hi) / 2;
+        if (t[mid].id == id) return &t[mid];
+        if (t[mid].id < id) lo = mid + 1; else hi = mid - 1;
+    }
+    return NULL;
+}
+
+// His mix row: with pitch_classes on, his real arsenal's (usage_cls: retyped, added and swapped slots) if it changes his;
+// else the roster arsenal's.
+static const usage_row *usage_of(uint32_t id) {
+    const usage_row *r = NULL;
+    if (classes_set >= 0 && rt_patch_enabled(classes_set))
+        r = usage_find(usage_cls, (int)(sizeof usage_cls / sizeof usage_cls[0]), id);
+    return r ? r : usage_find(usage_table, (int)(sizeof usage_table / sizeof usage_table[0]), id);
+}
+
+static int usage_stale;   // the last pitcher's row was for other slot types than his arsenal has now
+
+static usage_row fb_row;   // the fallback row (usage_fallback)
+
+// The fallback for a pitcher without a usage row (created and Road to the Show players) or whose arsenal no longer
+// matches his row: a row built from his live arsenal the way the table builds those of pitchers without 2026 pitches.
+// Each slot's base share is the roster's usage for it (+0x42 + slot), else its type's mean share among the pitchers
+// who throw it (a knuckleball is most of a knuckleballer's pitches); x the league's platoon factor for his throwing
+// hand against each batter side; by count the league's factor of each type (cnt -1). NULL: no arsenal to read.
+static const usage_row *usage_fallback(uint32_t id) {
+    if (!attr_now || !mem_guest_readable(attr_now + 0x42, 11)) return NULL;
+    const uint8_t *a = (const uint8_t *)(uintptr_t)attr_now;
+    int any = 0, have_use = 0;
+    for (int k = 0; k < 5; k++)
+        if (type_index(a[0x48 + k]) >= 0) any = 1, have_use |= a[0x42 + k] != 0;
+    if (!any) return NULL;
+    float base[5];
+    memset(&fb_row, 0, sizeof fb_row);
+    fb_row.id = (uint16_t)id, fb_row.cnt = -1;
+    for (int k = 0; k < 5; k++) {
+        int ty = a[0x48 + k];
+        if (type_index(ty) < 0) {
+            fb_row.ty[k] = fb_row.cat[k] = 255, base[k] = 0.0f;
+            continue;
+        }
+        int tc = ty == AIRBENDER ? 6 : ty;   // the airbender's count table and stand-in: the changeup's
+        fb_row.ty[k] = (uint8_t)ty, fb_row.cat[k] = usage_type_cat[tc], fb_row.st[k] = usage_type_st[tc];
+        base[k] = have_use ? (float)a[0x42 + k] : usage_league[usage_type_st[tc]];
+    }
+    for (int s = 0; s < 2; s++) {   // 0 right-handed batters, 1 left-handed
+        float w[5], sum = 0.0f;
+        for (int k = 0; k < 5; k++) {
+            float f = 1.0f;
+            if (hand_left >= 0 && fb_row.ty[k] != 255)   // same side: a right-hander against right-handed batters
+                f = usage_platoon[fb_row.st[k]][(s == 1) == (hand_left == 1) ? 0 : 1];
+            w[k] = base[k] * f, sum += w[k];
+        }
+        for (int k = 0; k < 5; k++) {
+            uint16_t v = (uint16_t)(sum > 0.0f ? w[k] / sum * 10000.0f + 0.5f : 0.0f);
+            if (s) fb_row.l[k] = v; else fb_row.r[k] = v;
+        }
+    }
+    return &fb_row;
+}
+
+static const usage_row *put_usage(char *page, uint32_t id, const float *tables) {
+    const usage_row *row = usage_of(id);
+    // the row is for the slot types it was made from: if his arsenal has changed since (a franchise or Road to the Show
+    // pitch learned or dropped, a slot moved), its weights would land on other pitches: the fallback then
+    usage_stale = 0;
+    if (row && attr_now && mem_guest_readable(attr_now + 0x48, 5)) {
+        const uint8_t *ty = (const uint8_t *)(uintptr_t)(attr_now + 0x48);
+        for (int k = 0; k < 5; k++)
+            if ((type_index(ty[k]) >= 0 ? ty[k] : 255) != row->ty[k]) usage_stale = 1;
+        if (usage_stale) row = NULL;
+    }
+    if (!row) row = usage_fallback(id);   // NULL without an arsenal to read (no pitcher)
+    for (int s = 0; s < 2; s++)
+        for (int c = 0; c < 12; c++) {
+            float *u = (float *)(page + USAGE_OFF + 32 * (12 * s + c)), w[5], sum = 0.0f;
+            u[5] = 0.0f;
+            for (int k = 0; k < 5; k++) {
+                w[k] = 0.0f;
+                if (!row || row->cat[k] > 3) continue;
+                float m = row->cnt >= 0 ? usage_counts[row->cnt][12 * s + c][k] / USAGE_MULT : usage_cf[row->st[k]][c];
+                w[k] = (s ? row->l[k] : row->r[k]) / 10000.0f * m;
+                sum += w[k];
+            }
+            for (int k = 0; k < 5; k++) {
+                float t = tables && row && row->cat[k] <= 3 ? tables[12 * row->cat[k] + c] : 1.0f;
+                u[k] = sum > 0.0f ? w[k] / sum / (t > 0.05f ? t : 0.05f) : 0.0f;
+            }
+            u[5] = sum > 0.0f ? 1.0f : 0.0f;
+        }
+    return row;
+}
+
+// The flight-length correction (pitcher_shapes' site in the flight step f_7001658448): N = (59.08 - the delivery's real
+// extension)^2 at +0xc00, which the site divides by each pitch's own flight squared, so his break from the hand is his
+// real one. Returns the delivery's last measured flight (extension.c; for the log), 0 before its first pitch.
+static float put_flight(char *page, int style) {
+    float n = PLATE_FRONT - extension_style_ft(style);
+    *(float *)(page + FLIGHT_N_OFF) = n * n;
+    return extension_flight_ft(style);
+}
+
+static void watcher(void *arg) {
+    char *page = (char *)rt_patch_page();
+    uint64_t last = 0;   // the pitcher's player object (mound.c), 0 none
+    uint32_t last_id = 0;
+    int last_style = -2, have = 0, no_id = 0;   // no_id: 20 ms ticks without a pitcher on the mound
+    float tabs[48], now[48], last_flight = -1.0f;
+    (void)arg;
+    rng ^= plat_now_ns() * 0xbf58476d1ce4e5b9ull | 1;   // a different sequence each session (never all zero)
+    for (;;) {
+        // a new pitcher is on the mound well before his first pitch's setup (warm-up, walk-up): 20 ms is plenty
+        plat_sleep_ns(20000000ull);
+        put_spread(page);   // a fresh random part for the user's next pitch
+        put_spots(page);    // and fresh spots for the CPU's
+        put_preview(page);  // the chevrons of the pitch he is aiming, at the cursor's product
+        // the count tables can change under a pitcher (pitch_mix switched): his weights follow them
+        if (count_tables(now) && (!have || memcmp(now, tabs, sizeof tabs))) {
+            memcpy(tabs, now, sizeof tabs);
+            have = 1;
+            if (last) put_usage(page, last_id, tabs);
+        }
+        MoundPitcher mp;
+        if (!mound_pitcher(&mp)) {
+            // a moment without one keeps the pitcher's shapes; after a second (out of a game), the plain shapes (no
+            // data, no rating read: the type's own), the game's own mix weights and an average flight
+            if (++no_id == 50 && last) {
+                height_in = 0, attr_now = 0, hand_left = -1;
+                Shapes plain;
+                fill(&plain, -1, -1, 0);
+                put(page, &plain);
+                put_usage(page, 0, have ? tabs : NULL);
+                last_flight = put_flight(page, -1);
+                last = 0, last_id = 0, last_style = -2;
+                if (log_on) rt_log("shapes: no pitcher on the mound for a second: the plain shapes");
+            }
+            continue;
+        }
+        if (log_on && no_id >= 5 && no_id < 50) rt_log("shapes: no pitcher on the mound for %d ms", no_id * 20);
+        no_id = 0;
+        // the object tells created players apart (their ids are all 65535); his style as well (delivery_styles switched)
+        uint32_t id = mp.id;
+        int style = mp.style;
+        if (mp.player == last && id == last_id && style == last_style) {
+            // his delivery's first pitch measured its flight (for the log)
+            if (extension_flight_ft(style) != last_flight) last_flight = put_flight(page, style);
+            continue;
+        }
+        height_in = mp.height_in, attr_now = mp.attr, hand_left = mp.left, role_now = mp.role;
+        int own = table_index((int)id), slot = style >= 0 ? table_index(style) : -1;
+        Shapes p;
+        int real = fill(&p, own, slot, id);
+        put(page, &p);
+        const usage_row *u = put_usage(page, id, have ? tabs : NULL);
+        last_flight = put_flight(page, style);
+        last = mp.player, last_id = id, last_style = style;
+        if (log_on) {
+            float ext = extension_style_ft(style), dec = decoded_flight(style);
+            int rec = mound_roster_record(mp.player);
+            char where[48];
+            if (rec >= 0) snprintf(where, sizeof where, "roster record %d", rec);
+            else snprintf(where, sizeof where, "not a roster record");
+            rt_log("shapes: pitcher %u %s (%s, %s; his player object is %s): new on the mound", id, mp.name,
+                   hand_left ? "left-handed" : "right-handed", id ? "MLB id" : "created or generic", where);
+            rt_log("shapes: pitcher %u flight: real %.2f ft (extension %.2f), his delivery's in game %.2f ft (%s, height "
+                   "%d in); break x (%.2f / this pitch's flight)^2", id, PLATE_FRONT - ext, ext,
+                   last_flight > 0.0f ? last_flight : dec > 40.0f ? dec : GAME_FLIGHT_AVG,
+                   last_flight > 0.0f ? "measured" : dec > 40.0f ? "decoded" : "the game's mean", height_in,
+                   PLATE_FRONT - ext);
+            rt_log("shapes: pitcher %u (delivery %d): %s; %d pitch types from his own movement; 4S turn %+.1f deg, size "
+                   "x%.2f; sinker %+.1f / x%.2f; curve %+.1f / x%.2f%s; slider %+.1f / x%.2f%s; changeup %+.1f / x%.2f%s",
+                   id, style,
+                   own >= 0 ? (shape_table[own].arm != SHAPE_NONE ? "own data" : "own movement")
+                            : slot >= 0 ? "his delivery's arm slot" : "no data, the game's shapes",
+                   real, p.turn[0], p.size[0], p.turn[1], p.size[1], p.turn[2], p.size[2],
+                   p.c[2] == 0.0f ? " (no rating)" : "", p.turn[3], p.size[3], p.c[3] == 0.0f ? " (no rating)" : "",
+                   p.turn[6], p.size[6], p.c[6] == 0.0f ? " (no rating)" : "");
+            if (attr_now && mem_guest_readable(attr_now + 0x3c, 0x11)) {
+                // each slot: type, movement rating now, its z among MLB pitchers, his 2026 rating where he has one
+                const uint8_t *a = (const uint8_t *)(uintptr_t)attr_now;
+                char buf[512];   // 5 slots of at most about 60 characters
+                int n = 0;
+                for (int k = 0; k < 5 && n < (int)sizeof buf - 80; k++) {
+                    int t = type_index(a[0x48 + k]), r0 = 0;
+                    float sf0;
+                    if (t < 0) continue;
+                    n += snprintf(buf + n, sizeof buf - n, "%s type %d: %d (%+.1f SD", n ? "," : "", a[0x48 + k], a[0x3c + k],
+                                  rating_z(t, a[0x3c + k]));
+                    if (own >= 0 && r_base(id, t, &r0, &sf0))
+                        n += snprintf(buf + n, sizeof buf - n, ", 2026 %d", r0);
+                    n += snprintf(buf + n, sizeof buf - n, ") size x%.2f turn %+.0f", p.size[t], p.turn[t]);
+                }
+                rt_log("shapes: pitcher %u movement ratings by slot:%s", id, n ? buf : " none");
+                // each slot's spin break (arm side, up; in) and the chevrons' direction (0 = down, + = glove side) and
+                // size: where the user's pitch lands from the aim, and what the display shows
+                n = 0;
+                for (int k = 0; k < 5 && n < (int)sizeof buf - 60; k++) {
+                    int t = type_index(a[0x48 + k]);
+                    if (t < 0) continue;
+                    n += snprintf(buf + n, sizeof buf - n, "%s type %d: %+.1f / %+.1f in, chevrons %+.0f deg x%.2f",
+                                  n ? "," : "", a[0x48 + k], p.mh[t], p.mv[t], atan2f(-p.mh[t], -p.mv[t]) * 57.2957795f,
+                                  sqrtf(p.mh[t] * p.mh[t] + p.mv[t] * p.mv[t]) / 12.0f / DRAW_FT);
+                }
+                rt_log("shapes: pitcher %u spin break by slot:%s", id, n ? buf : " none");
+            }
+            if (u)
+                rt_log("shapes: pitcher %u usage by slot vs R %.0f %.0f %.0f %.0f %.0f %%, vs L %.0f %.0f %.0f %.0f %.0f "
+                       "%%; by count: %s; %s arsenal", id, u->r[0] / 100.0, u->r[1] / 100.0, u->r[2] / 100.0,
+                       u->r[3] / 100.0, u->r[4] / 100.0, u->l[0] / 100.0, u->l[1] / 100.0, u->l[2] / 100.0,
+                       u->l[3] / 100.0, u->l[4] / 100.0, u->cnt >= 0 ? "his 2026 season" : "the league's factors",
+                       u == &fb_row ? (usage_stale ? "fallback (his row is for other pitches): his live"
+                                                   : "fallback (no row): his live")
+                       : u >= usage_cls && u < usage_cls + sizeof usage_cls / sizeof usage_cls[0] ? "his real" : "the roster's");
+            else
+                rt_log("shapes: pitcher %u: no arsenal to read, the game's weights", id);
+        }
+    }
+}
+
+static void disable_both(int set, int uset) {
+    if (set >= 0) rt_patch_disable(set);
+    if (uset >= 0) rt_patch_disable(uset);
+}
+
+void shapes_start(void) {
+    // one watcher for both sets: pitcher_shapes (the movement) and pitch_usage (the pitch mix)
+    int set = rt_patch_set("pitcher_shapes"), uset = rt_patch_set("pitch_usage");
+    classes_set = rt_patch_set("pitch_classes");   // -1 in an exe without it
+    if ((set < 0 && uset < 0) || !rt_patch_page()) return;   // an exe built without either set
+    char *page = (char *)rt_patch_page();
+    Shapes p;
+    fill(&p, -1, -1, 0);   // the game's own shapes and weights until a pitcher is known
+    put(page, &p);
+    put_usage(page, 0, NULL);
+    *(float *)(page + FLIGHT_N_OFF) = 0.0f;      // no pitcher yet: the flight site leaves the force alone
+    if (strcmp(rt_game_build, "1.0.20")) {
+        rt_log("shapes: no addresses known for game %s; pitcher_shapes and pitch_usage are switched off", rt_game_build);
+        disable_both(set, uset);
+        return;
+    }
+    const char *l = cfg_get("MLB_PITCHER_SHAPES_LOG");
+    log_on = l && *l && strcmp(l, "0") != 0;
+    // The thread runs whether the sets are on or off: they can be switched while the game runs.
+    if (!plat_thread_spawn(watcher, NULL, "shapes", 0)) {
+        rt_log("shapes: cannot start the watcher thread; pitcher_shapes and pitch_usage are switched off");
+        disable_both(set, uset);
+        return;
+    }
+    rt_log("shapes: pitcher_shapes %s, pitch_usage %s; %d pitchers and deliveries in the shapes table, %d in the usage "
+           "table", rt_patch_enabled(set) ? "on" : "off", rt_patch_enabled(uset) ? "on" : "off",
+           (int)(sizeof shape_table / sizeof shape_table[0]), (int)(sizeof usage_table / sizeof usage_table[0]));
+}
