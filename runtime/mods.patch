+++ b/runtime/mlb/slidestep.c
@@ -0,0 +1,232 @@
+// mlbts-native: Pitching++ slide steps. With a runner on, a pitcher sometimes throws from a slide step: a quick, low
+// leg lift. The game has four for everyone (MLBMAINCORE.XBN 2418, 2423, 2428, 2433: pitcher_slidestep_*_Pitch, one
+// per arm slot), so every pitcher looks the same doing it. Pitching++ gives each 2026 pitcher his own, made from his
+// edited stretch throw (mods/pitch-types/deliveries/make_slide.py: his set position, a quick low lift, then his own
+// stride and release). tools/deliveries_install.py puts them in PS4/ANIMATION/PITCHERSLIDE.XBN: slot i is the slide
+// step of the pitcher on delivery copy 25000 + i (styles.c), an empty slot when there is none.
+//
+// MLB_SLIDE_STEPS=1   the set slide_steps (a switch: no code sites); needs delivery_styles on as well
+//
+// [M, 1.0.20, 2026-11-21] MLBMAINCORE.XBN is loaded whole when the game starts and stays resident: bank 0 of the bank
+// manager at 0x70045aefe0 (a bank: clip count u32 at +0xc, pointer table at +0x18, one 8-byte pointer a clip). The
+// game looks a clip up in that table each time it plays one (nothing else points at the slide steps' data), so the
+// table's four slide-step entries decide which slide step plays. Each time a new pitcher is on the mound (mound.c, his
+// delivery style there) this file points all four at his own slide step, read from
+// PITCHERSLIDE.XBN into guest-visible memory and prepared as the game's bank loader prepares a clip (f_70003cc390:
+// +0x0 -> the node at +0x20, +0x8 -> the event block, 0xaa at +0x18, event block +0x20 -> its entries, events in id
+// order; make_slide.py writes them in that order), or back at the game's own for a pitcher without one. Switched off,
+// the game's own go back. (Whether a pitch is a slide step the game decides in f_70002449ec: byte +0x25 of the pitch
+// object, set at 0x7000244ca0. A test-only patch set, test_slide_always, makes every CPU pitch one.)
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "cfg.h"
+#include "host.h"
+#include "mound.h"
+#include "platform/platform.h"
+
+#define MGR 0x70045aefe0ull        // the bank manager: bank i's object at MGR + i*8
+#define FIRST_STYLE 25000          // PITCHERSLIDE.XBN slot 0 = delivery copy 25000
+
+static const int SLIDES[4] = {2418, 2423, 2428, 2433};
+static int set = -1;
+static uint32_t core_count;        // MLBMAINCORE.XBN's clip count
+static uint32_t anim_id[4];        // the four slide steps' anim ids (clip +0x30): checks the table found
+static uint64_t table;             // MAINCORE's pointer table (guest address), 0 until found
+static uint64_t bank_obj;          // the bank object that holds it, and its slot in the manager
+static int bank_slot = -1;
+static uint64_t orig[4];           // the game's own four pointers
+static char slide_path[1024];
+static uint32_t n_slots;
+static uint32_t *slot_size, *slot_off;
+static uint64_t *ready;            // per slot: the prepared clip in guest memory (kept: it may be playing)
+
+static int read_u64(uint64_t a, uint64_t *out) {
+    if (!a || !mem_guest_readable(a, 8)) return 0;
+    *out = *(const uint64_t *)(uintptr_t)a;
+    return 1;
+}
+
+static int read_u32(uint64_t a, uint32_t *out) {
+    if (!a || !mem_guest_readable(a, 4)) return 0;
+    *out = *(const uint32_t *)(uintptr_t)a;
+    return 1;
+}
+
+// MAINCORE's pointer table, checked by the four slide steps' anim ids; 0 while the bank is not loaded.
+static uint64_t find_table(void) {
+    for (int i = 0; i < 64; i++) {
+        uint64_t obj, tab;
+        uint32_t cnt;
+        if (!read_u64(MGR + i * 8ull, &obj) || !obj || !read_u32(obj + 0xc, &cnt) || cnt != core_count ||
+            !read_u64(obj + 0x18, &tab) || !tab)
+            continue;
+        int ok = 1;
+        for (int k = 0; k < 4 && ok; k++) {
+            uint64_t p;
+            uint32_t id;
+            ok = read_u64(tab + SLIDES[k] * 8ull, &p) && read_u32(p + 0x30, &id) && id == anim_id[k];
+            for (uint32_t s = 0; ok && ready && s < n_slots; s++)   // the game's own clip, not one of ours
+                ok = p != ready[s];
+        }
+        if (ok) {
+            bank_obj = obj, bank_slot = i;
+            return tab;
+        }
+    }
+    return 0;
+}
+
+// The table found is still MAINCORE's: the same bank object in the same slot, the same table and clip count. Checked
+// before every write (MAINCORE has stayed resident in every test; if it were ever reloaded, the old table would be
+// freed memory).
+static int table_still(void) {
+    uint64_t obj, tab;
+    uint32_t cnt;
+    return table && bank_slot >= 0 && read_u64(MGR + bank_slot * 8ull, &obj) && obj == bank_obj &&
+           read_u32(obj + 0xc, &cnt) && cnt == core_count && read_u64(obj + 0x18, &tab) && tab == table &&
+           mem_guest_readable(table + SLIDES[0] * 8ull, (SLIDES[3] - SLIDES[0] + 1) * 8ull);
+}
+
+// Slot s's clip in guest memory, prepared as the bank loader does; 0 when the slot is empty or unreadable.
+static uint64_t prepare(uint32_t s) {
+    if (s >= n_slots || !slot_size[s]) return 0;
+    if (ready[s]) return ready[s];
+    uint32_t sz = slot_size[s];
+    if (sz < 0x28) return 0;
+    FILE *f = fopen(slide_path, "rb");
+    if (!f) return 0;
+    uint8_t *buf = mem_kernel_alloc(sz, 16);
+    int ok = buf && !fseek(f, slot_off[s], SEEK_SET) && fread(buf, 1, sz, f) == sz;
+    fclose(f);
+    uint32_t ds = 0;
+    if (ok) memcpy(&ds, buf + 8, 4);
+    if (!ok || (uint64_t)ds + 0x28 > sz) {
+        rt_log("slidestep: slot %u of %s unreadable", s, slide_path);
+        return 0;   // the block stays allocated (small; never handed to the game)
+    }
+    uint64_t base = (uint64_t)(uintptr_t)buf;
+    *(uint64_t *)(buf + 0x0) = base + 0x20;
+    *(uint64_t *)(buf + 0x8) = base + ds;
+    *(uint64_t *)(buf + 0x18) = 0xaa;
+    *(uint64_t *)(buf + ds + 0x20) = base + ds + 0x28;
+    __atomic_thread_fence(__ATOMIC_RELEASE);
+    ready[s] = base;
+    return base;
+}
+
+static void point_all(uint64_t to[4]) {
+    for (int k = 0; k < 4; k++) {
+        uint64_t a = table + SLIDES[k] * 8ull;
+        if (*(volatile uint64_t *)(uintptr_t)a == to[k]) continue;
+        mem_thaw(a, 8);
+        __atomic_store_n((uint64_t *)(uintptr_t)a, to[k], __ATOMIC_RELEASE);
+    }
+}
+
+static void watcher(void *arg) {
+    (void)arg;
+    uint64_t last = 0;   // the pitcher's player object (mound.c), 0 none
+    int last_style = -1, last_on = 0, no_id = 0;   // no_id: 200 ms ticks without a pitcher on the mound
+    for (;;) {
+        // a new pitcher is on the mound (warm-up, walk-up) long before his first pitch: five checks a second
+        plat_sleep_ns(200000000ull);
+        if (table && !table_still()) {
+            // MAINCORE moved or was reloaded: the old table is not the game's any more (never written again); a new
+            // one holds the game's own slide steps, and the pitcher's are set on it afresh
+            rt_log("slidestep: the game's slide-step table moved; looking for it again");
+            table = 0, bank_slot = -1, last = 0, last_style = -1, last_on = 0;
+        }
+        if (!table) {
+            table = find_table();
+            if (!table) continue;
+            for (int k = 0; k < 4; k++) orig[k] = *(const uint64_t *)(uintptr_t)(table + SLIDES[k] * 8ull);
+            rt_log("slidestep: the game's slide steps found (pointer table %#llx)", (unsigned long long)table);
+        }
+        int on = rt_patch_enabled(set);
+        if (!on) {
+            if (last_on) point_all(orig), rt_log("slidestep: off: the game's own slide steps");
+            last_on = 0, last = 0, last_style = -1;
+            continue;
+        }
+        MoundPitcher mp;
+        if (!mound_pitcher(&mp)) {
+            // more than a second without a pitcher on the mound (out of a game): the game's own slide steps
+            if (++no_id == 5 && last_on && last) {
+                point_all(orig);
+                last = 0, last_style = -1;
+                rt_log("slidestep: no pitcher on the mound for a second: the game's slide steps");
+            }
+            continue;
+        }
+        no_id = 0;
+        // his style as well: delivery_styles switched, or a franchise edit, changes it for the same pitcher
+        int style = mp.style;
+        if (mp.player == last && style == last_style && last_on) continue;
+        last = mp.player, last_style = style, last_on = 1;
+        uint64_t clip = style >= FIRST_STYLE ? prepare((uint32_t)(style - FIRST_STYLE)) : 0;
+        uint64_t to[4];
+        for (int k = 0; k < 4; k++) to[k] = clip ? clip : orig[k];
+        point_all(to);
+        rt_log("slidestep: pitcher %u %s (delivery %d): %s", mp.id, mp.name, style,
+               clip ? "his own slide step" : "the game's slide steps");
+    }
+}
+
+// The slide steps' file, slot table and the MAINCORE facts the watcher checks against. 0 on success.
+static const char *load_files(void) {
+    const RtConfig *cf = rt_config();
+    if (!cf || !cf->romfs) return "no romfs folder";
+    char path[1024];
+    snprintf(path, sizeof path, "%s/PS5/ANIMATION/MLBMAINCORE.XBN", cf->romfs);
+    FILE *f = fopen(path, "rb");
+    if (!f) return "MLBMAINCORE.XBN unreadable";
+    uint32_t hdr[2];
+    int ok = fread(hdr, 4, 2, f) == 2;
+    core_count = hdr[1];
+    for (int k = 0; k < 4 && ok; k++) {
+        uint32_t slot[2];
+        ok = (uint32_t)SLIDES[k] < core_count && !fseek(f, 0x30 + SLIDES[k] * 8, SEEK_SET) && fread(slot, 4, 2, f) == 2 &&
+             !fseek(f, slot[1] + 0x30, SEEK_SET) && fread(&anim_id[k], 4, 1, f) == 1;
+    }
+    fclose(f);
+    if (!ok) return "MLBMAINCORE.XBN: the slide steps unreadable";
+    snprintf(slide_path, sizeof slide_path, "%s/PS4/ANIMATION/PITCHERSLIDE.XBN", cf->romfs);
+    f = fopen(slide_path, "rb");
+    if (!f) return "no PITCHERSLIDE.XBN (run the Pitching++ file step)";
+    ok = fread(hdr, 4, 2, f) == 2 && hdr[0] == 3 && hdr[1] > 0 && hdr[1] < 4096;
+    n_slots = ok ? hdr[1] : 0;
+    uint32_t *st = ok ? malloc(n_slots * 8ull) : NULL;
+    ok = st && !fseek(f, 0x30, SEEK_SET) && fread(st, 8, n_slots, f) == n_slots;
+    fclose(f);
+    if (!ok) { free(st); return "PITCHERSLIDE.XBN unreadable"; }
+    slot_size = malloc(n_slots * 4ull), slot_off = malloc(n_slots * 4ull), ready = calloc(n_slots, 8);
+    if (!slot_size || !slot_off || !ready) { free(st); return "out of memory"; }
+    for (uint32_t i = 0; i < n_slots; i++) slot_size[i] = st[2 * i], slot_off[i] = st[2 * i + 1];
+    free(st);
+    return NULL;
+}
+
+void slidestep_start(void) {
+    set = rt_patch_set("slide_steps");
+    if (set < 0) return;   // an exe built without the set
+    if (strcmp(rt_game_build, "1.0.20")) {
+        rt_log("slidestep: no addresses known for game %s; slide_steps is switched off", rt_game_build);
+        rt_patch_disable(set);
+        return;
+    }
+    const char *why = load_files();
+    if (why) {
+        rt_log("slidestep: %s; slide_steps is switched off", why);
+        rt_patch_disable(set);
+        return;
+    }
+    if (!plat_thread_spawn(watcher, NULL, "slidestep", 0)) {
+        rt_log("slidestep: cannot start the watcher thread; slide_steps is switched off");
+        rt_patch_disable(set);
+        return;
+    }
+    rt_log("slidestep: slide_steps %s; %u slots in PITCHERSLIDE.XBN", rt_patch_enabled(set) ? "on" : "off", n_slots);
+}
diff --git a/runtime/mlb/styles.c b/runtime/mlb/styles.c
new file mode 100644
index 0000000..e18e8da
--- /dev/null
+++ b/runtime/mlb/styles.c
@@ -0,0 +1,208 @@
+// mlbts-native: Pitching++ delivery styles. Every 2026 pitcher throws his own copy of the delivery he already has,
+// with its windup and stretch throws edited to his real 2026 release (arm angle, release height, side, extension; the
+// rubber spot is rubber.c's). The clips and the copies are put in the game files by mods/pitch-types/tools/
+// deliveries_install.py (the Mod Manager's file step): new styles 25000.. in PITCHERSTREAM.BBS, new clip slots at the
+// end of MLBPITCHINGCORE.XBN. This file only tells the game which pitcher uses which copy.
+//
+// MLB_DELIVERY_STYLES=1   the set delivery_styles (a switch: no code sites)
+//
+// [M, 1.0.20, 2026-11-20] The roster in memory (as classes.c / shapes.c): records at *(*(0x7004650770)), 0xb0 bytes,
+// count u32 at 0x7004650798; +0x8 u16 delivery style, +0x9a u16 player id. The game reads the style (f_7000155c14: a
+// signed short at the record's +8, so ids stay below 32768) when it streams a pitcher's 24 delivery clips as he takes
+// the mound (f_7001389f60), so a style set after the roster loads is used from his next appearance. Each roster load
+// (the menus, the way to a game, a franchise or Road to the Show save with its own roster) gets styles_table's records
+// set from the style the roster gives them ("was") to their copy; a record with another style (a franchise edit) is
+// left alone. Switched off, every record holding its copy goes back, also one a save made with the set on brought in.
+// Only when the installed PITCHERSTREAM.BBS has every copy: the game falls back to its Generic Windup 1 (style 32000)
+// for a style it cannot find, so without the file step nothing is set and saved copies go back, also on a player the
+// user gave one in the player editor (the file step lists the copies there: tools/delivery_menu.py).
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "cfg.h"
+#include "host.h"
+#include "platform/platform.h"
+#include "styles_table.h"   // styles_table (mods/pitch-types/deliveries/pack_deliveries.py)
+
+#define N_STYLES ((int)(sizeof styles_table / sizeof styles_table[0]))
+
+static int set = -1;
+static int have_files;               // the installed PITCHERSTREAM.BBS has every copy
+static uint8_t *rec_of[N_STYLES];    // the record found for each entry in this roster (0 = not there)
+static uint8_t applied[N_STYLES];
+
+static int read_u64(uint64_t a, uint64_t *out) {
+    if (!a || !mem_guest_readable(a, 8)) return 0;
+    *out = *(const uint64_t *)(uintptr_t)a;
+    return 1;
+}
+
+static int entry_of(uint16_t id) {
+    int lo = 0, hi = N_STYLES - 1;
+    while (lo <= hi) {
+        int mid = (lo + hi) / 2;
+        if (styles_table[mid].id == id) return mid;
+        if (styles_table[mid].id < id) lo = mid + 1; else hi = mid - 1;
+    }
+    return -1;
+}
+
+// How many of the table's copies the installed PITCHERSTREAM.BBS lacks (-1: unreadable). Its layout: u32 count, u32
+// capacity, u64 offset of the entries; an entry is 0x28 bytes with the style id (u64) at +0x20.
+static int missing_copies(void) {
+    const RtConfig *cf = rt_config();
+    if (!cf || !cf->romfs) return -1;
+    char path[1024];
+    snprintf(path, sizeof path, "%s/PS4/ANIMATION/PITCHERSTREAM.BBS", cf->romfs);
+    FILE *f = fopen(path, "rb");
+    if (!f) return -1;
+    fseek(f, 0, SEEK_END);
+    long sz = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    uint8_t *b = sz > 16 && sz < (64 << 20) ? malloc((size_t)sz) : NULL;
+    int ok = b && fread(b, 1, (size_t)sz, f) == (size_t)sz;
+    fclose(f);
+    if (!ok) { free(b); return -1; }
+    uint32_t n; uint64_t off;
+    memcpy(&n, b, 4); memcpy(&off, b + 8, 8);
+    if (off + (uint64_t)n * 0x28 > (uint64_t)sz) { free(b); return -1; }
+    static uint8_t have[65536 / 8];
+    memset(have, 0, sizeof have);
+    for (uint32_t i = 0; i < n; i++) {
+        uint64_t sid;
+        memcpy(&sid, b + off + i * 0x28ull + 0x20, 8);
+        if (sid < 65536) have[sid >> 3] |= (uint8_t)(1 << (sid & 7));
+    }
+    free(b);
+    int miss = 0;
+    for (int i = 0; i < N_STYLES; i++)
+        if (!(have[styles_table[i].style >> 3] >> (styles_table[i].style & 7) & 1)) miss++;
+    return miss;
+}
+
+// This roster's records for the table's players; returns the roster's address ^ count so a reload is noticed, 0 when
+// it is not loaded or none of the table's players are in it yet (an array allocated but not filled).
+static uint64_t locate(void) {
+    uint64_t db, arr;
+    if (!read_u64(0x7004650770ull, &db) || !read_u64(db, &arr) || !arr || !mem_guest_readable(0x7004650798ull, 4))
+        return 0;
+    uint32_t n = *(const uint32_t *)(uintptr_t)0x7004650798ull;
+    if (!n || n > 20000 || !mem_guest_readable(arr, (size_t)n * 0xb0)) return 0;
+    int found = 0;
+    memset(rec_of, 0, sizeof rec_of);
+    for (uint32_t r = 0; r < n; r++) {
+        uint8_t *rec = (uint8_t *)(uintptr_t)(arr + r * 0xb0ull);
+        int e = entry_of(*(const uint16_t *)(rec + 0x9a));
+        if (e >= 0) rec_of[e] = rec, found++;
+    }
+    return found ? arr ^ n : 0;
+}
+
+static void apply(int on) {
+    int changed = 0;
+    for (int i = 0; i < N_STYLES; i++) {
+        uint8_t *r = rec_of[i];
+        // still his record (a roster reloaded at the same address and count, in another order, must not give another
+        // pitcher who shares the "was" style this one's copy)
+        if (!r || *(const uint16_t *)(r + 0x9a) != styles_table[i].id) continue;
+        uint16_t *s = (uint16_t *)(r + 0x8);
+        if (on && *s == styles_table[i].was) {
+            *s = styles_table[i].style, applied[i] = 1, changed++;
+        } else if (!on && *s == styles_table[i].style) {
+            // back, whether this session set it or a franchise / Road to the Show save made with the set on brought
+            // it in (without the files the copy does not exist: the game would give him Generic Windup 1)
+            *s = styles_table[i].was, applied[i] = 0, changed++;
+        } else if (!on) {
+            applied[i] = 0;
+        }
+    }
+    if (changed) rt_log("styles: %d pitchers %s", changed, on ? "on their own delivery copies" : "back on the roster's deliveries");
+}
+
+// The delivery a copy was made from (its pitcher's roster style), or -1 when style is no copy.
+static int copy_was(uint16_t style) {
+    for (int i = 0; i < N_STYLES; i++)
+        if (styles_table[i].style == style) return styles_table[i].was;
+    return -1;
+}
+
+// Without the files (the file step uninstalled), any record on a copy goes back to the delivery it was made from:
+// besides the table's pitchers (apply), a player the user gave a copy in the player editor, where the file step lists
+// them (a created or Road to the Show player: id 65535, never in the table). The game would give him Generic Windup 1.
+// With the files there, set on or off, the editor's choice stays. Runs on every check while the files are missing.
+static void restore_any(void) {
+    static uint16_t lo = 0xffff, hi;
+    uint64_t db, arr;
+    if (lo == 0xffff)
+        for (int i = 0; i < N_STYLES; i++) {
+            if (styles_table[i].style < lo) lo = styles_table[i].style;
+            if (styles_table[i].style > hi) hi = styles_table[i].style;
+        }
+    if (!read_u64(0x7004650770ull, &db) || !read_u64(db, &arr) || !arr || !mem_guest_readable(0x7004650798ull, 4))
+        return;
+    uint32_t n = *(const uint32_t *)(uintptr_t)0x7004650798ull;
+    if (!n || n > 20000 || !mem_guest_readable(arr, (size_t)n * 0xb0)) return;
+    int changed = 0;
+    for (uint32_t r = 0; r < n; r++) {
+        uint16_t *s = (uint16_t *)(uintptr_t)(arr + r * 0xb0ull + 0x8);
+        if (*s < lo || *s > hi) continue;
+        int was = copy_was(*s);
+        if (was >= 0) *s = (uint16_t)was, changed++;
+    }
+    if (changed) rt_log("styles: %d players back from delivery copies the game files do not have", changed);
+}
+
+static void watcher(void *arg) {
+    (void)arg;
+    uint64_t where = 0;
+    int recheck = 0;
+    for (;;) {
+        // the roster loads once the menus are up and is reloaded on the way to a game; a pitcher's delivery is streamed
+        // from it when he takes the mound, seconds later: five checks a second (as classes.c)
+        plat_sleep_ns(200000000ull);
+        uint64_t now = 0, db, arr;
+        if (read_u64(0x7004650770ull, &db) && read_u64(db, &arr) && mem_guest_readable(0x7004650798ull, 4))
+            now = arr ^ *(const uint32_t *)(uintptr_t)0x7004650798ull;
+        if (!now) continue;
+        if (now != where) {   // a new roster: its records hold the file's styles again
+            where = locate();
+            memset(applied, 0, sizeof applied);
+            if (!have_files) restore_any();
+            if (!where) continue;
+            recheck = 5;
+        } else if (recheck && !--recheck) {
+            locate();   // once more a second later, in case the roster was caught while it was being filled
+        }
+        apply(have_files && rt_patch_enabled(set));
+        // every check, as apply: a save's roster can load at the same address and count (Road to the Show did)
+        if (!have_files) restore_any();
+    }
+}
+
+void styles_start(void) {
+    set = rt_patch_set("delivery_styles");
+    if (set < 0) return;   // an exe built without the set
+    if (strcmp(rt_game_build, "1.0.20")) {
+        rt_log("styles: no addresses known for game %s; delivery_styles is switched off", rt_game_build);
+        rt_patch_disable(set);
+        return;
+    }
+    int miss = missing_copies();
+    have_files = !miss;
+    if (miss) {
+        // The watcher still runs, only putting copies back: a franchise or Road to the Show save made with the set on
+        // holds them, and after the file step's uninstall the game would give those pitchers Generic Windup 1.
+        rt_log("styles: the game files do not have the delivery copies (%s); delivery_styles is switched off, saved "
+               "copies go back to the roster's deliveries", miss < 0 ? "PITCHERSTREAM.BBS unreadable" : "run the Pitching++ file step");
+        rt_patch_disable(set);
+    }
+    if (!plat_thread_spawn(watcher, NULL, "styles", 0)) {
+        rt_log("styles: cannot start the watcher thread; delivery_styles is switched off");
+        rt_patch_disable(set);
+        return;
+    }
+    if (have_files)
+        rt_log("styles: delivery_styles %s; %d roster records in the table", rt_patch_enabled(set) ? "on" : "off", N_STYLES);
+}
