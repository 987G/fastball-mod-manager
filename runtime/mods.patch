+#if RT_PATCH_COUNT && RT_PATCH_DATA_COUNT
+// `data` lines (recomp/patches.py): replacement bytes for the loaded image (tables in .data or .rodata), written
+// once at start for each set that is on. The patch file names the original bytes by their FNV-1a 64 hash only (no
+// game bytes in it): at start each line's original bytes are copied from the loaded image, where their hash matches,
+// and that copy is what switching the set off puts back.
+static const struct { int set; uint64_t addr; uint32_t len; uint64_t hash; const char *repl; } data_lines[] = {
+#define X(k, a, n, h, r) {k, a, n, h, r},
+    RT_PATCH_DATA(X)
+#undef X
+};
+static unsigned char *data_orig[sizeof data_lines / sizeof data_lines[0]];   // NULL: the line was not the original
+
+static uint64_t fnv64(const void *p, size_t n) {
+    const unsigned char *b = p;
+    uint64_t h = 0xcbf29ce484222325ull;
+    for (size_t i = 0; i < n; i++) h = (h ^ b[i]) * 0x100000001b3ull;
+    return h;
+}
+
+static int data_write(uint64_t addr, const void *src, uint64_t n) {
+    uint64_t first = addr & ~0xfffull, end = (addr + n + 0xfff) & ~0xfffull, stop = 0;
+    int prot = plat_mem_state(first, end, &stop);
+    if (prot < PLAT_PROT_READ || stop < end) return 0;
+    if (prot != PLAT_PROT_RW && !plat_mem_protect(first, end - first, PLAT_PROT_RW)) return 0;
+    memcpy((void *)(uintptr_t)addr, src, n);
+    if (prot != PLAT_PROT_RW) plat_mem_protect(first, end - first, prot);
+    return 1;
+}
+
+static void data_apply(void) {
+    int done[RT_PATCH_COUNT] = {0}, bad[RT_PATCH_COUNT] = {0};
+    for (size_t i = 0; i < sizeof data_lines / sizeof data_lines[0]; i++) {
+        const int k = data_lines[i].set;
+        const uint64_t a = data_lines[i].addr;
+        // every line's original bytes are kept, whatever its set's state, so a set switched on later can go back
+        if (!plat_mem_readable(a, data_lines[i].len) || fnv64((const void *)(uintptr_t)a, data_lines[i].len) !=
+                                                            data_lines[i].hash ||
+            !(data_orig[i] = malloc(data_lines[i].len))) {
+            rt_log("patches: %s: the bytes at %#llx are not the expected original; that line is skipped", sets[k].name,
+                   (unsigned long long)a);
+            bad[k]++;
+            continue;
+        }
+        memcpy(data_orig[i], (const void *)(uintptr_t)a, data_lines[i].len);
+        if (!rt_patch_on[k]) continue;
+        if (data_write(a, data_lines[i].repl, data_lines[i].len)) done[k]++;
+        else bad[k]++;
+    }
+    for (int k = 0; k < RT_PATCH_COUNT; k++)
+        if (done[k] || bad[k])
+            rt_log("patches: %s: %d data line%s written%s", sets[k].name, done[k], done[k] == 1 ? "" : "s",
+                   bad[k] ? ", some skipped" : "");
+}
+
+// A set switched while the game runs: its data lines go to the replacement bytes (on) or back to the original
+// (off), each only where the bytes are still the other side's, so a line skipped at start stays untouched.
+static void data_flip(int k, int on) {
+    int done = 0;
+    for (size_t i = 0; i < sizeof data_lines / sizeof data_lines[0]; i++) {
+        if (data_lines[i].set != k || !data_orig[i]) continue;   // skipped at start: left alone
+        const uint64_t a = data_lines[i].addr;
+        const void *from = on ? (const void *)data_orig[i] : data_lines[i].repl,
+                   *to = on ? data_lines[i].repl : (const void *)data_orig[i];
+        if (plat_mem_readable(a, data_lines[i].len) && !memcmp((const void *)(uintptr_t)a, from, data_lines[i].len) &&
+            data_write(a, to, data_lines[i].len))
+            done++;
+    }
+    if (done) rt_log("patches: %s: %d data line%s %s", sets[k].name, done, done == 1 ? "" : "s",
+                     on ? "written" : "restored");
+}
