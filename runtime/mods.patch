+// mlbts-native: Pitching++ release extension (perceived velocity). Moved here from Real Pitch Speed (its commit 10953f1,
+// reverted there in 0a85a4a) at the user's call, 2026-11-17; handover notes in mods/pitch-types/extension/README.md.
+//
+// MLB_RELEASE_EXTENSION=1      the switch: the set release_extension of mods/pitch-types/patches.txt (no code sites;
+//                              switchable while the game runs)
+// MLB_RELEASE_EXTENSION_LOG=1  one log line per pitch: the flight, the delivery's real extension and the factor
+//
+// A pitcher who releases closer to the plate gives the batter less time: Statcast's perceived velocity is release
+// speed x 52.67 / (59.08 - extension), +1.78 % per foot. The game releases each pitch where its delivery animation
+// puts the hand, so its flight is 52.9-55.9 ft by delivery (Nance's 52.9, Gausman's 54.2, Ohtani's 55.1, Scott's
+// 55.9), unrelated to the real pitchers. At the release (ball +0x300 becomes 1: the release point +0x410/+0x418 and
+// the crossing +0x420/+0x428 are known) the ball's playback multiplier +0x394 and time scale +0x3cc are multiplied by
+//   f = (this flight / 54.6) x (52.67 / (59.08 - the delivery's real extension)),
+// so the flight lasts, relative to the game's average delivery, as long as a real pitch from that delivery's
+// extension. The path, the movement and the AI do not change. Real Pitch Speed (if on) sets the playback speed before
+// the release for an average delivery and never writes during the flight, so the two compose once; with it off, f
+// multiplies the game's own speed. (Real Pitch Speed's watcher then sees a multiplier it did not write, finds that it
+// is not its pitch's, and leaves it: "the pitch was not found" in its log.)
+//
+// The extension belongs to the delivery style (PLAYERS.BIN D_PLYR_ANIMS.PITCHING_STYLE), so created and Road to the
+// Show players get the extension of the delivery they picked: extension_table.h (mods/pitch-types/extension/
+// make_ext_table.py, 1,789 styles; a style it does not list gets the league mean 6.41 ft, which fixes only the
+// animation's own error). Measured in Real Pitch Speed (ext_verify_2026-11-17.log): 121 of 121 pitches stepped,
+// on-screen flights 0.98x the real time for each pitcher's speed and extension.
+//
+// The pitcher on the mound and his delivery: mound.c (user-controlled or CPU).
+#include <math.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "cfg.h"
+#include "host.h"
+#include "mound.h"
+#include "platform/platform.h"
+#include "extension_table.h"   // ext_table: delivery style -> real extension (1/100 ft)
+
+#define PLATE_FRONT 59.08f       // ft from the rubber to the front of the plate
+#define EXT_LEAGUE 6.41f         // Statcast 2025 mean extension
+#define REAL_FLIGHT_AVG 52.67f   // PLATE_FRONT - EXT_LEAGUE
+#define GAME_FLIGHT_AVG 54.6f    // the game's mean flight over 13 deliveries
+
+static int set = -1, log_on;
+
+static int read_u64(uint64_t a, uint64_t *out) {
+    if (!a || !mem_guest_readable(a, 8)) return 0;
+    *out = *(const uint64_t *)(uintptr_t)a;
+    return 1;
+}
+
+static uint64_t current_ball(void) {
+    uint64_t g, ball;
+    if (!read_u64(0x70045c2428ull, &g) || !read_u64(g + 8, &ball) || !ball || !mem_guest_readable(ball + 0x300, 0xd0))
+        return 0;
+    return ball;
+}
+
+// The delivery style of the pitcher on the mound, or -1.
+static int current_style(void) {
+    MoundPitcher mp;
+    return mound_pitcher(&mp) ? mp.style : -1;
+}
+
+// The delivery's real release extension (ft): its owner's Statcast extension or the height fit; the league mean for a
+// style the table does not list. runtime/mlb/shapes.c uses it for the flight-length correction too.
+float extension_style_ft(int style) {
+    int lo = 0, hi = (int)(sizeof ext_table / sizeof ext_table[0]) - 1;
+    while (style >= 0 && lo <= hi) {
+        int mid = (lo + hi) / 2;
+        if (ext_table[mid].style == style) return ext_table[mid].ext / 100.0f;
+        if (ext_table[mid].style < style) lo = mid + 1; else hi = mid - 1;
+    }
+    return EXT_LEAGUE;
+}
+
+// The game's flight (release to crossing, 1/100 ft) last measured for each delivery style, whether or not this set is
+// on: shapes.c sizes the break display with it (the display is drawn before the hand lets go). 0 = not seen yet.
+static uint16_t flight_cm[65536];
+
+float extension_flight_ft(int style) {
+    return style >= 0 && style < 65536 ? flight_cm[style] / 100.0f : 0.0f;
+}
+
+static void step(uint64_t ball, int apply) {
+    float *mult = (float *)(uintptr_t)(ball + 0x394), *ts = (float *)(uintptr_t)(ball + 0x3cc);
+    float rx = *(const float *)(uintptr_t)(ball + 0x410), rz = *(const float *)(uintptr_t)(ball + 0x418);
+    float cx = *(const float *)(uintptr_t)(ball + 0x420), cz = *(const float *)(uintptr_t)(ball + 0x428);
+    float d = sqrtf((cx - rx) * (cx - rx) + (cz - rz) * (cz - rz)), now = *ts, m = *mult;
+    int style = current_style();
+    if (d > 40.0f && d < 70.0f && style >= 0) flight_cm[style] = (uint16_t)lroundf(d * 100.0f);
+    if (!apply) return;
+    if (!(d > 40.0f && d < 70.0f) || !(now > 0.05f && now < 4.0f) || !(m > 0.05f && m < 4.0f)) {
+        if (log_on) rt_log("extension: flight %.2f ft, time scale %.3f: no step", d, now);
+        return;
+    }
+    float ext = extension_style_ft(style);
+    float f = (d / GAME_FLIGHT_AVG) * (REAL_FLIGHT_AVG / (PLATE_FRONT - ext));
+    *mult = m * f;   // the game derives +0x3cc from +0x394 again in places: keep them in step
+    *ts = now * f;
+    if (log_on)
+        rt_log("extension: flight %.2f ft, delivery %d real extension %.2f ft: playback x%.3f (time scale %.3f -> %.3f)",
+               d, style, ext, f, now, now * f);
+}
+
+static void watcher(void *arg) {
+    (void)arg;
+    uint64_t last_ball = 0;
+    uint32_t last_state = 0;
+    for (;;) {
+        // a pitch's release must be caught before much of its flight has played: 2 ms
+        plat_sleep_ns(2000000ull);
+        uint64_t ball = current_ball();
+        if (!ball) {
+            last_ball = 0;
+            continue;
+        }
+        uint32_t st = *(const uint32_t *)(uintptr_t)(ball + 0x300);
+        if (st == 1 && (last_state != 1 || ball != last_ball)) step(ball, rt_patch_enabled(set));   // once per pitch
+        last_ball = ball, last_state = st;
+    }
+}
+
+void extension_start(void) {
+    set = rt_patch_set("release_extension");
+    if (set < 0) return;   // an exe built without the set
+    if (strcmp(rt_game_build, "1.0.20")) {
+        rt_log("extension: no addresses known for game %s; the release_extension set is switched off", rt_game_build);
+        rt_patch_disable(set);
+        return;
+    }
+    const char *l = cfg_get("MLB_RELEASE_EXTENSION_LOG");
+    log_on = l && *l && strcmp(l, "0") != 0;
+    // The thread runs whether the set is on or off: the set can be switched while the game runs.
+    if (!plat_thread_spawn(watcher, NULL, "extension", 0)) {
+        rt_log("extension: cannot start the watcher thread; the release_extension set is switched off");
+        rt_patch_disable(set);
+        return;
+    }
