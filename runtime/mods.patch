+// mlbts-native, pitch types mod (diagnostic): MLB_FNDUMP=<guest addr>:<off>[:b|:f|:i],<off>...  logs fields behind x0
+// each time that game function is entered with contents not logged before for that x0 (e.g. the pitch object at
+// f_7000248e70: type +0x12, start mph +0x1c, spin +0x10c ...). Like MLB_FNTRACE it turns g_fnprof on.
+// Several functions: specs separated by ';'.
+#define DUMP_MAX 4
+static struct {
+    uint64_t addr;
+    struct { uint32_t off; char kind; } f[32];
+    int n;
+} dumps[DUMP_MAX];
+static int ndumps;
+static void fndump(int d, uint64_t lr, uint64_t x0) {
+    char line[1024];
+    int at = snprintf(line, sizeof line, "fndump: %#llx lr %#llx x0 %#llx:", (unsigned long long)dumps[d].addr,
+                      (unsigned long long)lr, (unsigned long long)x0);
+    uint64_t h = 0xcbf29ce484222325ull ^ dumps[d].addr;
+    for (int i = 0; i < dumps[d].n && at < (int)sizeof line - 40; i++) {
+        uint64_t a = x0 + dumps[d].f[i].off;
+        if (!plat_mem_readable(a, 4)) return;
+        uint32_t raw = dumps[d].f[i].kind == 'b' ? *(const uint8_t *)(uintptr_t)a : *(const uint32_t *)(uintptr_t)a;
+        h = (h ^ raw) * 0x100000001b3ull;
+        if (dumps[d].f[i].kind == 'f') {
+            float f;
+            memcpy(&f, &raw, 4);
+            at += snprintf(line + at, sizeof line - at, " %x=%.4f", dumps[d].f[i].off, f);
+        } else
+            at += snprintf(line + at, sizeof line - at, " %x=%d", dumps[d].f[i].off, (int)raw);
+    }
+    static uint64_t last_x0[64], last_h[64];
+    unsigned k = (unsigned)(((x0 ^ dumps[d].addr) * 0x9e3779b97f4a7c15ull) >> 58);
+    if (last_x0[k] == x0 && last_h[k] == h) return;
+    last_x0[k] = x0, last_h[k] = h;
+    rt_log("%s at %llu ms", line, (unsigned long long)(plat_now_ns() / 1000000ull));
+}
+static void parse_fndump(void) {
+    const char *e = getenv("MLB_FNDUMP");
+    for (const char *p = e; p && *p && ndumps < DUMP_MAX;) {
+        char *end;
+        uint64_t addr = strtoull(p, &end, 16);
+        if (end == p) break;
+        int d = ndumps;
+        dumps[d].addr = addr, dumps[d].n = 0;
+        for (p = *end == ':' ? end + 1 : end; *p && *p != ';' && dumps[d].n < 32;) {
+            uint32_t off = (uint32_t)strtoul(p, &end, 16);
+            if (end == p) break;
+            char kind = 'i';   // <off>:b (u8), <off>:f (float), <off> or <off>:i (32-bit int)
+            if (*end == ':' && (end[1] == 'b' || end[1] == 'f' || end[1] == 'i')) kind = end[1], end += 2;
+            dumps[d].f[dumps[d].n].off = off, dumps[d].f[dumps[d].n].kind = kind, dumps[d].n++;
+            p = end + (*end == ',');
+        }
+        if (dumps[d].n) ndumps++;
+        while (*p && *p != ';') p++;
+        if (*p == ';') p++;
+    }
+    for (int d = 0; d < ndumps; d++)
+        rt_log("MLB_FNDUMP: %d fields of x0 at %#llx (the game runs slower)", dumps[d].n,
+               (unsigned long long)dumps[d].addr);
+    if (ndumps) g_fnprof = 1;
+}
