+    rt_log("rtts autosave: changes kept in the Road to the Show player editor are saved when it closes");
+}
+
+// Save confirm: the keyboard and controller imports get host functions, both or neither.
+static void confirm_install(void) {
+    uint64_t ps = k_builds[g_build].pad_slot, ks = k_builds[g_build].kb_slot;
+    const char *why = NULL;
+    if (!ps || !ks || !k_builds[g_build].screen_name) why = "no addresses for this game";
+    else if (!hostfn_name(g_pad_prev = rd64(ps)) || !hostfn_name(g_kb_prev = rd64(ks)))
+        why = "the controller or keyboard import is not the port's";
+    else {
+        g_pad_hook = hostfn_register("<save fixes controller>", pad_hook);
+        g_kb_hook = hostfn_register("<save fixes keyboard>", kb_hook);
+        if (!poke64(ps, g_pad_hook)) why = "could not write the controller import";
+        else if (!poke64(ks, g_kb_hook)) {
+            poke64(ps, g_pad_prev);
+            why = "could not write the keyboard import";
+        }
+    }
+    if (why) {
+        rt_log("save fixes: %s; the save list still waits for A after the name", why);
+        return;
+    }
+    __atomic_store_n(&g_confirm, 1, __ATOMIC_RELEASE);
+    rt_log("save fixes: a Road to the Show save is written once its name is given");
+}
+
 // boot.c: after the modules are loaded and after tutorials_apply, before hostfn_seal.
 void rtts_autosave_apply(void) {
     if (!cfg_bool("MLB_RTTS_AUTOSAVE")) return;
@@ -212,4 +494,8 @@ void rtts_autosave_apply(void) {
     }
     __atomic_store_n(&g_installed, 1, __ATOMIC_RELEASE);
     rt_log("rtts autosave: upgrades bought in Road to the Show are saved when their screen is left");
+    const char *edits = cfg_get("MLB_SAVE_EDITS");   // the Bug Fixes mod's switch: 1 or "on"
+    if (edits && (!strcmp(edits, "1") || !strcmp(edits, "on"))) edits_install();
+    const char *confirm = cfg_get("MLB_SAVE_CONFIRM");   // the Bug Fixes mod's switch: 1 or "on"
+    if (confirm && (!strcmp(confirm, "1") || !strcmp(confirm, "on"))) confirm_install();
 }
diff --git a/runtime/mlb/rubber.c b/runtime/mlb/rubber.c
new file mode 100644
index 0000000..22ecdb7
--- /dev/null
+++ b/runtime/mlb/rubber.c
@@ -0,0 +1,208 @@
+// mlbts-native: Pitching++ rubber spot. Each pitcher stands where he really does on the rubber.
+//
+// MLB_RUBBER_SPOT=1      the patch set rubber_spot (mods/pitch-types/deliveries/rubber_patches.txt)
+// MLB_RUBBER_SPOT_LOG=1  a log line per new pitcher or batter side on the mound: the spot and where it came from, and
+//                        each placement the game makes (his pitch node set's x)
+// MLB_RUBBER_MY_SIDE=1   the user's own Road to the Show pitcher stands at the end of the rubber on the batter's side
+//                        (third-base end against a right-handed batter, first-base end against a left-handed one)
+//
+// [M, 1.0.20, 2026-11-18] The game places the pitcher in f_70002e4f54, called when his node set is built (each new
+// batter): the rubber's front edge (0, 0, 3.14 ft; the fielders' table at 0x70022d0094) minus his idle clip's
+// pivot-foot position (clip bone 26, the ball of the foot), plus x -0.65 ft for a right-hander and +0.65 for a
+// left-hander (the record's +0x104 bit 4 picks: fcsel at main+0x2e50e4) and z + 1/12 ft. So every pitcher stands on
+// the same spot. A live test that set the right-handers' value to +0.5 moved the whole delivery and its release
+// 1.15 ft toward first base. Real spots (MLB Gameday 3D tracking of one 2026 regular-season pitch per pitcher, the
+// ball of the pivot foot at leg lift; mods/pitch-types/deliveries/gameday3d) cluster about 0.5 ft either side of
+// the centre and differ from the game's by 0.88 ft on average, by more than a foot for half the pitchers.
+//
+// The set's two sites turn the game's fmov s1, w8 (the left-handed value, main+0x2e50d4) and fmov s2, w8 (the
+// right-handed one, main+0x2e50e0) into loads from patch page +0xe04 and +0xe00. This file keeps both words at the
+// spot of the pitcher on the mound (mound.c, user-controlled or CPU; the game's fcsel then picks either: they are the
+// same), or at the game's own -0.65 / +0.65 for a pitcher not in rubber_table (created and Road to the Show players,
+// call-ups the roster file does not have, a pitcher the roster lists with the other hand). The patch file's page line puts the game's values
+// there before the guest starts. The value is read when a batter's node set is built; a new pitcher is on the mound
+// (warm-up, walk-up) long before that, so polling every 20 ms is plenty.
+//
+// Batter side [2026-11-21]: some pitchers stand elsewhere on the rubber against left- and right-handed batters, all
+// the big movers toward the batter's side (Statcast 2026 release by batter side inside (game, pitch type) cells;
+// mods/pitch-types/deliveries/gameday3d/side_shift_statcast.py, make_rubber_table.py: Travis Adams 1.81 ft, Matt
+// Strahm 1.72, Kade Anderson 1.64, ...; fetch_spots.py --by-side measures the pivot foot by side in Gameday 3D).
+// rubber_table holds each pitcher's spot against right- and left-handed batters; this file writes the one for the
+// batter at the plate (mound.c mound_batter: the game's lineup state, a switch-hitter on the side opposite the
+// pitcher's hand). The game advances the lineup when a plate appearance ends, before it builds the next batter's node
+// set: in a test game (4x, 2026-11-21) the spot was on the page 0.2-1.5 s before each placement and all 87 pitches the
+// game's diagnostics name came from the spot for their batter (Dreyer +0.56 ft, Cease -0.25 ft between sides).
+// MLB_RUBBER_MY_SIDE: in a Road to the Show test career the pitcher went to x +1.14 against left-handed batters and
+// -0.80 against right-handed ones, release 1.94 ft apart, 20 of 20 pitches.
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "cfg.h"
+#include "host.h"
+#include "mound.h"
+#include "platform/platform.h"
+#include "rubber_table.h"   // rubber_table (mods/pitch-types/deliveries/gameday3d/make_rubber_table.py)
+
+#define R_OFF 0xe00         // float: x for the right-handed path (fmov s2 site)
+#define L_OFF 0xe04         // float: x for the left-handed path (fmov s1 site)
+#define GAME_R (-0.65f)     // the game's own values
+#define GAME_L 0.65f
+#define NO_ID_TICKS 50      // 1 s without a pitcher on the mound: the game's spot
+
+static int log_on;
+static int my_side;         // MLB_RUBBER_MY_SIDE
+
+// His spot (ft from the rubber's centre, + toward first base) against a batter batting from side ('R', 'L'; 0 unknown:
+// his spot over all batters), or 0 when he is not in the table. A per-side spot further out than the furthest a measured
+// foot stands (RUBBER_LIMIT_*: past them the foot is off the rubber) is kept at that limit: a few movers' per-side spots
+// come from one pitch of the delivery solve (Adams vs L +1.95, Jacob vs R +1.66, Strahm vs R -1.39) until the Pitching
+// Animation Research chat re-solves them. A right-hander's toes point to third base (x < 0), a left-hander's to first.
+// His overall spot (measured) is never moved.
+static int lookup(uint32_t id, char side, int left, float *x) {
+    int lo = 0, hi = (int)(sizeof rubber_table / sizeof rubber_table[0]) - 1;
+    while (lo <= hi) {
+        int mid = (lo + hi) / 2;
+        if (rubber_table[mid].id == id) {
+            int v = side == 'R' ? rubber_table[mid].r_mft : side == 'L' ? rubber_table[mid].l_mft : rubber_table[mid].x_mft;
+            if (v != rubber_table[mid].x_mft) {
+                int lim3b = left ? RUBBER_LIMIT_HEEL_MFT : RUBBER_LIMIT_TOES_MFT;   // the third-base end
+                int lim1b = left ? RUBBER_LIMIT_TOES_MFT : RUBBER_LIMIT_HEEL_MFT;
+                if (v < -lim3b) v = -lim3b;
+                if (v > lim1b) v = lim1b;
+            }
+            *x = v / 1000.0f;
+            return 1;
+        }
+        if (rubber_table[mid].id < id) lo = mid + 1; else hi = mid - 1;
+    }
+    return 0;
+}
+
+static void put(char *page, float right, float left) {
+    *(volatile float *)(page + R_OFF) = right;
+    *(volatile float *)(page + L_OFF) = left;
+}
+
+// The end of the rubber on the batter's side for a pitcher throwing with this hand: third base against a right-handed
+// batter, first base against a left-handed one. A right-hander's pivot toes point to third base, a left-hander's to
+// first; rubber_table.h has how far the ball of the foot reaches at each end (the measured spots' 98th percentiles).
+static float batter_side_end(int left, char side) {
+    float toes = RUBBER_END_TOES_MFT / 1000.0f, heel = RUBBER_END_HEEL_MFT / 1000.0f;
+    if (side == 'R') return left ? -heel : -toes;
+    return left ? toes : heel;
+}
+
+// His pitch node set's x as the game placed him (f_70002e47d4 / f_70002e7580 store f_70002e4f54's result at node set
+// +0x34 and +0x40), or NaN: for the log, to see each placement and the spot it took.
+static float placed_x(uint64_t role) {
+    uint64_t ns;
+    if (!role || !mem_guest_readable(role + 0x1c0, 8)) return 0.0f / 0.0f;
+    ns = *(const uint64_t *)(uintptr_t)(role + 0x1c0);
+    if (!ns || !mem_guest_readable(ns + 0x34, 4)) return 0.0f / 0.0f;
+    return *(const float *)(uintptr_t)(ns + 0x34);
+}
+
+static void watcher(void *arg) {
+    char *page = (char *)rt_patch_page();
+    uint64_t last = 0;   // the player object whose spot is on the page (mound.c), 0: the game's spot, for nobody
+    uint32_t last_id = 0;
+    char last_side = 0;  // the batter side the spot on the page is for
+    uint64_t last_batter = 0;
+    float last_placed = 0.0f;
+    int no_id = 0;       // 20 ms ticks without a pitcher on the mound
+    (void)arg;
+    for (;;) {
+        plat_sleep_ns(20000000ull);
+        MoundPitcher mp;
+        // A short gap keeps the spot that is there, the pitcher's, written during his warm-up or walk-up (the old
+        // lookup, the mound object's id, is cleared while the game places him for a new batter, the moment the sites
+        // read the page: writing the game's default then put 5-10 % of pitches on it; the Pitching Animation Research
+        // chat's deliveries/ship/HANDOVER.md, "Rubber spot bug"). After NO_ID_TICKS (out of a game), the game's spot.
+        if (!mound_pitcher(&mp)) {
+            if (++no_id == NO_ID_TICKS && last) {
+                put(page, GAME_R, GAME_L);
+                last = 0, last_id = 0, last_side = 0, last_batter = 0;
+                if (log_on) rt_log("rubber: no pitcher on the mound for %d ms: the game's spot", NO_ID_TICKS * 20);
+            }
+            continue;
+        }
+        if (log_on && no_id >= 5 && no_id < NO_ID_TICKS) rt_log("rubber: no pitcher on the mound for %d ms", no_id * 20);
+        no_id = 0;
+        MoundBatter mb;
+        char side = mound_batter(mp.left, &mb) ? mb.side : 0;
+        if (log_on) {
+            if (side && mb.player != last_batter)
+                rt_log("rubber: batter %s bats %s: %s-handed against %s", mb.name,
+                       mb.bats == 2 ? "both" : mb.bats ? "left" : "right", side == 'L' ? "left" : "right", mp.name);
+            float px = placed_x(mp.role);
+            if (px == px && px != last_placed)
+                rt_log("rubber: %s placed at node set x %+.3f (page %+.3f / %+.3f, batter %s)", mp.name, px,
+                       *(volatile float *)(page + R_OFF), *(volatile float *)(page + L_OFF), side ? mb.name : "?");
+            if (px == px) last_placed = px;
+        }
+        if (side) last_batter = mb.player;
+        if (!side) side = last_side;   // a moment without a batter: keep the side
+        if (mp.player == last && mp.id == last_id && side == last_side) continue;
+        int new_pitcher = mp.player != last || mp.id != last_id;
+        last = mp.player, last_id = mp.id, last_side = side;
+        float x;
+        // the user's own career pitcher (mound.c: his record matches the roster's Road to the Show player)
+        int mine = my_side && mound_is_rtts_player(mp.player);
+        if (log_on && new_pitcher && my_side) {
+            uint64_t r = mound_rtts_player();
+            if (!mine && !mp.id && r && mem_guest_readable(mp.player, 0xb0)) {   // a created player who is not: why
+                const uint8_t *a = (const uint8_t *)(uintptr_t)r, *b = (const uint8_t *)(uintptr_t)mp.player;
+                rt_log("rubber: pitcher %s is not your Road to the Show player %.16s (+0x74 %08x / %08x, +0x70 %08x / "
+                       "%08x, id %u / %u)", mp.name, (const char *)(a + 0x60), *(const uint32_t *)(b + 0x74),
+                       *(const uint32_t *)(a + 0x74), *(const uint32_t *)(b + 0x70), *(const uint32_t *)(a + 0x70),
+                       *(const uint16_t *)(b + 0x9a), *(const uint16_t *)(a + 0x9a));
+            } else
+                rt_log("rubber: pitcher %s %s your Road to the Show player", mp.name, mine ? "is" : "is not");
+        }
+        if (mine && side) {
+            x = batter_side_end(mp.left, side);
+            put(page, x, x);
+            if (log_on)
+                rt_log("rubber: your pitcher %s stands at the %s end, pivot foot at x %+.2f ft, against a %s-handed batter",
+                       mp.name, x > 0 ? "first-base" : "third-base", x, side == 'L' ? "left" : "right");
+        } else if (mp.id && lookup(mp.id, side, mp.left, &x)) {
+            put(page, x, x);
+            if (log_on)
+                rt_log("rubber: pitcher %u %s stands with his pivot foot at x %+.2f ft against %s (the game: %+.2f "
+                       "right-handed, %+.2f left-handed)%s", mp.id, mp.name, x,
+                       side == 'L' ? "a left-handed batter" : side == 'R' ? "a right-handed batter" : "any batter",
+                       GAME_R, GAME_L, new_pitcher ? "" : " (new batter side)");
+        } else {
+            put(page, GAME_R, GAME_L);
+            if (log_on && new_pitcher)
+                rt_log("rubber: pitcher %u %s (index %#x) is not in the table: the game's spot", mp.id, mp.name, mp.index);
+        }
+    }
+}
+
+void rubber_start(void) {
+    int set = rt_patch_set("rubber_spot");
+    if (set < 0 || !rt_patch_page()) return;   // an exe built without the set
+    put((char *)rt_patch_page(), GAME_R, GAME_L);
+    if (strcmp(rt_game_build, "1.0.20")) {
+        rt_log("rubber: no addresses known for game %s; rubber_spot is switched off", rt_game_build);
+        rt_patch_disable(set);
+        return;
+    }
+    const char *l = cfg_get("MLB_RUBBER_SPOT_LOG");
+    log_on = l && *l && strcmp(l, "0") != 0;
+    const char *m = cfg_get("MLB_RUBBER_MY_SIDE");
+    my_side = m && *m && strcmp(m, "0") != 0;
+    // The thread runs whether the set is on or off: it can be switched while the game runs.
+    if (!plat_thread_spawn(watcher, NULL, "rubber", 0)) {
+        rt_log("rubber: cannot start the watcher thread; rubber_spot is switched off");
+        rt_patch_disable(set);
+        return;
+    }
+    int n = (int)(sizeof rubber_table / sizeof rubber_table[0]), moving = 0;
+    for (int i = 0; i < n; i++) moving += rubber_table[i].r_mft != rubber_table[i].l_mft;
+    rt_log("rubber: rubber_spot %s; %d pitchers in the table, %d of them stand elsewhere against left- and right-handed "
+           "batters; your Road to the Show pitcher %s", rt_patch_enabled(set) ? "on" : "off", n, moving,
+           my_side ? "goes to the end on the batter's side" : "stands on the game's spot");
+}
